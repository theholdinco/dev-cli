random_celebration() {
  local idx=$((RANDOM % ${#CELEBRATIONS[@]}))
  echo -e "  ${CELEBRATIONS[$idx]}"
}

random_farewell() {
  local idx=$((RANDOM % ${#FAREWELLS[@]}))
  echo -e "  ${FAREWELLS[$idx]}"
}

fix_registry_perms() {
  [[ "$PORT_REGISTRY" == "$GLOBAL_PORT_REGISTRY" ]] && chmod 664 "$PORT_REGISTRY" 2>/dev/null || true
}

ensure_dirs() {
  mkdir -p "$CONFIG_DIR" "$LOG_DIR" "$CONFIG_DIR/projects"
  # Use global port registry if writable, otherwise fall back to local
  if [ -d "/etc/dev-cli" ] && [ -w "/etc/dev-cli" ]; then
    PORT_REGISTRY="$GLOBAL_PORT_REGISTRY"
    [ -f "$PORT_REGISTRY" ] || echo '{}' > "$PORT_REGISTRY"
    fix_registry_perms
  elif [ -f "$GLOBAL_PORT_REGISTRY" ] && [ -w "$GLOBAL_PORT_REGISTRY" ]; then
    PORT_REGISTRY="$GLOBAL_PORT_REGISTRY"
  else
    PORT_REGISTRY="$CONFIG_DIR/ports.json"
    [ -f "$PORT_REGISTRY" ] || echo '{}' > "$PORT_REGISTRY"
  fi
  [ -f "$GLOBAL_CONFIG" ] || echo "$DEFAULT_CONFIG" > "$GLOBAL_CONFIG"
  [ -f "$TASK_REGISTRY" ] || echo '{"tasks":[],"next_id":1}' > "$TASK_REGISTRY"
}

# Read a config value with jq path, falling back to default config, then to a provided default
get_config_value() {
  local key="$1" default="${2:-}"
  local val=""
  if [ -f "$GLOBAL_CONFIG" ]; then
    val=$(jq -r "$key // empty" "$GLOBAL_CONFIG" 2>/dev/null)
  fi
  if [ -z "$val" ]; then
    val=$(echo "$DEFAULT_CONFIG" | jq -r "$key // empty" 2>/dev/null)
  fi
  if [ -z "$val" ]; then
    echo "$default"
  else
    echo "$val"
  fi
}

# Suppress the bypass-permissions confirmation dialog (Claude Code >=2.1.42 regression)
ensure_claude_skip_prompt() {
  local settings_file="$HOME/.claude/settings.json"
  mkdir -p "$HOME/.claude"
  if [ -f "$settings_file" ]; then
    local current
    current=$(jq -r '.skipDangerousModePermissionPrompt // false' "$settings_file" 2>/dev/null)
    if [ "$current" != "true" ]; then
      local tmp="$settings_file.tmp.$$"
      jq '.skipDangerousModePermissionPrompt = true' "$settings_file" > "$tmp" && mv "$tmp" "$settings_file"
    fi
  else
    echo '{"skipDangerousModePermissionPrompt": true}' > "$settings_file"
  fi
}

# Pre-approve a directory in ~/.claude.json so Claude Code skips the
# "Do you trust the files in this folder?" dialog on first launch.
# Claude stores trust state in .projects.<path>.hasTrustDialogAccepted.
# Called unconditionally (not just for --yolo) because the trust dialog
# appears regardless of permission mode.
ensure_claude_trust() {
  local dir="$1"
  local claude_json="$HOME/.claude.json"

  (
    flock -x 200

    if [ ! -f "$claude_json" ]; then
      jq -n --arg p "$dir" '{projects: {($p): {hasTrustDialogAccepted: true}}}' > "$claude_json"
      return 0
    fi

    local already
    already=$(jq -r --arg p "$dir" '.projects[$p].hasTrustDialogAccepted // false' "$claude_json" 2>/dev/null)
    [ "$already" = "true" ] && return 0

    local tmp="$claude_json.tmp.$$"
    jq --arg p "$dir" \
      '.projects[$p] = (.projects[$p] // {}) | .projects[$p].hasTrustDialogAccepted = true' \
      "$claude_json" > "$tmp" && mv "$tmp" "$claude_json" \
      || { rm -f "$tmp"; return 0; }
  ) 200>"$claude_json.lock"
}

# Extract env vars from the user's ~/.claude/settings.json "env" section.
# Returns shell export statements (one per line) for each key-value pair.
# This ensures settings like CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS are available
# in the session environment, not just inside Claude Code's process.
get_claude_settings_env() {
  local settings_file="$HOME/.claude/settings.json"
  [ -f "$settings_file" ] || return 0
  # Output as semicolon-separated export statements on a single line
  # (safe for tmux command strings)
  jq -r '.env // {} | to_entries | map("export " + .key + "=" + (.value | @sh)) | join("; ")' "$settings_file" 2>/dev/null || true
}

# Build env_prefix string for sourcing secrets and Claude settings.
# secrets.env is the single source of truth for authentication.
# ~/.claude/settings.json "env" section provides user-configured env vars
# (e.g. CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS for subagent teams).
build_env_prefix() {
  local parts=""
  # Source secrets file for auth tokens
  if [ -f "$SECRETS_FILE" ]; then
    # Remove stale OAuth credentials file to prevent auth conflicts
    rm -f "$HOME/.claude/.credentials.json"
    parts="set -a && source $SECRETS_FILE && set +a"
  fi
  # Apply env vars from user's Claude settings.json
  local claude_env
  claude_env=$(get_claude_settings_env)
  if [ -n "$claude_env" ]; then
    if [ -n "$parts" ]; then
      parts="$parts && $claude_env"
    else
      parts="$claude_env"
    fi
  fi
  if [ -n "$parts" ]; then
    echo "$parts && "
  else
    echo ""
  fi
}

# Validate Claude auth configuration in secrets.env.
# Dies on conflict (both keys set), warns if neither is set.
validate_claude_auth() {
  local has_oauth=false has_api_key=false
  if [ -f "$SECRETS_FILE" ]; then
    grep -qE '^CLAUDE_CODE_OAUTH_TOKEN=' "$SECRETS_FILE" 2>/dev/null && has_oauth=true
    grep -qE '^ANTHROPIC_API_KEY=' "$SECRETS_FILE" 2>/dev/null && has_api_key=true
  fi
  if [ "$has_oauth" = true ] && [ "$has_api_key" = true ]; then
    die "Auth conflict: both CLAUDE_CODE_OAUTH_TOKEN and ANTHROPIC_API_KEY are set in $SECRETS_FILE. Keep only one."
  fi
  if [ "$has_oauth" = false ] && [ "$has_api_key" = false ]; then
    warn "No Claude auth found in $SECRETS_FILE. Add one of:"
    warn "  CLAUDE_CODE_OAUTH_TOKEN=...  (Pro/Max subscription — run: claude setup-token)"
    warn "  ANTHROPIC_API_KEY=sk-ant-... (API billing — pay per token)"
    return 1
  fi
  return 0
}

# Return tmux windows JSON array: project config > global config > defaults
get_tmux_windows() {
  local project="${1:-}"
  local windows=""
  if [ -n "$project" ] && [ -f "$CONFIG_DIR/projects/${project}.json" ]; then
    windows=$(jq -r '.tmux.windows // empty' "$CONFIG_DIR/projects/${project}.json" 2>/dev/null)
  fi
  if [ -z "$windows" ] || [ "$windows" = "null" ]; then
    windows=$(jq -r '.tmux.windows // empty' "$GLOBAL_CONFIG" 2>/dev/null)
  fi
  if [ -z "$windows" ] || [ "$windows" = "null" ]; then
    windows=$(echo "$DEFAULT_CONFIG" | jq -r '.tmux.windows')
  fi
  echo "$windows"
}

# Create tmux windows from config, replacing the hardcoded 3-window setup.
# When a container_id is provided, ALL windows (shell, server, custom) exec into
# the container so behaviour is identical to host mode.
# Args: session_name project worktree_path env_prefix agent_cmd run_cmd frontend backend ip [container_id]
create_tmux_windows() {
  local session="$1" project="$2" worktree="$3" env_prefix="$4" agent_cmd="$5"
  local run_cmd="$6" frontend="$7" backend="$8" ip="$9"
  local container_id="${10:-}"

  local windows
  windows=$(get_tmux_windows "$project")
  local win_count
  win_count=$(echo "$windows" | jq 'length')

  local first=true
  for i in $(seq 0 $((win_count - 1))); do
    local win_name win_command
    win_name=$(echo "$windows" | jq -r ".[$i].name")
    win_command=$(echo "$windows" | jq -r ".[$i].command // empty")

    local resolved_cmd=""
    if [ "$win_name" = "agent" ]; then
      resolved_cmd="${env_prefix}${agent_cmd}"
    elif [ "$win_name" = "server" ]; then
      local port_parts=""
      [ "$frontend" != "null" ] && [ -n "$frontend" ] && port_parts="$port_parts export DEV_FRONTEND_PORT=$frontend"
      [ "$backend" != "null" ] && [ -n "$backend" ] && port_parts="$port_parts export DEV_BACKEND_PORT=$backend"
      local port_exports="${port_parts:+${port_parts} }export DEV_SLOT=${session##*-}"

      local url_lines=""
      [ "$frontend" != "null" ] && [ -n "$frontend" ] && url_lines="Frontend: http://$ip:$frontend"
      if [ "$backend" != "null" ] && [ -n "$backend" ]; then
        [ -n "$url_lines" ] && url_lines="$url_lines | Backend: http://$ip:$backend" || url_lines="Backend: http://$ip:$backend"
      fi
      [ -z "$url_lines" ] && url_lines="No dev server ports allocated."

      if [ -n "$run_cmd" ]; then
        local server_inner="echo '$url_lines' && echo 'Running: $run_cmd' && echo '─────────────────────────────────────' && $run_cmd; bash"
        resolved_cmd="$port_exports && $(build_window_cmd "$worktree" "$container_id" "$server_inner")"
      else
        local server_inner="echo '$url_lines' && echo 'Run your dev server here.' && bash"
        resolved_cmd="$port_exports && $(build_window_cmd "$worktree" "$container_id" "$server_inner")"
      fi
    elif [ -n "$win_command" ]; then
      resolved_cmd=$(build_window_cmd "$worktree" "$container_id" "$win_command")
    else
      resolved_cmd=$(build_window_cmd "$worktree" "$container_id")
    fi

    if [ "$first" = true ]; then
      tmux new-session -d -s "$session" -n "$win_name" "$resolved_cmd"
      first=false
    else
      tmux new-window -t "$session" -n "$win_name" "$resolved_cmd"
    fi
  done

  local default_win
  default_win=$(get_config_value '.tmux.default_window' '1')
  tmux select-window -t "$session:$default_win"
}

# Create an OSC 8 clickable hyperlink for terminal emulators
# Usage: hyperlink <url> <display_text>
hyperlink() {
  local url="$1" text="$2"
  printf '\033]8;;%s\033\\%s\033]8;;\033\\' "$url" "$text"
}

# Get Tailscale IP (fallback to hostname -I)
get_ip() {
  if command -v tailscale &>/dev/null; then
    tailscale ip -4 2>/dev/null || hostname -I | awk '{print $1}'
  else
    hostname -I | awk '{print $1}'
  fi
}

# Slugify branch name: feat/my-feature → feat-my-feature
slugify() {
  echo "$1" | sed 's/[^a-zA-Z0-9]/-/g' | sed 's/--*/-/g' | sed 's/^-//;s/-$//' | tr '[:upper:]' '[:lower:]'
}

