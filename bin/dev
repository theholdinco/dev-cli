random_slug() {
  local words=(
    amber apex arch aspen atlas
    bark beam birch blaze bloom bolt bone breeze brook
    cape cedar chain chalk chip clay cliff cloud clover coal coral crest crow
    dale dawn deer delta dew dock drift dune dusk
    eagle echo edge elder elm ember
    falcon fern flame flare flint flora forge fox frost
    gale gate gem ghost glade glen glow gorge grain grove
    halo hawk hazel haze heath hedge heron hill holly horizon husk
    iron isle ivory ivy
    jade jasper jewel juniper
    kite knoll
    lake lark latch lava leaf ledge lily linen lotus
    maple marsh meadow mist moon moss
    nectar nest night nimbus noble north nova
    oak oasis ocean onyx orbit
    palm path peak pearl pebble pier pine plume pond prism pulse
    quartz quest quill
    rain range rapid raven reef ridge river rock root rose rust
    sage sand scope seal shade shell shore silk slate smoke snow spark spire spruce star steel stone storm stump summit
    thorn tide timber torch trail tulip tusk
    vale vault velvet vine vista
    wade walnut wave wheat willow wind wren
    yarn yew
    zeal zinc
  )
  local n=${#words[@]}
  local w1=${words[$((RANDOM % n))]}
  local w2=${words[$((RANDOM % n))]}
  local w3=${words[$((RANDOM % n))]}
  echo "${w1}-${w2}-${w3}"
}

# Session name: user-project-branch
# For task branches (task-N or task-N/...), use only "task-N" to keep names short
session_name() {
  local project="$1" branch="$2"
  local slug
  if [[ "$branch" =~ ^task-[0-9]+(/|$) ]]; then
    slug="${branch%%/*}"
  else
    slug=$(slugify "$branch")
  fi
  echo "${USER}-${project}-${slug}"
}

# ── Port Management ─────────────────────────────────────────────────────────

# Find next available slot
find_free_slot() {
  for slot in $(seq 1 $MAX_SLOTS); do
    if ! jq -e "to_entries[] | select(.value.slot == $slot)" "$PORT_REGISTRY" &>/dev/null; then
      echo "$slot"
      return 0
    fi
  done
  die "All $MAX_SLOTS slots are in use. Run 'dev kill' on a session first."
}

# Calculate ports for a given slot
slot_ports() {
  local slot="$1"
  local offset=$((slot - 1))
  local frontend=$((BASE_FRONTEND_PORT + offset))
  local backend=$((BASE_BACKEND_PORT + offset))
  local supa_api=$((BASE_SUPA_API_PORT + offset * SUPA_PORT_GAP))
  local supa_db=$((BASE_SUPA_DB_PORT + offset * SUPA_PORT_GAP))
  local supa_studio=$((BASE_SUPA_STUDIO_PORT + offset * SUPA_PORT_GAP))
  echo "$frontend $backend $supa_api $supa_db $supa_studio"
}

# Set up authbind for a user's allocated ports
setup_authbind_ports() {
    local username="$1" frontend_port="$2" backend_port="$3" supa_api_port="$4" supa_db_port="$5" supa_studio_port="$6"
    local ports=("$frontend_port" "$backend_port" "$supa_api_port" "$supa_db_port" "$supa_studio_port")
    for port in "${ports[@]}"; do
        [[ "$port" == "null" || -z "$port" ]] && continue
        sudo touch "/etc/authbind/byport/$port" 2>/dev/null || true
        sudo chown "$username" "/etc/authbind/byport/$port" 2>/dev/null || true
        sudo chmod 500 "/etc/authbind/byport/$port" 2>/dev/null || true
    done
}

# Clean up authbind for deallocated ports
cleanup_authbind_ports() {
    local frontend_port="$1" backend_port="$2" supa_api_port="$3" supa_db_port="$4" supa_studio_port="$5"
    local ports=("$frontend_port" "$backend_port" "$supa_api_port" "$supa_db_port" "$supa_studio_port")
    for port in "${ports[@]}"; do
        [[ "$port" == "null" || -z "$port" ]] && continue
        sudo rm -f "/etc/authbind/byport/$port" 2>/dev/null || true
    done
}

# Register a session in the port registry
register_session() {
  local name="$1" project="$2" branch="$3" slot="$4" agent="$5" worktree_path="$6" private="${7:-false}"
  local ports
  ports=$(slot_ports "$slot")
  read -r frontend backend supa_api supa_db supa_studio <<< "$ports"

  # Check project config to determine which ports are needed
  local config="$CONFIG_DIR/projects/${project}.json"
  if [ -f "$config" ]; then
    local has_next has_back has_supa
    has_next=$(jq -r '.has_nextjs // "n"' "$config")
    has_back=$(jq -r '.has_backend // "n"' "$config")
    has_supa=$(jq -r '.has_supabase // "n"' "$config")
    [[ ! "$has_next" =~ ^[Yy] ]] && frontend="null"
    [[ ! "$has_back" =~ ^[Yy] ]] && backend="null"
    if [[ ! "$has_supa" =~ ^[Yy] ]]; then
      supa_api="null"; supa_db="null"; supa_studio="null"
    fi
  fi

  # Build agents JSON array from comma-separated agent string (e.g. "claude,codex")
  local agents_json
  agents_json=$(echo "$agent" | tr ',' '\n' | jq -R . | jq -s .)

  (
    flock -x 200
    local tmp
    tmp=$(mktemp)
    jq --arg name "$name" \
       --arg project "$project" \
       --arg branch "$branch" \
       --argjson slot "$slot" \
       --arg agent "$agent" \
       --argjson agents "$agents_json" \
       --arg path "$worktree_path" \
       --arg owner "$USER" \
       --argjson frontend "$frontend" \
       --argjson backend "$backend" \
       --argjson supa_api "$supa_api" \
       --argjson supa_db "$supa_db" \
       --argjson supa_studio "$supa_studio" \
       --arg created "$(date -Iseconds)" \
       --argjson private "$private" \
       '.[$name] = {
          project: $project,
          branch: $branch,
          slot: $slot,
          agent: $agent,
          agents: $agents,
          path: $path,
          owner: $owner,
          private: $private,
          ports: {
            frontend: $frontend,
            backend: $backend,
            supa_api: $supa_api,
            supa_db: $supa_db,
            supa_studio: $supa_studio
          },
          created: $created
        }' "$PORT_REGISTRY" > "$tmp"
    mv -f "$tmp" "$PORT_REGISTRY"
    fix_registry_perms
  ) 200>"${PORT_REGISTRY}.lock"
}

# Unregister a session
unregister_session() {
  local name="$1"
  (
    flock -x 200
    local tmp
    tmp=$(mktemp)
    jq "del(.[\"$name\"])" "$PORT_REGISTRY" > "$tmp"
    mv -f "$tmp" "$PORT_REGISTRY"
    fix_registry_perms
  ) 200>"${PORT_REGISTRY}.lock"
}

# Get session info
get_session() {
  local name="$1"
  jq -r ".[\"$name\"] // empty" "$PORT_REGISTRY"
}

get_session_field() {
  local name="$1" field="$2"
  jq -r ".[\"$name\"].$field // empty" "$PORT_REGISTRY"
}

# Convert ISO timestamp to human-readable age (2m, 3h, 5d, 2w)
human_readable_age() {
  local created="$1"
  local now
  now=$(date +%s)
  local then
  # Handle both GNU and BSD date
  then=$(date -d "$created" +%s 2>/dev/null || date -jf "%Y-%m-%dT%H:%M:%S" "${created%%+*}" +%s 2>/dev/null || echo "$now")
  local diff=$(( now - then ))

  if [ "$diff" -lt 60 ]; then
    echo "${diff}s"
  elif [ "$diff" -lt 3600 ]; then
    echo "$(( diff / 60 ))m"
  elif [ "$diff" -lt 86400 ]; then
    echo "$(( diff / 3600 ))h"
  elif [ "$diff" -lt 604800 ]; then
    echo "$(( diff / 86400 ))d"
  else
    echo "$(( diff / 604800 ))w"
  fi
}

# Get agents list from registry (handles both old "agent" string and new "agents" array)
# Returns comma-separated list: "claude" or "claude,codex"
get_session_agents() {
  local name="$1"
  local agents_array
  agents_array=$(jq -r ".[\"$name\"].agents // null" "$PORT_REGISTRY" 2>/dev/null)
  if [ "$agents_array" != "null" ] && [ -n "$agents_array" ]; then
    # New format: agents array
    jq -r ".[\"$name\"].agents | join(\",\")" "$PORT_REGISTRY" 2>/dev/null
  else
    # Old format: single agent string
    jq -r ".[\"$name\"].agent // empty" "$PORT_REGISTRY" 2>/dev/null
  fi
}

# Check if a specific agent type is running in a session
# Returns 0 (true) if agent is present, 1 (false) otherwise
has_agent() {
  local name="$1" agent_type="$2"
  local agents
  agents=$(get_session_agents "$name")
  echo "$agents" | tr ',' '\n' | grep -qx "$agent_type"
}

# ── Env File Generation ────────────────────────────────────────────────────

generate_env_local() {
  local worktree_path="$1" slot="$2" project="$3"
  local ports
  ports=$(slot_ports "$slot")
  read -r frontend backend supa_api supa_db supa_studio <<< "$ports"

  local env_file="$worktree_path/.env.local"

  # Check for project-specific env template
  local template="$CONFIG_DIR/templates/${project}.env"
  if [ -f "$template" ]; then
    info "Using project template: $template"
    # Copy template and replace port placeholders
    local ip
    ip=$(get_ip)
    sed \
      -e "s|{{FRONTEND_PORT}}|$frontend|g" \
      -e "s|{{BACKEND_PORT}}|$backend|g" \
      -e "s|{{SUPA_API_PORT}}|$supa_api|g" \
      -e "s|{{SUPA_DB_PORT}}|$supa_db|g" \
      -e "s|{{SUPA_STUDIO_PORT}}|$supa_studio|g" \
      -e "s|{{SLOT}}|$slot|g" \
      -e "s|{{IP}}|$ip|g" \
      "$template" > "$env_file"
  else
    # Generate a generic Next.js + Supabase env
    local ip
    ip=$(get_ip)
    cat > "$env_file" << ENVEOF
# Auto-generated by dev CLI — slot $slot
# Do not commit this file

# ── App ─────────────────────────────
PORT=$frontend
NEXT_PUBLIC_PORT=$frontend
ALLOWED_DEV_ORIGINS=$ip

# ── Backend (Express) ───────────────
BACKEND_PORT=$backend
NEXT_PUBLIC_API_URL=http://localhost:$backend

# ── Supabase Local ──────────────────
NEXT_PUBLIC_SUPABASE_URL=http://localhost:$supa_api
SUPABASE_URL=http://localhost:$supa_api
# NEXT_PUBLIC_SUPABASE_ANON_KEY=   # filled after supabase start
# SUPABASE_SERVICE_ROLE_KEY=       # filled after supabase start
ENVEOF
  fi

  log "Generated $env_file (slot $slot: frontend=$frontend, backend=$backend)"
}

# ── Devcontainer Support ────────────────────────────────────────────────────

# Generate a default .devcontainer/devcontainer.json if one doesn't exist in the worktree.
# Respects existing devcontainer configs committed to the project repo.
ensure_devcontainer_json() {
  local worktree_path="$1" project="$2" pass_env="$3"
  local claude_model="${4:-}" claude_effort="${5:-}"
  local dc_dir="$worktree_path/.devcontainer"
  local dc_file="$dc_dir/devcontainer.json"

  # If project already has a devcontainer config, use it as-is
  if [ -f "$dc_file" ] || [ -f "$worktree_path/.devcontainer.json" ]; then
    info "Using existing devcontainer config"
    return 0
  fi

  mkdir -p "$dc_dir"

  # Build containerEnv as a jq object (safe from JSON injection).
  # ANTHROPIC_MODEL and CLAUDE_CODE_EFFORT_LEVEL are set here as env vars because
  # they're the most reliable way to configure Claude Code — env vars override
  # settings.json and can't be broken by postCreateCommand failures.
  local container_env_json
  container_env_json=$(jq -n \
    --arg proj "${DEV_PROJECT:-$project}" \
    --arg branch "${DEV_BRANCH:-}" \
    --arg fport "${DEV_FRONTEND_PORT:-}" \
    --arg bport "${DEV_BACKEND_PORT:-}" \
    --arg model "$claude_model" \
    --arg effort "$claude_effort" \
    '{DEV_PROJECT: $proj, DEV_BRANCH: $branch, CLAUDE_CODE_EFFORT_LEVEL: $effort, DISABLE_AUTOUPDATER: "1"}
     + (if $model != "" then {ANTHROPIC_MODEL: $model} else {} end)
     + (if $fport != "" then {DEV_FRONTEND_PORT: $fport} else {} end)
     + (if $bport != "" then {DEV_BACKEND_PORT: $bport} else {} end)')

  # Add API keys from secrets.env into containerEnv so they're visible to docker exec
  if [ -f "$SECRETS_FILE" ]; then
    for api_key_name in "${CONTAINER_API_KEYS[@]}"; do
      local api_key_line
      api_key_line=$(grep -E "^${api_key_name}=" "$SECRETS_FILE" 2>/dev/null | head -1) || true
      if [ -n "$api_key_line" ]; then
        local val="${api_key_line#*=}"
        val="${val#\"}" ; val="${val%\"}"
        val="${val#\'}" ; val="${val%\'}"
        container_env_json=$(echo "$container_env_json" | jq --arg k "$api_key_name" --arg v "$val" '. + {($k): $v}')
      fi
    done
  fi

  # Add env vars from user's ~/.claude/settings.json into containerEnv.
  # This ensures settings like CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS are available
  # in the container environment for Claude Code and subagents.
  local claude_settings="$HOME/.claude/settings.json"
  if [ -f "$claude_settings" ]; then
    local settings_env
    settings_env=$(jq -r '.env // {} | to_entries[] | @json' "$claude_settings" 2>/dev/null) || true
    if [ -n "$settings_env" ]; then
      while IFS= read -r entry; do
        local key val
        key=$(echo "$entry" | jq -r '.key')
        val=$(echo "$entry" | jq -r '.value')
        # Don't override explicitly set values (model, effort, API keys)
        if ! echo "$container_env_json" | jq -e "has(\"$key\")" >/dev/null 2>&1; then
          container_env_json=$(echo "$container_env_json" | jq --arg k "$key" --arg v "$val" '. + {($k): $v}')
        fi
      done <<< "$settings_env"
    fi
  fi

  # If --env requested, build remoteEnv with localEnv references for secrets
  local remote_env_json="{}"
  if [ "$pass_env" = true ] && [ -f "$SECRETS_FILE" ]; then
    local env_args=()
    while IFS= read -r line || [ -n "$line" ]; do
      [[ "$line" =~ ^[[:space:]]*# ]] && continue
      [[ -z "${line// /}" ]] && continue
      local key="${line%%=*}"
      key="${key#"${key%%[![:space:]]*}"}"
      key="${key%"${key##*[![:space:]]}"}"
      [ -z "$key" ] && continue
      env_args+=("--arg" "$key" "\${localEnv:$key}")
    done < "$SECRETS_FILE"
    if [ ${#env_args[@]} -gt 0 ]; then
      remote_env_json=$(jq -n "${env_args[@]}" '$ARGS.named')
    fi
  fi

  # Detect Node version from project's .nvmrc or .node-version, fall back to 22
  local node_version="22"
  for nv_file in "$worktree_path/.nvmrc" "$worktree_path/.node-version"; do
    if [ -f "$nv_file" ]; then
      local nv
      nv=$(tr -d '[:space:]' < "$nv_file")
      nv="${nv#v}"  # strip leading v
      [ -n "$nv" ] && node_version="$nv"
      break
    fi
  done

  # Build the postCreateCommand as independent steps (separated by ; not &&)
  # so one failing doesn't prevent the rest from running.
  # Modelled after a proven working Dockerfile:
  #   1. Copy host Claude config (credentials, settings, plugins)
  #   2. Mark onboarding complete + trust workspace
  #   3. Copy SSH keys
  #   4. Install Claude Code
  local container_workspace
  container_workspace="/workspaces/$(basename "$worktree_path")"

  # Step 1: Copy the host's ~/.claude/ directory (credentials, settings, plugins)
  local post_create_cmd="if [ -d /tmp/.host-claude ]; then mkdir -p ~/.claude && cp -a /tmp/.host-claude/. ~/.claude/ && rm -f ~/.claude/.credentials.json; fi"
  # Step 1b: Patch settings.json with model, effort, and thinking preferences.
  # Merges into existing settings (copied from host in step 1) or creates fresh.
  # Build a jq filter dynamically — model/effort values are simple strings (no special chars).
  local settings_filter=".alwaysThinkingEnabled = true | .skipDangerousModePermissionPrompt = true"
  [ -n "$claude_model" ] && settings_filter="$settings_filter | .model = \"$claude_model\""
  [ -n "$claude_effort" ] && settings_filter="$settings_filter | .effortLevel = \"$claude_effort\""
  # Apply filter to existing settings.json, or create from scratch using jq -n (same filter on empty object)
  post_create_cmd="$post_create_cmd ; if command -v jq >/dev/null; then if [ -f ~/.claude/settings.json ]; then jq '$settings_filter' ~/.claude/settings.json > ~/.claude/settings.json.tmp && mv ~/.claude/settings.json.tmp ~/.claude/settings.json; else mkdir -p ~/.claude && jq -n '{} | $settings_filter' > ~/.claude/settings.json; fi; fi"
  # Step 2: Mark ALL onboarding complete and trust the container workspace.
  # Every onboarding prompt needs its own flag — missing any causes an interactive dialog.
  post_create_cmd="$post_create_cmd ; echo '{\"hasCompletedOnboarding\":true,\"hasAcknowledgedCostThreshold\":true,\"shiftEnterKeyBindingInstalled\":true,\"installMethod\":\"native\",\"bypassPermissionsModeAccepted\":true,\"theme\":\"dark\",\"customApiKeyResponses\":{\"approved\":[],\"rejected\":[]},\"projects\":{\"$container_workspace\":{\"hasTrustDialogAccepted\":true,\"hasCompletedProjectOnboarding\":true,\"allowedTools\":[]}}}' > ~/.claude.json"
  # Step 3: Copy SSH keys and gitconfig from readonly mounts
  post_create_cmd="$post_create_cmd ; if [ -d /tmp/.host-ssh ]; then cp -r /tmp/.host-ssh ~/.ssh && chmod 700 ~/.ssh && chmod 600 ~/.ssh/* 2>/dev/null; fi"
  post_create_cmd="$post_create_cmd ; if [ -f /tmp/.host-gitconfig ]; then cp /tmp/.host-gitconfig ~/.gitconfig; fi"
  # Step 4: Install Claude Code and GitHub CLI globally
  post_create_cmd="$post_create_cmd ; npm install -g @anthropic-ai/claude-code"
  # Step 5: Install gh and restore host auth state (mirrors bootstrap.sh pattern)
  post_create_cmd="$post_create_cmd ; (sudo mkdir -p -m 755 /etc/apt/keyrings && wget -nv -O /tmp/gh-keyring.gpg https://cli.github.com/packages/githubcli-archive-keyring.gpg && cat /tmp/gh-keyring.gpg | sudo tee /etc/apt/keyrings/githubcli-archive-keyring.gpg > /dev/null && sudo chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg && echo \"deb [arch=\$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main\" | sudo tee /etc/apt/sources.list.d/github-cli.list > /dev/null && sudo apt-get update -qq && sudo apt-get install -y -qq gh) 2>/dev/null"
  post_create_cmd="$post_create_cmd ; if [ -d /tmp/.host-gh ]; then mkdir -p ~/.config/gh && cp -a /tmp/.host-gh/. ~/.config/gh/ && gh auth setup-git 2>/dev/null; fi"
  # Step 6: Fix git worktree paths (host absolute paths → container paths)
  local wt_name
  wt_name=$(basename "$worktree_path")
  post_create_cmd="$post_create_cmd ; if [ -f $container_workspace/.git ] && [ -d /tmp/.bare-repo ]; then echo 'gitdir: /tmp/.bare-repo/worktrees/$wt_name' > $container_workspace/.git && echo '$container_workspace' > /tmp/.bare-repo/worktrees/$wt_name/gitdir; fi"

  # Build mounts — always include .ssh and .gitconfig
  local mounts_json
  mounts_json=$(jq -n '[
    "source=${localEnv:HOME}/.ssh,target=/tmp/.host-ssh,type=bind,readonly",
    "source=${localEnv:HOME}/.gitconfig,target=/tmp/.host-gitconfig,type=bind,readonly"
  ]')
  # Mount host's entire ~/.claude/ dir (credentials, settings, plugins)
  if [ -d "$HOME/.claude" ]; then
    mounts_json=$(echo "$mounts_json" | jq '. + ["source=${localEnv:HOME}/.claude,target=/tmp/.host-claude,type=bind,readonly"]')
  fi
  # Mount host's gh CLI auth state
  if [ -d "$HOME/.config/gh" ]; then
    mounts_json=$(echo "$mounts_json" | jq '. + ["source=${localEnv:HOME}/.config/gh,target=/tmp/.host-gh,type=bind,readonly"]')
  fi
  # Mount the bare repo so git worktree paths resolve inside the container (read-write for commits/pushes)
  local bare_dir="$PROJECTS_DIR/$project"
  mounts_json=$(echo "$mounts_json" | jq --arg src "$bare_dir" \
    '. + [("source=" + $src + ",target=/tmp/.bare-repo,type=bind")]')

  # Generate devcontainer.json using jq for safe JSON construction.
  # Uses javascript-node image (Node pre-installed) instead of base + feature.
  jq -n \
    --arg name "${project}-session" \
    --arg node_ver "$node_version" \
    --argjson containerEnv "$container_env_json" \
    --argjson remoteEnv "$remote_env_json" \
    --argjson mounts "$mounts_json" \
    --arg pass_env "$pass_env" \
    --arg postCreate "$post_create_cmd" \
    '{
      name: $name,
      image: ("mcr.microsoft.com/devcontainers/javascript-node:" + $node_ver),
      containerEnv: $containerEnv,
      mounts: $mounts,
      remoteUser: "node",
      init: true,
      shutdownAction: "none",
      postCreateCommand: $postCreate
    }
    + (if $pass_env == "true" and ($remoteEnv | length > 0) then {remoteEnv: $remoteEnv} else {} end)' \
    > "$dc_file"

  # Don't commit generated devcontainer config — use local exclude to avoid polluting the repo's .gitignore
  # Use git rev-parse to find the actual .git dir (handles worktrees where .git is a file)
  local git_dir
  git_dir=$(git -C "$worktree_path" rev-parse --git-dir 2>/dev/null)
  if [ -n "$git_dir" ]; then
    local exclude_file="$git_dir/info/exclude"
    mkdir -p "$(dirname "$exclude_file")"
    if ! grep -q "^\.devcontainer/$" "$exclude_file" 2>/dev/null; then
      echo ".devcontainer/" >> "$exclude_file"
    fi
  fi

  log "Generated devcontainer config at $dc_file"
}

# Start a devcontainer for a worktree. Returns the container ID.
start_devcontainer() {
  local worktree_path="$1" session_name="$2" pass_env="$3"

  # Use >&2 for messages since this function's stdout is captured by $()
  info "Building and starting devcontainer..." >&2

  # Build devcontainer up command as an array (avoids eval + injection risks)
  local dc_args=("devcontainer" "up" "--workspace-folder" "$worktree_path"
                 "--id-label" "dev-cli.session=${session_name}")

  # If --env, pass non-API-key secrets via --remote-env
  # (API keys are already baked into containerEnv by ensure_devcontainer_json)
  if [ "$pass_env" = true ] && [ -f "$SECRETS_FILE" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
      [[ "$line" =~ ^[[:space:]]*# ]] && continue
      [[ -z "${line// /}" ]] && continue
      local key="${line%%=*}"
      local value="${line#*=}"
      key="${key#"${key%%[![:space:]]*}"}"
      key="${key%"${key##*[![:space:]]}"}"
      [ -z "$key" ] && continue
      # Skip keys already in containerEnv
      local is_api_key=false
      for api_key_name in "${CONTAINER_API_KEYS[@]}"; do
        [ "$key" = "$api_key_name" ] && { is_api_key=true; break; }
      done
      [ "$is_api_key" = true ] && continue
      value="${value#"${value%%[![:space:]]*}"}"
      value="${value%"${value##*[![:space:]]}"}"
      value="${value#\"}" ; value="${value%\"}"
      value="${value#\'}" ; value="${value%\'}"
      dc_args+=("--remote-env" "${key}=${value}")
    done < "$SECRETS_FILE"
  fi

  # devcontainer CLI outputs build logs on stderr and JSON result on stdout.
  # Capture them separately so jq can parse the JSON cleanly.
  local result stderr_log
  local stderr_file
  stderr_file=$(mktemp)
  result=$("${dc_args[@]}" 2>"$stderr_file") || {
    stderr_log=$(cat "$stderr_file")
    rm -f "$stderr_file"
    die "devcontainer up failed: $stderr_log"
  }
  rm -f "$stderr_file"

  local outcome container_id
  outcome=$(echo "$result" | jq -r '.outcome // empty' 2>/dev/null)
  container_id=$(echo "$result" | jq -r '.containerId // empty' 2>/dev/null)

  if [ "$outcome" != "success" ] || [ -z "$container_id" ]; then
    die "devcontainer up did not succeed. outcome=$outcome result=$result"
  fi

  log "Container started: ${container_id:0:12}" >&2
  echo "$container_id"
}

# Build a command prefix for executing inside a devcontainer.
# Usage: prefix=$(build_container_exec_cmd "$container_id")
#        tmux new-session -d -s name "$prefix bash"
# Note: -it is safe here because tmux always allocates a PTY for each
# window (even detached sessions). The -t flag is needed so programs
# like Claude Code that check isatty() can render their TUI.
build_container_exec_cmd() {
  local container_id="$1"
  # --user node: must match remoteUser in devcontainer.json so we read the
  # same home directory that postCreateCommand wrote config files to.
  echo "docker exec -it --user node \"$container_id\""
}

# Stop and remove a session's devcontainer.
stop_devcontainer() {
  local session_name="$1" container_id="$2"

  if [ -n "$container_id" ]; then
    info "Stopping devcontainer ${container_id:0:12}..."
    docker stop "$container_id" >/dev/null 2>&1 || true
    docker rm "$container_id" >/dev/null 2>&1 || true
    log "Container removed"
  else
    # Fallback: find by label
    local cid
    cid=$(docker ps -aq --filter "label=dev-cli.session=${session_name}" 2>/dev/null | head -1)
    if [ -n "$cid" ]; then
      info "Stopping devcontainer ${cid:0:12}..."
      docker stop "$cid" >/dev/null 2>&1 || true
      docker rm "$cid" >/dev/null 2>&1 || true
      log "Container removed"
    fi
  fi
}

# Get the remote workspace folder path inside the container.
# Checks for custom workspaceFolder in project's devcontainer.json, falls back to convention.
get_container_workspace() {
  local worktree_path="$1"

  # Check if project's devcontainer.json specifies a custom workspaceFolder
  local dc_file="$worktree_path/.devcontainer/devcontainer.json"
  if [ -f "$dc_file" ]; then
    local custom_folder
    custom_folder=$(jq -r '.workspaceFolder // empty' "$dc_file" 2>/dev/null)
    if [ -n "$custom_folder" ]; then
      echo "$custom_folder"
      return 0
    fi
  fi

  # Default devcontainer CLI convention
  local dir_name
  dir_name=$(basename "$worktree_path")
  echo "/workspaces/$dir_name"
}

# Build the shell command for running an agent, container-aware.
# Usage: agent_cmd=$(build_agent_cmd <agent_type> <worktree_path> [container_id] [claude_flags] [prompt_arg] [headless])
# Returns a shell string suitable for tmux new-window / new-session.
# When headless=true, uses `claude -p` for non-interactive execution (skips all onboarding).
# In headless mode, output streams to the tmux pane so the user can still `dev attach` to watch.
build_agent_cmd() {
  local agent_type="$1" worktree_path="$2"
  local container_id="${3:-}" claude_flags="${4:-}" prompt_arg="${5:-}" headless="${6:-false}"

  # In headless mode, claude -p reads the prompt and works non-interactively.
  # --dangerously-skip-permissions is safe here because the container is sandboxed.
  # The trailing "; echo ... && bash" keeps the tmux window open after completion.
  local claude_bin="claude"
  local done_suffix=""
  if [ "$headless" = true ] && [ "$agent_type" = "claude" ]; then
    claude_bin="claude -p"
    # --dangerously-skip-permissions is added via claude_flags by the caller when yolo=true.
    # For headless container mode, always ensure it's present (container is the sandbox).
    if [[ ! "$claude_flags" =~ dangerously-skip-permissions ]]; then
      claude_flags="${claude_flags} --dangerously-skip-permissions"
    fi
    done_suffix="; echo ''; echo 'Agent finished. Session kept open for inspection.'; exec bash"
  fi

  if [ -n "$container_id" ]; then
    local prefix workspace
    prefix=$(build_container_exec_cmd "$container_id")
    workspace=$(get_container_workspace "$worktree_path")
    # Use double quotes for bash -lc so inner content can contain single quotes
    # (e.g., prompts with apostrophes). Workspace paths are always /workspaces/<name>.
    case "$agent_type" in
      claude) echo "$prefix bash -lc \"cd $workspace && ${claude_bin}${claude_flags}${prompt_arg}${done_suffix}\"" ;;
      codex)  echo "$prefix bash -lc \"cd $workspace && codex${prompt_arg}${done_suffix}\"" ;;
      none)   echo "$prefix bash -lc \"cd $workspace && echo Ready. && bash\"" ;;
      *)      die "Unknown agent: $agent_type. Use claude, codex, or none." ;;
    esac
  else
    case "$agent_type" in
      claude) echo "cd $worktree_path && ${claude_bin}${claude_flags}${prompt_arg}${done_suffix}" ;;
      codex)  echo "cd $worktree_path && codex${prompt_arg}${done_suffix}" ;;
      none)   echo "cd $worktree_path && echo 'Ready. No agent started.' && bash" ;;
      *)      die "Unknown agent: $agent_type. Use claude, codex, or none." ;;
    esac
  fi
}

# Build a shell command for the shell/server windows, container-aware.
# Usage: shell_cmd=$(build_window_cmd <worktree_path> [container_id] [inner_cmd])
# If container_id is set, runs inside the container. Otherwise runs on host.
# inner_cmd defaults to "bash" if not provided.
build_window_cmd() {
  local worktree_path="$1" container_id="${2:-}" inner_cmd="${3:-bash}"

  if [ -n "$container_id" ]; then
    local prefix workspace
    prefix=$(build_container_exec_cmd "$container_id")
    workspace=$(get_container_workspace "$worktree_path")
    # Use double quotes for bash -lc so inner_cmd can contain single quotes
    echo "$prefix bash -lc \"cd $workspace && $inner_cmd\""
  else
    echo "cd $worktree_path && $inner_cmd"
  fi
}

# ── Supabase Config ─────────────────────────────────────────────────────────

patch_supabase_config() {
  local worktree_path="$1" slot="$2"
  local config="$worktree_path/supabase/config.toml"

  if [ ! -f "$config" ]; then
    warn "No supabase/config.toml found in worktree — skipping Supabase port config"
    return 0
  fi

  local ports
  ports=$(slot_ports "$slot")
  read -r _ _ supa_api supa_db supa_studio <<< "$ports"

  # Create a worktree-specific override
  # We copy the original and patch it
  local backup="$config.original"
  if [ ! -f "$backup" ]; then
    cp "$config" "$backup"
  fi

  # Patch ports using sed
  sed -i "s/^port = 54321$/port = $supa_api/" "$config" 2>/dev/null || true
  sed -i "s/^port = 54322$/port = $supa_db/" "$config" 2>/dev/null || true
  sed -i "s/^port = 54323$/port = $supa_studio/" "$config" 2>/dev/null || true

  # Also handle cases where ports were already changed
  # Match the [api], [db], [studio] sections more carefully
  # This is a simplified approach — works for standard supabase configs

  info "Patched Supabase ports: api=$supa_api, db=$supa_db, studio=$supa_studio"
}

# ── Commands ────────────────────────────────────────────────────────────────

cmd_setup() {
  local project="${2:-}" url="${3:-}"

  echo ""
  echo -e "  ${BOLD}Set up a new project${NC}"
  echo ""

  # Sanitize project name if passed as arg
  if [ -n "$project" ]; then
    project=$(echo "$project" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9-]//g')
    [ -z "$project" ] && die "Invalid project name (must contain alphanumeric characters or hyphens)"
    if [ -d "$PROJECTS_DIR/$project" ]; then
      die "Project '$project' already exists at $PROJECTS_DIR/$project"
    fi
  fi

  # Project name (interactive prompt if not provided)
  while [ -z "$project" ]; do
    read -rp "  Project name (short, no spaces, e.g. klyra): " project
    project=$(echo "$project" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9-]//g')
    if [ -z "$project" ]; then
      warn "Project name cannot be empty"
    elif [ -d "$PROJECTS_DIR/$project" ]; then
      warn "Project '$project' already exists at $PROJECTS_DIR/$project"
      read -rp "  Continue anyway and skip clone? [y/N]: " skip_clone
      if [ "$skip_clone" = "y" ] || [ "$skip_clone" = "Y" ]; then
        break
      fi
      project=""
    fi
  done

  # Validate URL if passed as arg
  if [ -n "$url" ] && [[ ! "$url" =~ ^git@|^https:// ]]; then
    die "Invalid git URL: $url (must start with git@ or https://)"
  fi

  # GitHub URL (interactive prompt if not provided)
  if [ -z "$url" ] && [ ! -d "$PROJECTS_DIR/$project" ]; then
    while [ -z "$url" ]; do
      read -rp "  GitHub URL (SSH or HTTPS, e.g. git@github.com:org/repo.git): " url
      if [ -z "$url" ]; then
        warn "URL cannot be empty"
      elif [[ ! "$url" =~ ^git@|^https:// ]]; then
        warn "Doesn't look like a valid git URL"
        url=""
      fi
    done
  fi

  # Quick vs detailed setup
  echo ""
  echo -e "  ${BOLD}Setup mode${NC}"
  echo "  1) Quick setup (use defaults, configure later)"
  echo "  2) Detailed setup (configure stack, env vars, etc.)"
  local setup_mode=""
  read -rp "  Select [1]: " setup_mode
  setup_mode=${setup_mode:-1}

  local has_nextjs="no" has_backend="no" has_supabase="no"
  local pkg_manager="npm"
  local run_cmd=""
  local is_monorepo="n"
  local packages=()
  local extra_vars=()
  declare -A pkg_vars

  if [ "$setup_mode" = "2" ]; then
    # Stack detection
    echo ""
    echo -e "  ${BOLD}Stack configuration${NC}"
    echo ""

    has_nextjs="y" has_backend="n" has_supabase="y"

    read -rp "  Has Next.js frontend? [Y/n]: " has_nextjs
    has_nextjs=${has_nextjs:-y}

    read -rp "  Has Express/Node backend? [y/N]: " has_backend
    has_backend=${has_backend:-n}

    read -rp "  Uses Supabase? [Y/n]: " has_supabase
    has_supabase=${has_supabase:-y}

    echo ""
    echo -e "  ${BOLD}Package manager${NC}"
    echo "  1) npm"
    echo "  2) pnpm"
    echo "  3) yarn"
    read -rp "  Select [1]: " pm_choice
    case "${pm_choice:-1}" in
      2) pkg_manager="pnpm" ;;
      3) pkg_manager="yarn" ;;
      *) pkg_manager="npm" ;;
    esac

    # Dev server command
    echo ""
    echo -e "  ${BOLD}Dev server command${NC}"
    echo -e "  ${DIM}Command to auto-run in the server window (e.g., pnpm dev, npm run dev)${NC}"
    echo -e "  ${DIM}Leave empty to skip (you can always start it manually)${NC}"
    read -rp "  Run command: " run_cmd

    # Monorepo detection
    echo ""
    read -rp "  Is this a monorepo with multiple packages? [y/N]: " is_monorepo
    is_monorepo=${is_monorepo:-n}

    if [[ "$is_monorepo" =~ ^[Yy] ]]; then
      echo ""
      echo -e "  ${BOLD}Package paths that need their own .env${NC}"
      echo -e "  ${DIM}Enter relative paths from repo root (e.g., packages/web, packages/api)${NC}"
      echo -e "  ${DIM}Press Enter on empty line when done${NC}"
      echo ""
      while true; do
        read -rp "  > " pkg_path
        [ -z "$pkg_path" ] && break
        packages+=("$pkg_path")
      done

      if [ ${#packages[@]} -eq 0 ]; then
        warn "No packages entered, treating as standard repo"
        is_monorepo="n"
      fi
    fi

    # Extra env vars
    echo ""
    echo -e "  ${BOLD}Extra environment variables${NC} (shared across all packages)"
    echo -e "  ${DIM}Add any project-specific vars (one per line, KEY=VALUE format)${NC}"
    echo -e "  ${DIM}Press Enter on empty line when done${NC}"
    echo ""

    while true; do
      read -rp "  > " var_line
      [ -z "$var_line" ] && break
      extra_vars+=("$var_line")
    done

    # Per-package env vars for monorepos
    if [[ "$is_monorepo" =~ ^[Yy] ]]; then
      for pkg in "${packages[@]}"; do
        echo ""
        echo -e "  ${BOLD}Extra env vars for ${CYAN}$pkg${NC}"
        echo -e "  ${DIM}Press Enter on empty line when done${NC}"
        local this_pkg_vars=""
        while true; do
          read -rp "  $pkg> " var_line
          [ -z "$var_line" ] && break
          this_pkg_vars+="$var_line"$'\n'
        done
        pkg_vars["$pkg"]="$this_pkg_vars"
      done
    fi
  fi

  # ── Execute setup ─────────────────────────────────────────

  echo ""
  info "Setting up project '$project'..."

  # Clone repo
  if [ -n "$url" ] && [ ! -d "$PROJECTS_DIR/$project" ]; then
    local bare_dir="$PROJECTS_DIR/$project"
    local wt_dir="$PROJECTS_DIR/${project}-worktrees"

    info "Cloning $url as bare repo..."
    git clone --bare "$url" "$bare_dir"

    cd "$bare_dir"
    git config remote.origin.fetch "+refs/heads/*:refs/remotes/origin/*"
    git fetch origin

    mkdir -p "$wt_dir"
    log "Repo cloned"
  else
    log "Repo already exists, skipping clone"
  fi

  # ── Generate setup hook or env template ─────────────────────

  if [[ "$is_monorepo" =~ ^[Yy] ]]; then
    # MONOREPO: Generate a setup.sh hook script
    local hook_dir="$CONFIG_DIR/hooks/$project"
    mkdir -p "$hook_dir"
    local setup_hook="$hook_dir/setup.sh"

    info "Generating monorepo setup hook..."
    cat > "$setup_hook" << 'HOOK_HEADER'
#!/usr/bin/env bash
###############################################################################
# Project setup hook (monorepo)
# Auto-generated by dev setup. Runs after worktree creation.
#
# Available env vars (set by dev CLI):
#   DEV_SLOT              Slot number
#   DEV_PROJECT           Project name
#   DEV_BRANCH            Branch name
#   DEV_WORKTREE          Worktree path
#   DEV_FRONTEND_PORT     Frontend port
#   DEV_BACKEND_PORT      Backend port
#   DEV_SUPA_API_PORT     Supabase API port
#   DEV_SUPA_DB_PORT      Supabase DB port
#   DEV_SUPA_STUDIO_PORT  Supabase Studio port
#   DEV_IP                Tailscale/server IP
#
# Edit this script to customize your worktree setup!
###############################################################################

set -euo pipefail

echo "Setting up monorepo worktree (slot $DEV_SLOT)..."

HOOK_HEADER

    # Generate env for each package
    local port_offset=0
    for pkg in "${packages[@]}"; do
      cat >> "$setup_hook" << HOOK_PKG

# ── $pkg ──────────────────────────────────────────────────
if [ -d "\$DEV_WORKTREE/$pkg" ]; then
  cat > "\$DEV_WORKTREE/$pkg/.env" << ENVEOF
# Auto-generated by dev CLI — slot \$DEV_SLOT
# Package: $pkg
NODE_ENV=development
HOOK_PKG

      # Add appropriate vars based on package name/type
      if echo "$pkg" | grep -qiE "web|frontend|app|next|client"; then
        cat >> "$setup_hook" << 'HOOK_FE'
PORT=$DEV_FRONTEND_PORT
NEXT_PUBLIC_PORT=$DEV_FRONTEND_PORT
ALLOWED_DEV_ORIGINS=$DEV_IP
HOOK_FE
      fi

      if echo "$pkg" | grep -qiE "api|backend|server|express"; then
        cat >> "$setup_hook" << 'HOOK_BE'
PORT=$DEV_BACKEND_PORT
HOOK_BE
      fi

      if [[ "$has_supabase" =~ ^[Yy] ]]; then
        cat >> "$setup_hook" << 'HOOK_SUPA'
NEXT_PUBLIC_SUPABASE_URL=http://localhost:$DEV_SUPA_API_PORT
SUPABASE_URL=http://localhost:$DEV_SUPA_API_PORT
SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:$DEV_SUPA_DB_PORT/postgres
HOOK_SUPA
      fi

      # Add per-package extra vars
      if [ -n "${pkg_vars[$pkg]:-}" ]; then
        echo "${pkg_vars[$pkg]}" >> "$setup_hook"
      fi

      # Add shared extra vars
      if [ ${#extra_vars[@]} -gt 0 ]; then
        for var in "${extra_vars[@]}"; do
          echo "$var" >> "$setup_hook"
        done
      fi

      cat >> "$setup_hook" << HOOK_PKG_END
ENVEOF
  echo "  ✓ $pkg/.env"
else
  echo "  ! $pkg not found, skipping"
fi
HOOK_PKG_END
    done

    # Also generate a root .env.local for shared config
    cat >> "$setup_hook" << 'HOOK_ROOT'

# ── Root .env.local (shared config) ──────────────────────
cat > "$DEV_WORKTREE/.env.local" << ENVEOF
# Auto-generated by dev CLI — slot $DEV_SLOT
NODE_ENV=development
DEV_SLOT=$DEV_SLOT
ENVEOF
echo "  ✓ .env.local (root)"

HOOK_ROOT

    # Patch supabase if present
    if [[ "$has_supabase" =~ ^[Yy] ]]; then
      cat >> "$setup_hook" << 'HOOK_SUPA_PATCH'
# ── Patch Supabase config ────────────────────────────────
if [ -f "$DEV_WORKTREE/supabase/config.toml" ]; then
  cp "$DEV_WORKTREE/supabase/config.toml" "$DEV_WORKTREE/supabase/config.toml.original" 2>/dev/null || true
  sed -i "s/^port = 54321$/port = $DEV_SUPA_API_PORT/" "$DEV_WORKTREE/supabase/config.toml" 2>/dev/null || true
  sed -i "s/^port = 54322$/port = $DEV_SUPA_DB_PORT/" "$DEV_WORKTREE/supabase/config.toml" 2>/dev/null || true
  sed -i "s/^port = 54323$/port = $DEV_SUPA_STUDIO_PORT/" "$DEV_WORKTREE/supabase/config.toml" 2>/dev/null || true
  echo "  ✓ supabase/config.toml ports patched"
fi
HOOK_SUPA_PATCH
    fi

    cat >> "$setup_hook" << 'HOOK_FOOTER'

echo "Monorepo setup complete!"
HOOK_FOOTER

    chmod +x "$setup_hook"
    log "Setup hook saved to $setup_hook"

    # No env template needed for monorepos (hook handles everything)
    local template="(using setup hook)"

  else
    # STANDARD REPO: Generate env template (existing behavior)
    mkdir -p "$CONFIG_DIR/templates"
    local template="$CONFIG_DIR/templates/${project}.env"

    info "Generating env template..."
    cat > "$template" << 'TMPL_HEADER'
# Auto-generated by dev setup
# Placeholders: {{FRONTEND_PORT}}, {{BACKEND_PORT}}, {{SUPA_API_PORT}},
#               {{SUPA_DB_PORT}}, {{SUPA_STUDIO_PORT}}, {{SLOT}}
TMPL_HEADER

    if [[ "$has_nextjs" =~ ^[Yy] ]]; then
      cat >> "$template" << 'TMPL_NEXT'

# ── Frontend (Next.js) ──────────────────────────
PORT={{FRONTEND_PORT}}
NEXT_PUBLIC_PORT={{FRONTEND_PORT}}
ALLOWED_DEV_ORIGINS={{IP}}
NODE_ENV=development
TMPL_NEXT
    fi

    if [[ "$has_backend" =~ ^[Yy] ]]; then
      cat >> "$template" << 'TMPL_BACK'

# ── Backend (Express) ───────────────────────────
BACKEND_PORT={{BACKEND_PORT}}
NEXT_PUBLIC_API_URL=http://localhost:{{BACKEND_PORT}}
TMPL_BACK
    fi

    if [[ "$has_supabase" =~ ^[Yy] ]]; then
      cat >> "$template" << 'TMPL_SUPA'

# ── Supabase ────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=http://localhost:{{SUPA_API_PORT}}
SUPABASE_URL=http://localhost:{{SUPA_API_PORT}}
SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:{{SUPA_DB_PORT}}/postgres
# Keys auto-filled by `dev supabase <session> start`
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
TMPL_SUPA
    fi

    if [ ${#extra_vars[@]} -gt 0 ]; then
      echo "" >> "$template"
      echo "# ── Project-specific ────────────────────────────" >> "$template"
      for var in "${extra_vars[@]}"; do
        echo "$var" >> "$template"
      done
    fi

    log "Env template saved to $template"
  fi

  # Save project config
  local project_config="$CONFIG_DIR/projects/${project}.json"
  mkdir -p "$CONFIG_DIR/projects"

  # Build packages JSON array
  local packages_json="[]"
  if [ ${#packages[@]} -gt 0 ]; then
    packages_json=$(printf '%s\n' "${packages[@]}" | jq -R . | jq -s .)
  fi

  cat > "$project_config" << PCONF
{
  "name": "$project",
  "is_monorepo": "$is_monorepo",
  "packages": $packages_json,
  "has_nextjs": "$has_nextjs",
  "has_backend": "$has_backend",
  "has_supabase": "$has_supabase",
  "pkg_manager": "$pkg_manager",
  "run_cmd": "$run_cmd",
  "created": "$(date -Iseconds)"
}
PCONF
  log "Project config saved to $project_config"

  # Done
  echo ""
  echo "============================================"
  echo -e "  ${GREEN}Project '$project' is ready!${NC}"
  echo "============================================"
  echo ""
  echo "  Bare repo:     $PROJECTS_DIR/$project"
  echo "  Worktrees:     $PROJECTS_DIR/${project}-worktrees"
  if [[ "$is_monorepo" =~ ^[Yy] ]]; then
    echo "  Setup hook:    $CONFIG_DIR/hooks/$project/setup.sh"
    echo ""
    echo "  ${BOLD}Customize the setup hook to fine-tune env vars:${NC}"
    echo "    nano $CONFIG_DIR/hooks/$project/setup.sh"
  else
    echo "  Env template:  $template"
    echo ""
    echo "  Edit the template to add secrets or tune vars:"
    echo "    nano $template"
  fi
  echo ""
  echo "  Spin up an agent:"
  echo "    dev new $project feat/my-feature --agent claude"
  echo ""
}

cmd_new() {
  local project="${2:-}" branch="${3:-}" agent="" agents_flag="" run_cmd="" yolo=false attach=false from_branch="" private=false container=false container_env=false initial_prompt="" headless=false
  shift 2 || true

  # Parse options
  while [[ $# -gt 0 ]]; do
    case "${1:-}" in
      --agent) agent="${2:-claude}"; shift 2 ;;
      --agent=*) agent="${1#*=}"; shift ;;
      --agents) agents_flag="${2:-}"; shift 2 ;;
      --agents=*) agents_flag="${1#*=}"; shift ;;
      --run) run_cmd="${2:-}"; shift 2 ;;
      --run=*) run_cmd="${1#*=}"; shift ;;
      --from) from_branch="${2:-}"; shift 2 ;;
      --from=*) from_branch="${1#*=}"; shift ;;
      --prompt) initial_prompt="${2:-}"; shift 2 ;;
      --prompt=*) initial_prompt="${1#*=}"; shift ;;
      --yolo) yolo=true; shift ;;
      --attach) attach=true; shift ;;
      --private) private=true; shift ;;
      --container) container=true; shift ;;
      --headless) headless=true; shift ;;
      --env) container_env=true; shift ;;
      *) shift ;;
    esac
  done

  # Resolve agent(s): --agents flag > --agent flag > project config defaults > "claude"
  if [ -n "$agents_flag" ]; then
    agent="$agents_flag"
  elif [ -z "$agent" ]; then
    if [ -n "$project" ] && [ -f "$CONFIG_DIR/projects/${project}.json" ]; then
      local config_agents
      config_agents=$(jq -r '.defaults.agents // empty' "$CONFIG_DIR/projects/${project}.json" 2>/dev/null)
      if [ -n "$config_agents" ]; then
        agent="$config_agents"
      else
        agent="claude"
      fi
    else
      agent="claude"
    fi
  fi

  # Resolve yolo: --yolo flag > project config
  if [ "$yolo" != true ] && [ -n "$project" ] && [ -f "$CONFIG_DIR/projects/${project}.json" ]; then
    local config_yolo
    config_yolo=$(jq -r '.skip_permissions // false' "$CONFIG_DIR/projects/${project}.json" 2>/dev/null)
    [ "$config_yolo" = "true" ] && yolo=true
  fi

  # Resolve container: --container flag > project config
  if [ "$container" != true ] && [ -n "$project" ] && [ -f "$CONFIG_DIR/projects/${project}.json" ]; then
    local config_container
    config_container=$(jq -r '.use_container // false' "$CONFIG_DIR/projects/${project}.json" 2>/dev/null)
    [ "$config_container" = "true" ] && container=true
  fi

  # Resolve container_env: --env flag > project config
  if [ "$container_env" != true ] && [ "$container" = true ] && [ -n "$project" ] && [ -f "$CONFIG_DIR/projects/${project}.json" ]; then
    local config_container_env
    config_container_env=$(jq -r '.container_env // false' "$CONFIG_DIR/projects/${project}.json" 2>/dev/null)
    [ "$config_container_env" = "true" ] && container_env=true
  fi

  # --env only makes sense with --container
  if [ "$container_env" = true ] && [ "$container" != true ]; then
    warn "--env flag is only used with --container, ignoring"
    container_env=false
  fi

  # Resolve container Claude preferences from project config
  local claude_model="" claude_effort=""
  if [ "$container" = true ] && [ -n "$project" ] && [ -f "$CONFIG_DIR/projects/${project}.json" ]; then
    claude_model=$(jq -r '.claude_model // empty' "$CONFIG_DIR/projects/${project}.json" 2>/dev/null)
    claude_effort=$(jq -r '.claude_effort // empty' "$CONFIG_DIR/projects/${project}.json" 2>/dev/null)
  fi
  # Default effort to "high" if not set
  [ -z "$claude_effort" ] && claude_effort="high"

  # Auto-enable headless when container + prompt (fire-and-forget use case).
  # The user provided a prompt, so they expect the agent to just work — no interaction needed.
  if [ "$container" = true ] && [ -n "$initial_prompt" ] && [ "$headless" != true ]; then
    headless=true
    info "Using headless mode (prompt provided with --container)"
  fi

  # Headless requires a prompt — the agent needs to know what to do
  if [ "$headless" = true ] && [ -z "$initial_prompt" ]; then
    die "Headless mode requires --prompt. The agent needs a task to work on."
  fi

  # Headless implies container — it's the sandbox that makes headless safe
  if [ "$headless" = true ] && [ "$container" != true ]; then
    container=true
    info "Headless mode implies --container (agent needs a sandbox)"
  fi

  # Headless implies yolo — the container IS the sandbox
  if [ "$headless" = true ] && [ "$yolo" != true ]; then
    yolo=true
  fi

  # Container mode requires devcontainer CLI
  if [ "$container" = true ] && ! command -v devcontainer &>/dev/null; then
    die "devcontainer CLI not found. Install it with: npm install -g @devcontainers/cli"
  fi

  [ -z "$project" ] && die "Usage: dev new <project> <branch> [--from <base>] [--agent claude|codex|none] [--agents claude,codex] [--yolo] [--attach] [--container] [--headless] [--env] [--private] [--prompt \"...\"]"
  [ -z "$branch" ] && die "Usage: dev new <project> <branch> [--from <base>] [--agent claude|codex|none] [--agents claude,codex] [--yolo] [--attach] [--container] [--headless] [--env] [--private] [--prompt \"...\"]"

  local bare_dir="$PROJECTS_DIR/$project"
  local wt_dir="$PROJECTS_DIR/${project}-worktrees"
  local slug
  slug=$(slugify "$branch")
  local worktree_path="$wt_dir/$slug"
  local name
  name=$(session_name "$project" "$branch")

  # Check user status and session limit
  if type get_user_status &>/dev/null && type has_user_registry &>/dev/null && has_user_registry; then
    local _status
    _status=$(get_user_status "$USER" 2>/dev/null || echo "active")
    [[ "$_status" == "active" ]] || die "Your account is $_status. Contact your admin."
  fi
  if type can_create_session &>/dev/null && ! can_create_session "$USER"; then
    local _max _current
    _max=$(get_user_max_sessions "$USER")
    _current=$(count_user_sessions "$USER")
    die "Session limit reached ($_current/$_max). Kill an existing session or ask admin to increase your limit."
  fi

  # Validate
  [ -d "$bare_dir" ] || die "Project '$project' not found. Run 'dev setup $project <url>' first."
  [ -z "$(get_session "$name")" ] || die "Session '$name' already exists. Run 'dev kill $name' first."

  # Allocate slot
  local slot
  slot=$(find_free_slot)
  info "Allocated slot $slot for $name"

  # Create worktree
  info "Creating worktree for branch '$branch'..."
  cd "$bare_dir"
  git fetch origin --prune

  if [ -n "$from_branch" ]; then
    # User specified a base branch with --from
    # Prefer origin ref (freshly fetched) over potentially stale local branch
    local from_ref
    if git show-ref --verify --quiet "refs/remotes/origin/$from_branch" 2>/dev/null; then
      from_ref="origin/$from_branch"
      info "Using freshly fetched origin/$from_branch as base"
    elif git show-ref --verify --quiet "refs/heads/$from_branch" 2>/dev/null; then
      from_ref="$from_branch"
      info "Base branch '$from_branch' found locally (not on origin)"
    else
      die "Base branch '$from_branch' not found locally or on origin."
    fi
    info "Branch '$branch' will be based on $from_ref"
    if git show-ref --verify --quiet "refs/heads/$branch" 2>/dev/null; then
      # Branch already exists locally, just check it out
      git worktree add "$worktree_path" "$branch"
    else
      git worktree add "$worktree_path" -b "$branch" "$from_ref"
    fi
  elif git show-ref --verify --quiet "refs/heads/$branch" 2>/dev/null || \
     git show-ref --verify --quiet "refs/remotes/origin/$branch" 2>/dev/null; then
    # Branch exists
    git worktree add "$worktree_path" "$branch" 2>/dev/null || \
    git worktree add "$worktree_path" "origin/$branch" --checkout 2>/dev/null || \
    git worktree add "$worktree_path" -b "$branch" "origin/$branch"
  else
    # New branch — base off main/master
    local base_branch
    base_branch=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's|refs/remotes/origin/||' || echo "main")
    info "Branch '$branch' is new, creating from origin/$base_branch"
    git worktree add "$worktree_path" -b "$branch" "origin/$base_branch"
  fi

  log "Worktree created at $worktree_path"

  # Calculate ports for this slot
  local ports
  ports=$(slot_ports "$slot")
  read -r wt_frontend wt_backend wt_supa_api wt_supa_db wt_supa_studio <<< "$ports"

  # Set up port isolation
  if command -v authbind &>/dev/null && type setup_authbind_ports &>/dev/null; then
    setup_authbind_ports "$USER" "$wt_frontend" "$wt_backend" "$wt_supa_api" "$wt_supa_db" "$wt_supa_studio"
  fi

  # Check project config to determine which ports are needed
  local proj_config="$CONFIG_DIR/projects/${project}.json"
  if [ -f "$proj_config" ]; then
    local has_next has_back has_supa
    has_next=$(jq -r '.has_nextjs // "n"' "$proj_config")
    has_back=$(jq -r '.has_backend // "n"' "$proj_config")
    has_supa=$(jq -r '.has_supabase // "n"' "$proj_config")
    [[ ! "$has_next" =~ ^[Yy] ]] && wt_frontend="null"
    [[ ! "$has_back" =~ ^[Yy] ]] && wt_backend="null"
    if [[ ! "$has_supa" =~ ^[Yy] ]]; then
      wt_supa_api="null"; wt_supa_db="null"; wt_supa_studio="null"
    fi
  fi

  # Export port vars so hooks and scripts can use them (only for non-null ports)
  export DEV_SLOT="$slot"
  export DEV_PROJECT="$project"
  export DEV_BRANCH="$branch"
  export DEV_WORKTREE="$worktree_path"
  [ "$wt_frontend" != "null" ] && export DEV_FRONTEND_PORT="$wt_frontend"
  [ "$wt_backend" != "null" ] && export DEV_BACKEND_PORT="$wt_backend"
  [ "$wt_supa_api" != "null" ] && export DEV_SUPA_API_PORT="$wt_supa_api"
  [ "$wt_supa_db" != "null" ] && export DEV_SUPA_DB_PORT="$wt_supa_db"
  [ "$wt_supa_studio" != "null" ] && export DEV_SUPA_STUDIO_PORT="$wt_supa_studio"
  export DEV_IP="$(get_ip)"

  # Run project setup hook OR default env generation
  # Priority: 1) in-repo .dev/setup.sh  2) global hook  3) default env generation
  local repo_hook="$worktree_path/.dev/setup.sh"
  local global_hook="$CONFIG_DIR/hooks/$project/setup.sh"

  if [ -x "$repo_hook" ]; then
    info "Running in-repo setup hook (.dev/setup.sh)..."
    cd "$worktree_path" && bash "$repo_hook"
    log "In-repo hook completed"
  elif [ -x "$global_hook" ]; then
    info "Running global project setup hook..."
    cd "$worktree_path" && bash "$global_hook"
    log "Global hook completed"
  else
    # Default behavior: single .env.local + supabase patch
    generate_env_local "$worktree_path" "$slot" "$project"
    patch_supabase_config "$worktree_path" "$slot"
  fi

  # Install dependencies (skip for container mode — handled inside container)
  if [ "$container" != true ]; then
    info "Installing dependencies..."
    cd "$worktree_path"

    # Detect package manager: lockfile first, then project config, then npm
    local pkg_mgr=""
    if [ -f "pnpm-lock.yaml" ]; then
      pkg_mgr="pnpm"
    elif [ -f "yarn.lock" ]; then
      pkg_mgr="yarn"
    elif [ -f "package-lock.json" ]; then
      pkg_mgr="npm"
    elif [ -f "$CONFIG_DIR/projects/${project}.json" ]; then
      pkg_mgr=$(jq -r '.pkg_manager // "npm"' "$CONFIG_DIR/projects/${project}.json")
    else
      pkg_mgr="npm"
    fi

    if [ -f "package.json" ]; then
      $pkg_mgr install 2>&1 | tail -3
      log "Dependencies installed ($pkg_mgr)"
    else
      warn "No package.json found, skipping install"
    fi
  fi

  # Resolve run command: --run flag > project config > none
  if [ -z "$run_cmd" ] && [ -f "$CONFIG_DIR/projects/${project}.json" ]; then
    run_cmd=$(jq -r '.run_cmd // empty' "$CONFIG_DIR/projects/${project}.json")
  fi

  # ── Devcontainer setup (when --container is used) ────────────────────────
  local container_id=""

  if [ "$container" = true ]; then
    # Generate devcontainer.json if the project doesn't have one
    ensure_devcontainer_json "$worktree_path" "$project" "$container_env" "$claude_model" "$claude_effort"

    # Set up cleanup trap: if devcontainer start fails, remove orphaned worktree.
    # Use a string trap (not a function) so variable values are captured now,
    # since locals from cmd_new go out of scope when die→exit fires the trap.
    trap "warn 'Devcontainer failed, cleaning up worktree...' ; cd \"$bare_dir\" 2>/dev/null || true ; git worktree remove \"$worktree_path\" --force 2>/dev/null || rm -rf \"$worktree_path\" 2>/dev/null || true" EXIT

    # Start the devcontainer
    container_id=$(start_devcontainer "$worktree_path" "$name" "$container_env")

    # Devcontainer started successfully — remove the cleanup trap
    trap - EXIT
  fi

  # Register in port registry (include container_id if present)
  register_session "$name" "$project" "$branch" "$slot" "$agent" "$worktree_path" "$private"
  type audit_log &>/dev/null && audit_log "$USER" "session.create" "$name" "$(jq -nc --arg p "$project" --arg b "$branch" '{project:$p,branch:$b}')"

  # Store container info in registry if container mode
  if [ -n "$container_id" ]; then
    (
      flock -x 200
      local tmp
      tmp=$(mktemp)
      jq --arg name "$name" \
         --arg cid "$container_id" \
         --arg cenv "$container_env" \
         --argjson hl "$([ "$headless" = true ] && echo true || echo false)" \
         --arg prompt "$initial_prompt" \
         '.[$name].container_id = $cid | .[$name].use_container = true | .[$name].container_env = ($cenv == "true") | .[$name].headless = $hl | (if $prompt != "" then .[$name].headless_prompt = $prompt else . end)' \
         "$PORT_REGISTRY" > "$tmp"
      mv -f "$tmp" "$PORT_REGISTRY"
      fix_registry_perms
    ) 200>"${PORT_REGISTRY}.lock"
  fi

  # Source secrets for tmux windows.
  # In container mode, secrets are passed via --remote-env at container start,
  # so env_prefix is not needed (docker exec doesn't inherit parent env anyway).
  local env_prefix=""
  if [ "$container" != true ]; then
    env_prefix=$(build_env_prefix)
  fi

  if [[ "$agent" == *claude* ]]; then
    validate_claude_auth || true
  fi

  # Create tmux session with agent(s)
  # Parse comma-separated agents list
  local primary_agent
  primary_agent=$(echo "$agent" | cut -d',' -f1)
  info "Starting tmux session '$name' with $agent..."

  local claude_flags=""
  if [ "$yolo" = true ]; then
    claude_flags=" --dangerously-skip-permissions"
    # In container mode, settings.json is already copied from host in postCreateCommand.
    # On host, ensure the skip prompt setting exists.
    [ "$container" != true ] && ensure_claude_skip_prompt
  fi

  # Pre-trust the worktree directory so Claude doesn't prompt
  # "Do you trust the files in this folder?" on first launch.
  # In container mode, trust is set for the container workspace path in postCreateCommand.
  [ "$container" != true ] && ensure_claude_trust "$worktree_path"

  local prompt_arg=""
  if [ -n "$initial_prompt" ]; then
    if [ -n "$container_id" ]; then
      # Write prompt to file in worktree (bind-mounted into container).
      # Avoids nested quoting: bash → docker exec → bash -lc → claude -p.
      printf '%s' "$initial_prompt" > "$worktree_path/.dev-prompt"
      local container_workspace="/workspaces/$(basename "$worktree_path")"
      prompt_arg=" < $container_workspace/.dev-prompt"
    else
      local escaped_prompt="${initial_prompt//\\/\\\\}"
      escaped_prompt="${escaped_prompt//\$/\\\$}"
      escaped_prompt="${escaped_prompt//\`/\\\`}"
      escaped_prompt="${escaped_prompt//\"/\\\"}"
      prompt_arg=" \"${escaped_prompt}\""
    fi
  fi

  local agent_cmd
  agent_cmd=$(build_agent_cmd "$primary_agent" "$worktree_path" "$container_id" "$claude_flags" "$prompt_arg" "$headless")

  # Set port env vars on tmux session so all windows/panes inherit them.
  local ip
  ip=$(get_ip)

  create_tmux_windows "$name" "$project" "$worktree_path" "$env_prefix" "$agent_cmd" "$run_cmd" "$wt_frontend" "$wt_backend" "$ip" "$container_id"

  # Create additional agent windows for dual-agent mode
  local IFS_BAK="$IFS"
  IFS=',' read -ra agent_list <<< "$agent"
  IFS="$IFS_BAK"
  if [ ${#agent_list[@]} -gt 1 ]; then
    for extra_agent in "${agent_list[@]:1}"; do
      local extra_cmd
      extra_cmd=$(build_agent_cmd "$extra_agent" "$worktree_path" "$container_id" "$claude_flags") || { warn "Unknown agent '$extra_agent', skipping"; continue; }
      tmux new-window -t "$name" -n "agent-${extra_agent}" "${env_prefix}${extra_cmd}"
      info "Added agent window: agent-${extra_agent}"
    done
  fi

  [ "$wt_frontend" != "null" ] && tmux set-environment -t "$name" DEV_FRONTEND_PORT "$wt_frontend"
  [ "$wt_backend" != "null" ] && tmux set-environment -t "$name" DEV_BACKEND_PORT "$wt_backend"
  [ "$wt_supa_api" != "null" ] && tmux set-environment -t "$name" DEV_SUPA_API_PORT "$wt_supa_api"
  [ "$wt_supa_db" != "null" ] && tmux set-environment -t "$name" DEV_SUPA_DB_PORT "$wt_supa_db"
  [ "$wt_supa_studio" != "null" ] && tmux set-environment -t "$name" DEV_SUPA_STUDIO_PORT "$wt_supa_studio"
  tmux set-environment -t "$name" DEV_SLOT "$slot"

  log "Session '$name' is running!"
  random_celebration
  echo ""
  echo -e "  ${BOLD}Session:${NC}  $name"
  echo -e "  ${BOLD}Agent(s):${NC} $agent"
  echo -e "  ${BOLD}Branch:${NC}   $branch"
  echo -e "  ${BOLD}Path:${NC}     $worktree_path"
  if [ "$container" = true ]; then
    local mode_label="interactive"
    [ "$headless" = true ] && mode_label="headless"
    echo -e "  ${BOLD}Container:${NC} ${container_id:0:12} ($mode_label)"
  fi
  if [ "$wt_frontend" != "null" ]; then
    echo -e "  ${BOLD}Frontend:${NC} http://$ip:$wt_frontend"
  fi
  if [ "$wt_backend" != "null" ]; then
    echo -e "  ${BOLD}Backend:${NC}  http://$ip:$wt_backend"
  fi
  echo ""
  echo -e "  ${DIM}Attach:    dev attach $name${NC}"
  local win_names
  win_names=$(get_tmux_windows "$project" | jq -r '.[].name' | paste -sd' | ' -)
  echo -e "  ${DIM}Windows:   $win_names${NC}"
  echo ""

  if [ "$container" = true ] && [ "$headless" = true ]; then
    echo -e "  ${GREEN}Headless mode:${NC} Agent is working inside the container."
    echo -e "  ${DIM}The agent will complete the task and exit. Watch with: dev attach $name${NC}"
    echo ""
  elif [ "$container" = true ]; then
    warn "Interactive container mode is experimental."
    echo -e "  ${DIM}You may see onboarding prompts from Claude Code on first launch.${NC}"
    echo -e "  ${DIM}For fully automated use, add --prompt to enable headless mode.${NC}"
    echo ""
  fi

  if [ "$attach" = true ]; then
    tmux attach-session -t "$name"
  fi
}

cmd_ls() {
  ensure_dirs

  # Parse flags
  local show_all=false
  shift || true
  while [[ $# -gt 0 ]]; do
    case "${1:-}" in
      --all|-a) show_all=true; shift ;;
      *) shift ;;
    esac
  done

  local sessions
  if [ "$show_all" = true ]; then
    sessions=$(jq -r --arg user "$USER" 'to_entries[] | select(.value.private != true or .value.owner == $user or .value.owner == null) | .key' "$PORT_REGISTRY" 2>/dev/null)
  else
    sessions=$(jq -r --arg user "$USER" 'to_entries[] | select(.value.owner == $user or .value.owner == null) | .key' "$PORT_REGISTRY" 2>/dev/null)
  fi

  if [ -z "$sessions" ]; then
    if [ "$show_all" = true ]; then
      echo -e "${DIM}No active sessions. Run 'dev new <project> <branch>' to start one.${NC}"
    else
      echo -e "${DIM}No active sessions for $USER. Use 'dev ls --all' to see all sessions.${NC}"
    fi
    return 0
  fi

  local ip
  ip=$(get_ip)
  local total_count
  total_count=$(jq 'length' "$PORT_REGISTRY" 2>/dev/null || echo "0")

  # Header
  printf "\n"
  if [ "$show_all" = true ]; then
    echo -e "  ${DIM}All sessions ($total_count/$MAX_SLOTS slots used)${NC}"
  else
    echo -e "  ${DIM}$USER's sessions ($total_count/$MAX_SLOTS total slots used)${NC}"
  fi
  printf "\n"

  if is_compact; then
    # Compact card layout for narrow terminals
    while IFS= read -r name; do
      local agent branch frontend owner
      agent=$(get_session_agents "$name")
      branch=$(get_session_field "$name" "branch")
      frontend=$(get_session_field "$name" "ports.frontend")
      owner=$(get_session_field "$name" "owner")

      local created age
      created=$(get_session_field "$name" "created")
      age=$(human_readable_age "$created")

      local status_icon
      if tmux has-session -t "$name" 2>/dev/null; then
        status_icon="${GREEN}●${NC}"
        local status_word="running"
      else
        status_icon="${RED}●${NC}"
        local status_word="dead"
      fi

      local branch_display
      branch_display=$(echo "$branch" | cut -c1-20)

      local port_display
      if [ "$frontend" != "null" ] && [ -n "$frontend" ]; then
        port_display=$(hyperlink "http://$ip:$frontend" ":$frontend")
      else
        port_display="-"
      fi

      echo -e "  $status_icon ${BOLD}$name${NC} ${DIM}($status_word)${NC}"
      printf "    ${DIM}$agent · %s · $age · $branch_display${NC}\n" "$port_display"
    done <<< "$sessions"
  else
    # Full table for wide terminals
    printf "  ${BOLD}%-30s %-10s %-14s %-8s %-8s %-10s %-6s %-8s${NC}\n" \
      "SESSION" "OWNER" "AGENT(S)" "FRONT" "BACK" "BRANCH" "AGE" "STATUS"
    printf "  ${DIM}%-30s %-10s %-14s %-8s %-8s %-10s %-6s %-8s${NC}\n" \
      "──────────────────────────────" "──────────" "──────────────" "────────" "────────" "──────────" "──────" "────────"

    while IFS= read -r name; do
      local agent branch frontend backend owner
      agent=$(get_session_agents "$name")
      branch=$(get_session_field "$name" "branch")
      frontend=$(get_session_field "$name" "ports.frontend")
      backend=$(get_session_field "$name" "ports.backend")
      owner=$(get_session_field "$name" "owner")
      owner="${owner:-unknown}"

      local created age
      created=$(get_session_field "$name" "created")
      age=$(human_readable_age "$created")

      local status
      if tmux has-session -t "$name" 2>/dev/null; then
        status="${GREEN}running${NC}"
      else
        status="${RED}dead${NC}"
      fi

      local branch_display
      branch_display=$(echo "$branch" | cut -c1-10)

      local front_display back_display
      if [ "$frontend" != "null" ] && [ -n "$frontend" ]; then
        front_display=$(hyperlink "http://$ip:$frontend" ":$frontend")
      else
        front_display="-"
      fi
      if [ "$backend" != "null" ] && [ -n "$backend" ]; then
        back_display=$(hyperlink "http://$ip:$backend" ":$backend")
      else
        back_display="-"
      fi

      # Hyperlinks contain invisible escape sequences, so we can't use %-8s formatting
      # directly. Print the fixed-width columns first, then the hyperlink columns manually.
      printf "  %-30s %-10s %-14s " "$name" "$owner" "$agent"
      # Pad the hyperlink fields to 8 chars visible width
      local front_text back_text
      [ "$frontend" != "null" ] && [ -n "$frontend" ] && front_text=":$frontend" || front_text="-"
      [ "$backend" != "null" ] && [ -n "$backend" ] && back_text=":$backend" || back_text="-"
      local front_pad=$((8 - ${#front_text}))
      local back_pad=$((8 - ${#back_text}))
      printf "%s%*s%s%*s" "$front_display" "$front_pad" "" "$back_display" "$back_pad" ""
      printf "%-10s %-6s " "$branch_display" "$age"
      echo -e "$status"
    done <<< "$sessions"
  fi

  printf "\n"
  echo -e "  ${DIM}Frontend URLs:  http://$ip:<port>${NC}"
  echo -e "  ${DIM}Attach:         dev attach <session>${NC}"
  printf "\n"
  random_tip
  printf "\n"
}

cmd_attach() {
  # Parse flags
  local show_all=false name=""
  shift || true
  while [[ $# -gt 0 ]]; do
    case "${1:-}" in
      --all|-a) show_all=true; shift ;;
      *) [ -z "$name" ] && name="$1"; shift ;;
    esac
  done

  if [ -z "$name" ]; then
    # If no name, show picker
    local sessions
    if [ "$show_all" = true ]; then
      sessions=$(jq -r --arg user "$USER" 'to_entries[] | select(.value.private != true or .value.owner == $user or .value.owner == null) | .key' "$PORT_REGISTRY" 2>/dev/null)
    else
      sessions=$(jq -r --arg user "$USER" 'to_entries[] | select(.value.owner == $user or .value.owner == null) | .key' "$PORT_REGISTRY" 2>/dev/null)
    fi
    if [ -z "$sessions" ]; then
      if [ "$show_all" = true ]; then
        die "No active sessions."
      else
        die "No active sessions. Use --all to see all users' sessions."
      fi
    fi
    echo "Active sessions:"
    local i=1
    while IFS= read -r s; do
      local agent branch
      agent=$(get_session_field "$s" "agent")
      branch=$(get_session_field "$s" "branch")
      echo "  $i) $s [$agent] ($branch)"
      i=$((i + 1))
    done <<< "$sessions"
    echo ""
    read -rp "Select session number: " choice
    name=$(echo "$sessions" | sed -n "${choice}p")
    [ -z "$name" ] && die "Invalid selection."
  fi

  # Support partial matching — collect all matches
  local matches
  matches=$(jq -r "keys[] | select(contains(\"$name\"))" "$PORT_REGISTRY")
  [ -z "$matches" ] && die "No session matching '$name'"

  # Filter out dead sessions (no active tmux session)
  local alive_matches=()
  while IFS= read -r m; do
    if tmux has-session -t "$m" 2>/dev/null; then
      alive_matches+=("$m")
    fi
  done <<< "$matches"

  if [ "${#alive_matches[@]}" -eq 0 ]; then
    die "No live session matching '$name' (found only dead sessions — run 'dev gc' to clean up)"
  fi

  local match
  if [ "${#alive_matches[@]}" -eq 1 ]; then
    match="${alive_matches[0]}"
  else
    # Check for exact match first
    for m in "${alive_matches[@]}"; do
      if [ "$m" = "$name" ]; then
        match="$m"
        break
      fi
    done

    if [ -z "${match:-}" ]; then
      # Multiple live matches — prompt user to select
      echo ""
      echo -e "  ${YELLOW}Multiple live sessions match '$name':${NC}"
      echo ""
      local i=1
      for m in "${alive_matches[@]}"; do
        local agent branch
        agent=$(get_session_field "$m" "agent")
        branch=$(get_session_field "$m" "branch")
        echo -e "    ${BLUE}$i)${NC} $m [$agent] ($branch)"
        i=$((i + 1))
      done
      echo ""
      read -rp "  Select session number: " choice
      if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "${#alive_matches[@]}" ]; then
        match="${alive_matches[$((choice - 1))]}"
      else
        die "Invalid selection."
      fi
    fi
  fi

  type audit_log &>/dev/null && audit_log "$USER" "session.attach" "$match" '{}'
  tmux attach-session -t "$match"
}

cmd_kill() {
  # Handle --all, --project, and --force flags
  local kill_all=false kill_project="" force=false
  local args=("$@")
  local positional=()
  for arg in "${args[@]}"; do
    case "$arg" in
      --all) kill_all=true ;;
      -f|--force) force=true ;;
      --project) kill_project="__NEXT__" ;;
      --project=*) kill_project="${arg#*=}" ;;
      *)
        if [ "$kill_project" = "__NEXT__" ]; then
          kill_project="$arg"
        else
          positional+=("$arg")
        fi
        ;;
    esac
  done

  if [ "$kill_all" = true ]; then
    local sessions
    sessions=$(jq -r --arg user "$USER" '[to_entries[] | select(.value.owner == $user or .value.owner == null)] | .[].key' "$PORT_REGISTRY" 2>/dev/null)
    if [ -z "$sessions" ]; then
      echo "No sessions to kill."
      return 0
    fi
    if [ "$force" != true ]; then
      echo ""
      echo -e "  ${YELLOW}Kill ALL sessions?${NC}"
      echo ""
      while IFS= read -r s; do
        echo "    $s"
      done <<< "$sessions"
      echo ""
      echo -ne "  ${YELLOW}Confirm? [y/N]:${NC} "
      read -r confirm
      [ "$confirm" = "y" ] || [ "$confirm" = "Y" ] || { echo "  Cancelled."; return 0; }
    fi
    while IFS= read -r s; do
      cmd_kill "kill" "$s" --force
    done <<< "$sessions"
    return 0
  fi

  if [ -n "$kill_project" ] && [ "$kill_project" != "__NEXT__" ]; then
    local sessions
    sessions=$(jq -r --arg user "$USER" --arg proj "$kill_project" 'to_entries[] | select(.value.project == $proj) | select(.value.owner == $user or .value.owner == null) | .key' "$PORT_REGISTRY" 2>/dev/null)
    if [ -z "$sessions" ]; then
      echo "No sessions for project '$kill_project'."
      return 0
    fi
    if [ "$force" != true ]; then
      echo ""
      echo -e "  ${YELLOW}Kill all sessions for project '$kill_project'?${NC}"
      echo ""
      while IFS= read -r s; do
        echo "    $s"
      done <<< "$sessions"
      echo ""
      echo -ne "  ${YELLOW}Confirm? [y/N]:${NC} "
      read -r confirm
      [ "$confirm" = "y" ] || [ "$confirm" = "Y" ] || { echo "  Cancelled."; return 0; }
    fi
    while IFS= read -r s; do
      cmd_kill "kill" "$s" --force
    done <<< "$sessions"
    return 0
  fi

  local name="${positional[1]:-}"
  [ -z "$name" ] && die "Usage: dev kill <session> [--all] [--project <name>] [-f|--force]"

  # Support partial matching — collect all matches (only current user's sessions)
  local matches
  matches=$(jq -r --arg name "$name" --arg user "$USER" 'to_entries[] | select(.key | contains($name)) | select(.value.owner == $user or .value.owner == null) | .key' "$PORT_REGISTRY")

  if [ -z "$matches" ]; then
    warn "Session '$name' not found in registry"
    tmux kill-session -t "$name" 2>/dev/null && log "Killed tmux session '$name'" || true
    return 0
  fi

  local match_count
  match_count=$(echo "$matches" | wc -l)

  # Exact match — skip selection
  local exact_match
  exact_match=$(echo "$matches" | grep -x "$name" || true)
  if [ -n "$exact_match" ]; then
    matches="$exact_match"
    match_count=1
  fi

  if [ "$match_count" -gt 1 ]; then
    if [ "$force" = true ]; then
      # --force with multiple matches: kill all matches
      while IFS= read -r m; do
        cmd_kill "kill" "$m" --force
      done <<< "$matches"
      return 0
    fi
    echo ""
    echo -e "  ${YELLOW}Multiple sessions match '$name':${NC}"
    echo ""
    local i=1
    local match_array=()
    while IFS= read -r m; do
      match_array+=("$m")
      echo -e "    ${BLUE}$i)${NC} $m"
      i=$((i + 1))
    done <<< "$matches"
    echo -e "    ${BLUE}a)${NC} All of the above"
    echo ""
    echo -ne "  ${YELLOW}Select session(s) to kill (e.g. 1, 1 3, a) or 'q' to cancel:${NC} "
    read -r selection

    [ "$selection" = "q" ] || [ -z "$selection" ] && { echo "  Cancelled."; return 0; }

    local to_kill=()
    if [ "$selection" = "a" ] || [ "$selection" = "A" ]; then
      to_kill=("${match_array[@]}")
    else
      for sel in $selection; do
        if [[ "$sel" =~ ^[0-9]+$ ]] && [ "$sel" -ge 1 ] && [ "$sel" -le "${#match_array[@]}" ]; then
          to_kill+=("${match_array[$((sel - 1))]}")
        else
          warn "Invalid selection: $sel"
        fi
      done
    fi

    if [ "${#to_kill[@]}" -eq 0 ]; then
      echo "  No valid sessions selected. Cancelled."
      return 0
    fi

    echo ""
    echo -e "  ${YELLOW}Will kill:${NC}"
    for s in "${to_kill[@]}"; do
      echo "    $s"
    done
    echo ""
    echo -ne "  ${YELLOW}Confirm? [y/N]:${NC} "
    read -r confirm
    [ "$confirm" = "y" ] || [ "$confirm" = "Y" ] || { echo "  Cancelled."; return 0; }

    for s in "${to_kill[@]}"; do
      cmd_kill "kill" "$s" --force
    done
    return 0
  fi

  # Single match
  name="$matches"

  if [ "$force" != true ]; then
    echo ""
    echo -ne "  ${YELLOW}Kill session '$name'? [y/N]:${NC} "
    read -r confirm
    [ "$confirm" = "y" ] || [ "$confirm" = "Y" ] || { echo "  Cancelled."; return 0; }
  fi

  local session_owner
  session_owner=$(get_session_field "$name" "owner")
  if [ -n "$session_owner" ] && [ "$session_owner" != "$USER" ]; then
    die "Session '$name' belongs to $session_owner. You can only kill your own sessions."
  fi

  local worktree_path project
  worktree_path=$(get_session_field "$name" "path")
  project=$(get_session_field "$name" "project")
  local session_type
  session_type=$(get_session_field "$name" "type")

  info "Tearing down session '$name'..."

  # Stop devcontainer first (allows graceful agent shutdown before tmux dies)
  local container_id
  container_id=$(get_session_field "$name" "container_id")
  if [ -n "$container_id" ]; then
    stop_devcontainer "$name" "$container_id"
  fi

  # Kill tmux session
  tmux kill-session -t "$name" 2>/dev/null && log "Killed tmux session" || warn "tmux session already gone"

  # Ghost sessions have no repo — just clean up the directory and unregister
  if [ "$session_type" = "ghost" ]; then
    if [ -d "$worktree_path" ]; then
      rm -rf "$worktree_path"
      log "Removed ghost directory"
    fi
    if command -v authbind &>/dev/null && type cleanup_authbind_ports &>/dev/null; then
      cleanup_authbind_ports \
        "$(get_session_field "$name" "ports.frontend" 2>/dev/null || true)" \
        "$(get_session_field "$name" "ports.backend" 2>/dev/null || true)" \
        "$(get_session_field "$name" "ports.supa_api" 2>/dev/null || true)" \
        "$(get_session_field "$name" "ports.supa_db" 2>/dev/null || true)" \
        "$(get_session_field "$name" "ports.supa_studio" 2>/dev/null || true)"
    fi
    unregister_session "$name"
    type audit_log &>/dev/null && audit_log "$USER" "session.kill" "$name" '{}'
    log "Session '$name' fully cleaned up"
    random_farewell
    return 0
  fi

  # Scaffold sessions are standalone git repos (not worktrees from a bare repo)
  if [ "$session_type" = "scaffold" ]; then
    if [ -d "$worktree_path" ]; then
      # Check for unpushed commits
      local has_remote=false
      cd "$worktree_path"
      git remote get-url origin &>/dev/null && has_remote=true

      local commit_count
      commit_count=$(git rev-list --count HEAD 2>/dev/null || echo "0")

      if [ "$commit_count" -gt 0 ]; then
        local unpushed=true
        if [ "$has_remote" = true ]; then
          local pushed
          pushed=$(git rev-list --count origin/main..HEAD 2>/dev/null || echo "$commit_count")
          [ "$pushed" -eq 0 ] && unpushed=false
        fi

        if [ "$unpushed" = true ] && [ "$force" != true ]; then
          echo ""
          warn "Scaffold '$project' has ${commit_count} commit(s) that may not be pushed."
          echo -ne "  ${YELLOW}Delete project directory anyway? [y/N]:${NC} "
          read -r confirm
          [ "$confirm" = "y" ] || [ "$confirm" = "Y" ] || {
            echo "  Cancelled. Directory kept at: $worktree_path"
            unregister_session "$name"
            return 0
          }
        fi
      fi

      rm -rf "$worktree_path"
      log "Removed scaffold directory"
    fi
    if command -v authbind &>/dev/null && type cleanup_authbind_ports &>/dev/null; then
      cleanup_authbind_ports \
        "$(get_session_field "$name" "ports.frontend" 2>/dev/null || true)" \
        "$(get_session_field "$name" "ports.backend" 2>/dev/null || true)" \
        "$(get_session_field "$name" "ports.supa_api" 2>/dev/null || true)" \
        "$(get_session_field "$name" "ports.supa_db" 2>/dev/null || true)" \
        "$(get_session_field "$name" "ports.supa_studio" 2>/dev/null || true)"
    fi
    unregister_session "$name"
    type audit_log &>/dev/null && audit_log "$USER" "session.kill" "$name" '{}'
    log "Session '$name' fully cleaned up"
    random_farewell
    return 0
  fi

  local bare_dir="$PROJECTS_DIR/$project"

  # Stop Supabase if running in this worktree
  if [ -d "$worktree_path/supabase" ]; then
    info "Stopping Supabase..."
    cd "$worktree_path" && supabase stop 2>/dev/null || true
  fi

  # Remove worktree
  local branch
  branch=$(get_session_field "$name" "branch")

  if [ -d "$worktree_path" ]; then
    info "Removing worktree..."
    if [ -d "$bare_dir" ]; then
      cd "$bare_dir"
      git worktree remove "$worktree_path" --force 2>/dev/null || {
        warn "git worktree remove failed, cleaning up manually"
        rm -rf "$worktree_path"
      }
    else
      rm -rf "$worktree_path"
    fi
    log "Worktree removed"
  fi

  # Always prune stale worktree metadata so the branch is no longer "checked out"
  if [ -d "$bare_dir" ]; then
    cd "$bare_dir"
    git worktree prune 2>/dev/null || true

    # Delete the local branch so the same branch name can be reused with dev new.
    # Remote branch is untouched — only the local ref is removed.
    # Skip for ask sessions (they use detached HEAD, no local branch to delete).
    if [ -n "$branch" ] && [ "$session_type" != "ask" ]; then
      if git show-ref --verify --quiet "refs/heads/$branch" 2>/dev/null; then
        # Try safe delete first (fails if branch has unmerged/unpushed commits)
        if git branch -d "$branch" 2>/dev/null; then
          log "Deleted local branch '$branch'"
        else
          # Branch has unpushed work — ask before force-deleting
          echo ""
          warn "Branch '$branch' has commits not pushed to origin."
          echo -ne "  ${YELLOW}Delete local branch anyway? [y/N]:${NC} "
          read -r confirm
          if [ "$confirm" = "y" ] || [ "$confirm" = "Y" ]; then
            git branch -D "$branch" 2>/dev/null && log "Force-deleted local branch '$branch'" || warn "Could not delete local branch '$branch'"
          else
            warn "Kept local branch '$branch'. You may need to manually prune it before reusing this branch name."
          fi
        fi
      fi
    fi
  fi

  # Clean up port isolation
  if command -v authbind &>/dev/null && type cleanup_authbind_ports &>/dev/null; then
    local _kill_fp _kill_bp _kill_sap _kill_sdp _kill_ssp
    _kill_fp=$(get_session_field "$name" "ports.frontend" 2>/dev/null || echo "")
    _kill_bp=$(get_session_field "$name" "ports.backend" 2>/dev/null || echo "")
    _kill_sap=$(get_session_field "$name" "ports.supa_api" 2>/dev/null || echo "")
    _kill_sdp=$(get_session_field "$name" "ports.supa_db" 2>/dev/null || echo "")
    _kill_ssp=$(get_session_field "$name" "ports.supa_studio" 2>/dev/null || echo "")
    cleanup_authbind_ports "$_kill_fp" "$_kill_bp" "$_kill_sap" "$_kill_sdp" "$_kill_ssp"
  fi

  # Unregister
  unregister_session "$name"
  type audit_log &>/dev/null && audit_log "$USER" "session.kill" "$name" '{}'
  log "Session '$name' fully cleaned up"
  random_farewell
}

cmd_dashboard() {
  local sessions
  sessions=$(jq -r 'keys[]' "$PORT_REGISTRY" 2>/dev/null)

  if [ -z "$sessions" ]; then
    die "No active sessions to show."
  fi

  local count
  count=$(echo "$sessions" | wc -l)
  local dash_session="dashboard"

  # Kill existing dashboard
  tmux kill-session -t "$dash_session" 2>/dev/null || true

  # Create dashboard session
  local first
  first=$(echo "$sessions" | head -1)
  tmux new-session -d -s "$dash_session" "tmux attach-session -t '$first' -r"

  local i=0
  while IFS= read -r name; do
    if [ $i -gt 0 ]; then
      if [ $((i % 2)) -eq 1 ]; then
        tmux split-window -h -t "$dash_session" "tmux attach-session -t '$name' -r"
      else
        tmux split-window -v -t "$dash_session" "tmux attach-session -t '$name' -r"
      fi
    fi
    i=$((i + 1))
  done <<< "$sessions"

  tmux select-layout -t "$dash_session" tiled
  tmux attach-session -t "$dash_session"
}

cmd_hub() {
  local HUB_SCRIPT="$HOME/.local/bin/dev-hub"

  if [ ! -f "$HUB_SCRIPT" ]; then
    die "dev-hub not found at $HUB_SCRIPT. Run ./install.sh to install it."
  fi

  # If already inside tmux, check if hub session exists
  if tmux has-session -t hub 2>/dev/null; then
    # Hub exists — switch to it or attach
    if [ -n "${TMUX:-}" ]; then
      tmux switch-client -t hub
    else
      tmux attach-session -t hub
    fi
    return
  fi

  # Create hub session
  if [ -n "${TMUX:-}" ]; then
    # Inside tmux — create session and switch
    tmux new-session -d -s hub -n hub "$HUB_SCRIPT"
    tmux switch-client -t hub
  else
    # Outside tmux — create and attach
    tmux new-session -s hub -n hub "$HUB_SCRIPT"
  fi
}

cmd_ports() {
  ensure_dirs

  local ip
  ip=$(get_ip)

  echo ""
  echo -e "  ${BOLD}Port Allocation${NC} (IP: $ip)"
  echo ""

  local active_slots
  active_slots=$(jq -r --arg user "$USER" 'to_entries | map(select(.value.private != true or .value.owner == $user or .value.owner == null)) | sort_by(.value.slot) | .[] | "\(.value.slot)\t\(.key)"' "$PORT_REGISTRY" 2>/dev/null)

  if [ -z "$active_slots" ]; then
    echo -e "  ${DIM}No active sessions. All $MAX_SLOTS slots available.${NC}"
  elif is_compact; then
    # Compact: slot, session, frontend, backend only
    printf "  ${BOLD}%-4s %-20s %-8s %-8s${NC}\n" \
      "SLOT" "SESSION" "FRONT" "BACK"
    printf "  ${DIM}%-4s %-20s %-8s %-8s${NC}\n" \
      "────" "────────────────────" "────────" "────────"
    while IFS=$'\t' read -r slot session_name; do
      local frontend backend
      frontend=$(get_session_field "$session_name" "ports.frontend")
      backend=$(get_session_field "$session_name" "ports.backend")
      local front_display back_display
      [ "$frontend" != "null" ] && [ -n "$frontend" ] && front_display=":$frontend" || front_display="-"
      [ "$backend" != "null" ] && [ -n "$backend" ] && back_display=":$backend" || back_display="-"
      local short_name
      short_name=$(echo "$session_name" | cut -c1-20)
      printf "  ${GREEN}%-4s${NC} %-20s %-8s %-8s\n" \
        "$slot" "$short_name" "$front_display" "$back_display"
    done <<< "$active_slots"
  else
    # Full table
    printf "  ${BOLD}%-5s %-30s %-10s %-10s %-10s %-10s %-10s${NC}\n" \
      "SLOT" "SESSION" "FRONTEND" "BACKEND" "SUPA API" "SUPA DB" "SUPA UI"
    printf "  ${DIM}%-5s %-30s %-10s %-10s %-10s %-10s %-10s${NC}\n" \
      "─────" "──────────────────────────────" "──────────" "──────────" "──────────" "──────────" "──────────"
    while IFS=$'\t' read -r slot session_name; do
      local frontend backend supa_api supa_db supa_studio
      frontend=$(get_session_field "$session_name" "ports.frontend")
      backend=$(get_session_field "$session_name" "ports.backend")
      supa_api=$(get_session_field "$session_name" "ports.supa_api")
      supa_db=$(get_session_field "$session_name" "ports.supa_db")
      supa_studio=$(get_session_field "$session_name" "ports.supa_studio")
      local fd bd sad sdd sud
      [ "$frontend" != "null" ] && [ -n "$frontend" ] && fd=":$frontend" || fd="-"
      [ "$backend" != "null" ] && [ -n "$backend" ] && bd=":$backend" || bd="-"
      [ "$supa_api" != "null" ] && [ -n "$supa_api" ] && sad=":$supa_api" || sad="-"
      [ "$supa_db" != "null" ] && [ -n "$supa_db" ] && sdd=":$supa_db" || sdd="-"
      [ "$supa_studio" != "null" ] && [ -n "$supa_studio" ] && sud=":$supa_studio" || sud="-"
      printf "  ${GREEN}%-5s${NC} %-30s %-10s %-10s %-10s %-10s %-10s\n" \
        "$slot" "$session_name" "$fd" "$bd" "$sad" "$sdd" "$sud"
    done <<< "$active_slots"
  fi
  echo ""
}

cmd_logs() {
  local name="${2:-}"
  [ -z "$name" ] && die "Usage: dev logs <session>"

  # Support partial matching
  local match
  match=$(jq -r "keys[] | select(contains(\"$name\"))" "$PORT_REGISTRY" | head -1)
  [ -z "$match" ] && die "No session matching '$name'"

  # Capture tmux pane content
  tmux capture-pane -t "$match:0" -p -S -100
}

cmd_url() {
  local name="${2:-}"
  [ -z "$name" ] && die "Usage: dev url <session>"

  local match
  match=$(jq -r "keys[] | select(contains(\"$name\"))" "$PORT_REGISTRY" | head -1)
  [ -z "$match" ] && die "No session matching '$name'"

  local ip frontend backend
  ip=$(get_ip)
  frontend=$(get_session_field "$match" "ports.frontend")
  backend=$(get_session_field "$match" "ports.backend")

  echo ""
  echo -e "  ${BOLD}$match${NC}"
  if [ "$frontend" != "null" ] && [ -n "$frontend" ]; then
    echo -e "  Frontend: ${CYAN}http://$ip:$frontend${NC}"
  fi
  if [ "$backend" != "null" ] && [ -n "$backend" ]; then
    echo -e "  Backend:  ${CYAN}http://$ip:$backend${NC}"
  fi
  if { [ "$frontend" = "null" ] || [ -z "$frontend" ]; } && { [ "$backend" = "null" ] || [ -z "$backend" ]; }; then
    echo -e "  ${DIM}No ports allocated for this project.${NC}"
  fi
  echo ""
}

cmd_supabase() {
  local name="${2:-}" subcmd="${3:-start}"
  [ -z "$name" ] && die "Usage: dev supabase <session> [start|stop|reset|status]"

  local match
  match=$(jq -r "keys[] | select(contains(\"$name\"))" "$PORT_REGISTRY" | head -1)
  [ -z "$match" ] && die "No session matching '$name'"

  local worktree_path
  worktree_path=$(get_session_field "$match" "path")
  cd "$worktree_path"

  case "$subcmd" in
    start)
      info "Starting Supabase for $match..."
      supabase start
      # After start, update .env.local with the actual keys
      local anon_key service_key
      anon_key=$(supabase status -o json 2>/dev/null | jq -r '.ANON_KEY // empty')
      service_key=$(supabase status -o json 2>/dev/null | jq -r '.SERVICE_ROLE_KEY // empty')
      if [ -n "$anon_key" ]; then
        # Append or update keys in .env.local
        local env_file="$worktree_path/.env.local"
        if grep -q "NEXT_PUBLIC_SUPABASE_ANON_KEY" "$env_file"; then
          sed -i "s|^.*NEXT_PUBLIC_SUPABASE_ANON_KEY=.*|NEXT_PUBLIC_SUPABASE_ANON_KEY=$anon_key|" "$env_file"
        else
          echo "NEXT_PUBLIC_SUPABASE_ANON_KEY=$anon_key" >> "$env_file"
        fi
        if [ -n "$service_key" ]; then
          if grep -q "SUPABASE_SERVICE_ROLE_KEY" "$env_file"; then
            sed -i "s|^.*SUPABASE_SERVICE_ROLE_KEY=.*|SUPABASE_SERVICE_ROLE_KEY=$service_key|" "$env_file"
          else
            echo "SUPABASE_SERVICE_ROLE_KEY=$service_key" >> "$env_file"
          fi
        fi
        log "Updated .env.local with Supabase keys"
      fi
      ;;
    stop)
      info "Stopping Supabase for $match..."
      supabase stop
      ;;
    reset)
      warn "This will reset the database for $match. Continue? [y/N]"
      read -rp "" confirm
      [ "$confirm" = "y" ] || [ "$confirm" = "Y" ] || { echo "Cancelled."; return 0; }
      supabase db reset
      ;;
    status)
      supabase status
      ;;
    *)
      die "Unknown supabase command: $subcmd. Use start, stop, reset, or status."
      ;;
  esac
}

cmd_pr_start() {
  local project="${2:-}" pr_ref="${3:-}" agent="" agents_flag="" yolo=false attach=false private=false prompt=""
  shift 2 || true
  shift || true

  # Parse options
  while [[ $# -gt 0 ]]; do
    case "${1:-}" in
      --agent) agent="${2:-claude}"; shift 2 ;;
      --agent=*) agent="${1#*=}"; shift ;;
      --agents) agents_flag="${2:-}"; shift 2 ;;
      --agents=*) agents_flag="${1#*=}"; shift ;;
      --yolo) yolo=true; shift ;;
      --attach) attach=true; shift ;;
      --private) private=true; shift ;;
      --prompt) prompt="${2:-}"; shift 2 ;;
      --prompt=*) prompt="${1#*=}"; shift ;;
      *) shift ;;
    esac
  done

  [ -z "$project" ] && die "Usage: dev pr-start <project> <pr-number|pr-url> [--agent claude|codex|none] [--yolo] [--attach] [--private] [--prompt \"...\"]"
  [ -z "$pr_ref" ] && die "Usage: dev pr-start <project> <pr-number|pr-url> [--agent claude|codex|none] [--yolo] [--attach] [--private] [--prompt \"...\"]"

  local bare_dir="$PROJECTS_DIR/$project"
  [ -d "$bare_dir" ] || die "Project '$project' not found. Run 'dev setup $project <url>' first."

  # Resolve the PR reference — could be a number (#123 or 123) or a full URL
  local pr_number=""
  if [[ "$pr_ref" =~ ^https?:// ]]; then
    # Extract PR number from URL (e.g., https://github.com/org/repo/pull/123)
    pr_number=$(echo "$pr_ref" | grep -oP '/pull/\K[0-9]+' || true)
    [ -z "$pr_number" ] && die "Could not extract PR number from URL: $pr_ref"
  else
    pr_number="${pr_ref#\#}"
  fi

  # Fetch PR metadata using gh
  info "Fetching PR #${pr_number} info..."
  cd "$bare_dir"

  local pr_json
  pr_json=$(gh pr view "$pr_number" --json headRefName,title,body,url,state,number 2>/dev/null) \
    || die "Could not fetch PR #${pr_number}. Make sure the PR exists and 'gh' is authenticated."

  local branch pr_title pr_body pr_url pr_state
  branch=$(echo "$pr_json" | jq -r '.headRefName')
  pr_title=$(echo "$pr_json" | jq -r '.title')
  pr_body=$(echo "$pr_json" | jq -r '.body // ""')
  pr_url=$(echo "$pr_json" | jq -r '.url')
  pr_state=$(echo "$pr_json" | jq -r '.state')

  [ -z "$branch" ] && die "Could not determine branch for PR #${pr_number}"

  info "PR #${pr_number}: $pr_title"
  info "Branch: $branch (state: $pr_state)"

  # Build the context prompt to pass directly to Claude via --prompt
  local context_prompt
  if [ -n "$prompt" ]; then
    context_prompt="You are continuing work on an existing PR. Read .pr-context.md for the PR details (PR #${pr_number}: ${pr_title}). ${prompt}"
  else
    context_prompt="You are continuing work on an existing PR. Read .pr-context.md for the full PR description and context. The PR is #${pr_number}: ${pr_title} (${pr_url}). Review the existing changes and continue working on this PR."
  fi

  # Build args for cmd_new
  local new_args=("new" "$project" "$branch")
  if [ -n "$agents_flag" ]; then
    new_args+=("--agents" "$agents_flag")
  elif [ -n "$agent" ]; then
    new_args+=("--agent" "$agent")
  fi
  [ "$yolo" = true ] && new_args+=("--yolo")
  [ "$private" = true ] && new_args+=("--private")
  new_args+=("--prompt" "$context_prompt")

  # Create the session via cmd_new (prompt is passed directly to Claude as CLI arg)
  cmd_new "${new_args[@]}"

  # Build the session name so we can write PR context file
  local name
  name=$(session_name "$project" "$branch")

  # Write PR context file into the worktree for the agent to reference.
  # The worktree already exists (cmd_new creates it synchronously before launching tmux).
  local worktree_path
  worktree_path=$(get_session_field "$name" "path")

  if [ -n "$worktree_path" ] && [ -d "$worktree_path" ]; then
    cat > "$worktree_path/.pr-context.md" << PREOF
# PR #${pr_number}: ${pr_title}

**URL:** ${pr_url}
**State:** ${pr_state}
**Branch:** ${branch}

## Description

${pr_body}
PREOF
    log "PR context written to $worktree_path/.pr-context.md"
  fi

  # Update the registry with PR metadata
  (
    flock -x 200
    local tmp
    tmp=$(mktemp)
    jq --arg name "$name" \
       --arg pr_url "$pr_url" \
       --arg pr_title "$pr_title" \
       --argjson pr_number "$pr_number" \
       '.[$name].pr_url = $pr_url | .[$name].pr_number = $pr_number | .[$name].pr_title = $pr_title' \
       "$PORT_REGISTRY" > "$tmp"
    mv -f "$tmp" "$PORT_REGISTRY"
    fix_registry_perms
  ) 200>"${PORT_REGISTRY}.lock"

  echo -e "  ${BOLD}PR:${NC}       ${CYAN}$pr_url${NC}"
  echo ""

  if [ "$attach" = true ]; then
    tmux attach-session -t "$name"
  fi
}

cmd_pr() {
  local name="${2:-}"
  [ -z "$name" ] && die "Usage: dev pr <session> [--title \"PR title\"] [--draft]"

  # Support partial matching
  local match
  match=$(jq -r "keys[] | select(contains(\"$name\"))" "$PORT_REGISTRY" | head -1)
  [ -z "$match" ] && die "No session matching '$name'"

  local worktree_path branch project
  worktree_path=$(get_session_field "$match" "path")
  branch=$(get_session_field "$match" "branch")
  project=$(get_session_field "$match" "project")

  # Parse options
  local title="" draft_flag="" do_kill="ask"
  shift 2 || true
  while [[ $# -gt 0 ]]; do
    case "${1:-}" in
      --title) title="${2:-}"; shift 2 ;;
      --title=*) title="${1#*=}"; shift ;;
      --draft) draft_flag="--draft"; shift ;;
      --kill) do_kill="yes"; shift ;;
      --no-kill) do_kill="no"; shift ;;
      *) shift ;;
    esac
  done

  cd "$worktree_path"

  # Check for uncommitted changes
  local status
  status=$(git status --porcelain 2>/dev/null)
  if [ -n "$status" ]; then
    echo ""
    echo -e "  ${YELLOW}Uncommitted changes found:${NC}"
    echo ""
    git status --short | head -20 | sed 's/^/    /'
    echo ""
    echo "  Options:"
    echo "    1) Commit all changes with a message"
    echo "    2) Open lazygit to review and commit"
    echo "    3) Continue anyway (changes won't be in PR)"
    echo "    4) Cancel"
    echo ""
    read -rp "  Select [1]: " commit_choice

    case "${commit_choice:-1}" in
      1)
        if [ -z "$title" ]; then
          read -rp "  Commit message: " commit_msg
        else
          commit_msg="$title"
        fi
        [ -z "$commit_msg" ] && commit_msg="feat: $branch changes"
        git add -A
        git commit -m "$commit_msg"
        log "Changes committed"
        ;;
      2)
        lazygit
        # Check if there are still uncommitted changes
        status=$(git status --porcelain 2>/dev/null)
        if [ -n "$status" ]; then
          warn "Still uncommitted changes. Continuing anyway."
        fi
        ;;
      3)
        warn "Proceeding with uncommitted changes — they won't be in the PR"
        ;;
      4)
        echo "Cancelled."
        return 0
        ;;
    esac
  fi

  # Push branch
  info "Pushing branch '$branch'..."
  git push origin "$branch" 2>&1 | tail -5
  log "Branch pushed"

  # Get default branch for PR base
  local bare_dir="$PROJECTS_DIR/$project"
  local base_branch
  base_branch=$(cd "$bare_dir" && git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's|refs/remotes/origin/||' || echo "main")

  # Build PR title
  if [ -z "$title" ]; then
    # Generate a default title from branch name
    title=$(echo "$branch" | sed 's|^feat/||;s|^fix/||;s|^chore/||' | sed 's/-/ /g;s/_/ /g' | sed 's/.*/\u&/')
    echo ""
    read -rp "  PR title [$title]: " custom_title
    title="${custom_title:-$title}"
  fi

  # Create PR
  info "Creating pull request..."
  local pr_url
  if [ -n "$draft_flag" ]; then
    pr_url=$(gh pr create --title "$title" --body "" --base "$base_branch" --draft 2>&1)
  else
    pr_url=$(gh pr create --title "$title" --body "" --base "$base_branch" 2>&1)
  fi

  if [ $? -eq 0 ]; then
    log "Pull request created!"
    echo ""
    echo -e "  ${CYAN}$pr_url${NC}"
    echo ""
  else
    # PR might already exist
    local existing_url
    existing_url=$(gh pr view "$branch" --json url -q '.url' 2>/dev/null)
    if [ -n "$existing_url" ]; then
      log "PR already exists"
      echo ""
      echo -e "  ${CYAN}$existing_url${NC}"
      echo ""
    else
      warn "Failed to create PR: $pr_url"
      return 1
    fi
  fi

  # Ask about cleanup
  if [ "$do_kill" = "ask" ]; then
    echo ""
    read -rp "  Kill session '$match' now? [y/N]: " kill_confirm
    if [ "$kill_confirm" = "y" ] || [ "$kill_confirm" = "Y" ]; then
      do_kill="yes"
    fi
  fi

  if [ "$do_kill" = "yes" ]; then
    cmd_kill "kill" "$match"
  else
    echo -e "  ${DIM}Session still running. Kill later with: dev kill $match${NC}"
  fi
}

cmd_shell() {
  local name="${2:-}"
  [ -z "$name" ] && die "Usage: dev shell <session>"

  local match
  match=$(jq -r "keys[] | select(contains(\"$name\"))" "$PORT_REGISTRY" | head -1)
  [ -z "$match" ] && die "No session matching '$name'"

  # If session uses a devcontainer, exec into the container directly
  local shell_cid
  shell_cid=$(get_session_field "$match" "container_id")
  if [ -n "$shell_cid" ]; then
    if ! docker inspect "$shell_cid" --format '{{.State.Status}}' 2>/dev/null | grep -q "running"; then
      die "Container ${shell_cid:0:12} is not running. Use 'dev restart $match' to restart."
    fi
    local shell_workspace
    shell_workspace=$(get_container_workspace "$(get_session_field "$match" "path")")
    info "Opening shell inside container ${shell_cid:0:12}..."
    docker exec -it --user node "$shell_cid" bash -lc "cd $shell_workspace && exec bash"
    return $?
  fi

  # Normal mode: attach to the shell window
  tmux attach-session -t "$match:2"
}

cmd_worktree() {
  local project="${2:-}" branch="${3:-}"
  [ -z "$project" ] && die "Usage: dev worktree <project> <branch>"
  [ -z "$branch" ] && die "Usage: dev worktree <project> <branch>"

  # Reuse cmd_new with --agent none
  cmd_new "new" "$project" "$branch" "--agent" "none"
}

cmd_diff() {
  local name="${2:-}"
  [ -z "$name" ] && die "Usage: dev diff <session> [--full]"

  local match
  match=$(jq -r "keys[] | select(contains(\"$name\"))" "$PORT_REGISTRY" | head -1)
  [ -z "$match" ] && die "No session matching '$name'"

  local worktree_path
  worktree_path=$(get_session_field "$match" "path")

  local full=false
  shift 2 || true
  while [[ $# -gt 0 ]]; do
    case "${1:-}" in
      --full) full=true; shift ;;
      *) shift ;;
    esac
  done

  if [ "$full" = true ]; then
    git -C "$worktree_path" diff
  else
    git -C "$worktree_path" diff --stat
  fi
}

cmd_send() {
  local name="${2:-}"
  [ -z "$name" ] && die "Usage: dev send <session> <prompt> [--file <path>]"

  local match
  match=$(jq -r "keys[] | select(contains(\"$name\"))" "$PORT_REGISTRY" | head -1)
  [ -z "$match" ] && die "No session matching '$name'"

  shift 2 || true
  local prompt="" file=""
  while [[ $# -gt 0 ]]; do
    case "${1:-}" in
      --file) file="${2:-}"; shift 2 ;;
      --file=*) file="${1#*=}"; shift ;;
      *) prompt+="${prompt:+ }$1"; shift ;;
    esac
  done

  if [ -n "$file" ]; then
    [ -f "$file" ] || die "File not found: $file"
    prompt=$(cat "$file")
  fi

  [ -z "$prompt" ] && die "No prompt provided. Usage: dev send <session> <prompt>"

  tmux send-keys -t "$match:agent" -l "$prompt"
  tmux send-keys -t "$match:agent" Enter
  log "Sent to $match"
}

cmd_sync() {
  local name="${2:-}"
  [ -z "$name" ] && die "Usage: dev sync <session>"

  local match
  match=$(jq -r "keys[] | select(contains(\"$name\"))" "$PORT_REGISTRY" | head -1)
  [ -z "$match" ] && die "No session matching '$name'"

  local worktree_path project
  worktree_path=$(get_session_field "$match" "path")
  project=$(get_session_field "$match" "project")
  local bare_dir="$PROJECTS_DIR/$project"

  # Detect base branch (same logic as cmd_pr)
  local base_branch
  base_branch=$(cd "$bare_dir" && git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's|refs/remotes/origin/||' || echo "main")

  info "Syncing $match with origin/$base_branch..."
  cd "$worktree_path"
  git fetch origin

  # Stash any uncommitted changes so rebase can proceed
  local stashed=false
  if ! git diff --quiet 2>/dev/null || ! git diff --cached --quiet 2>/dev/null; then
    info "Stashing uncommitted changes..."
    git stash push -m "dev-cli sync auto-stash" --include-untracked
    stashed=true
  fi

  if git rebase "origin/$base_branch"; then
    log "Synced with origin/$base_branch"
  else
    warn "Rebase failed — aborting rebase and restoring previous state"
    git rebase --abort
    if [ "$stashed" = true ]; then
      git stash pop
      stashed=false
    fi
    die "Rebase conflict with origin/$base_branch. Resolve manually."
  fi

  # Restore stashed changes
  if [ "$stashed" = true ]; then
    info "Restoring stashed changes..."
    if ! git stash pop; then
      warn "Stash pop had conflicts — your changes are still in the stash. Run 'git stash pop' manually to resolve."
    fi
  fi
}

cmd_template() {
  local project="${2:-}"
  [ -z "$project" ] && die "Usage: dev template <project>"

  local editor="${EDITOR:-nano}"

  # Check for hook first (monorepo)
  local hook="$CONFIG_DIR/hooks/$project/setup.sh"
  if [ -f "$hook" ]; then
    info "Opening hook: $hook"
    $editor "$hook"
    return
  fi

  # Check for env template
  local template="$CONFIG_DIR/templates/${project}.env"
  if [ -f "$template" ]; then
    info "Opening template: $template"
    $editor "$template"
    return
  fi

  die "No hook or template found for project '$project'.\n  Expected: $hook\n       or: $template"
}

cmd_status() {
  local name="${2:-}"
  [ -z "$name" ] && die "Usage: dev status <session>"

  local match
  match=$(jq -r "keys[] | select(contains(\"$name\"))" "$PORT_REGISTRY" | head -1)
  [ -z "$match" ] && die "No session matching '$name'"

  local worktree_path project branch agents created frontend backend
  worktree_path=$(get_session_field "$match" "path")
  project=$(get_session_field "$match" "project")
  branch=$(get_session_field "$match" "branch")
  agents=$(get_session_agents "$match")
  created=$(get_session_field "$match" "created")
  frontend=$(get_session_field "$match" "ports.frontend")
  backend=$(get_session_field "$match" "ports.backend")

  local age
  age=$(human_readable_age "$created")

  echo ""
  echo -e "  ${BOLD}$match${NC}"
  echo ""

  # Tmux status
  if tmux has-session -t "$match" 2>/dev/null; then
    echo -e "  Tmux:     ${GREEN}alive${NC}"
  else
    echo -e "  Tmux:     ${RED}dead${NC}"
  fi

  echo -e "  Agent(s): $agents"
  echo -e "  Branch:   $branch"
  echo -e "  Age:      $age"
  echo -e "  Path:     $worktree_path"

  # Container status
  local cid
  cid=$(get_session_field "$match" "container_id")
  if [ -n "$cid" ]; then
    local cstatus
    cstatus=$(docker inspect "$cid" --format '{{.State.Status}}' 2>/dev/null || echo "not found")
    if [ "$cstatus" = "running" ]; then
      echo -e "  Container: ${GREEN}${cid:0:12} ($cstatus)${NC}"
    else
      echo -e "  Container: ${RED}${cid:0:12} ($cstatus)${NC}"
    fi
  fi
  echo ""

  # Git status
  if [ -d "$worktree_path" ]; then
    local dirty
    dirty=$(git -C "$worktree_path" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
    echo -e "  ${BOLD}Git${NC}"
    echo -e "  Dirty:    $dirty files"
    git -C "$worktree_path" diff --stat 2>/dev/null | sed 's/^/  /'

    # Ahead/behind
    local upstream
    upstream=$(git -C "$worktree_path" rev-parse --abbrev-ref '@{upstream}' 2>/dev/null || echo "")
    if [ -n "$upstream" ]; then
      local ahead behind
      ahead=$(git -C "$worktree_path" rev-list --count '@{upstream}..HEAD' 2>/dev/null || echo "0")
      behind=$(git -C "$worktree_path" rev-list --count 'HEAD..@{upstream}' 2>/dev/null || echo "0")
      echo -e "  Ahead:    $ahead  Behind: $behind"
    fi
    echo ""
  fi

  # Port checks
  echo -e "  ${BOLD}Ports${NC}"
  local has_ports=false
  for port_info in "Frontend:$frontend" "Backend:$backend"; do
    local label="${port_info%%:*}"
    local port="${port_info##*:}"
    if [ "$port" = "null" ] || [ -z "$port" ]; then
      continue
    fi
    has_ports=true
    if bash -c "echo >/dev/tcp/localhost/$port" 2>/dev/null; then
      echo -e "  $label:  :$port ${GREEN}listening${NC}"
    else
      echo -e "  $label:  :$port ${DIM}closed${NC}"
    fi
  done
  if [ "$has_ports" = false ]; then
    echo -e "  ${DIM}No ports allocated for this project.${NC}"
  fi
  echo ""
}

cmd_rename() {
  local old_name="${2:-}" new_name="${3:-}"
  [ -z "$old_name" ] && die "Usage: dev rename <session> <new-name>"

  # Partial match old name
  local match
  match=$(jq -r "keys[] | select(contains(\"$old_name\"))" "$PORT_REGISTRY" | head -1)
  [ -z "$match" ] && die "No session matching '$old_name'"

  # If no new name provided, prompt interactively
  if [ -z "$new_name" ]; then
    echo ""
    echo -e "  Current name: ${BOLD}$match${NC}"
    echo ""
    read -rp "  New name: " new_name
    [ -z "$new_name" ] && die "No name provided."
  fi

  # Validate new name (no spaces, reasonable chars)
  if [[ "$new_name" =~ [[:space:]] ]] || [[ ! "$new_name" =~ ^[a-zA-Z0-9._-]+$ ]]; then
    die "Invalid session name. Use only letters, numbers, hyphens, dots, and underscores."
  fi

  # Auto-prepend username if not already present
  if [[ "$new_name" != "${USER}-"* ]]; then
    new_name="${USER}-${new_name}"
  fi

  # Check new name doesn't already exist
  if jq -e ".[\"$new_name\"]" "$PORT_REGISTRY" &>/dev/null; then
    die "Session '$new_name' already exists."
  fi

  # Rename in port registry (atomic with flock)
  (
    flock -x 200
    local tmp
    tmp=$(mktemp)
    jq --arg old "$match" --arg new "$new_name" \
      '. as $orig | ($orig[$old]) as $data | del(.[$old]) | .[$new] = $data' \
      "$PORT_REGISTRY" > "$tmp"
    mv -f "$tmp" "$PORT_REGISTRY"
    fix_registry_perms
  ) 200>"${PORT_REGISTRY}.lock"

  # Rename tmux session
  if tmux has-session -t "$match" 2>/dev/null; then
    tmux rename-session -t "$match" "$new_name"
    log "Renamed tmux session"
  fi

  # Update task registry if it references this session
  if [ -f "$TASK_REGISTRY" ] && jq -e '.tasks[] | select(.session == "'"$match"'")' "$TASK_REGISTRY" &>/dev/null 2>&1; then
    local tmp
    tmp=$(mktemp)
    jq --arg old "$match" --arg new "$new_name" \
      '.tasks = [.tasks[] | if .session == $old then .session = $new else . end]' \
      "$TASK_REGISTRY" > "$tmp" && mv "$tmp" "$TASK_REGISTRY"
  fi

  log "Renamed '$match' → '$new_name'"
}

cmd_private() {
  local name="${2:-}" toggle="${3:-}"
  [ -z "$name" ] && die "Usage: dev private <session> [on|off]"

  # Partial match
  local match
  match=$(jq -r "keys[] | select(contains(\"$name\"))" "$PORT_REGISTRY" | head -1)
  [ -z "$match" ] && die "No session matching '$name'"

  # Determine new value
  local new_val
  if [ -z "$toggle" ]; then
    # Toggle current value
    local current
    current=$(jq -r ".\"$match\".private // false" "$PORT_REGISTRY")
    if [ "$current" = "true" ]; then
      new_val=false
    else
      new_val=true
    fi
  elif [ "$toggle" = "on" ]; then
    new_val=true
  elif [ "$toggle" = "off" ]; then
    new_val=false
  else
    die "Usage: dev private <session> [on|off]"
  fi

  # Update registry
  (
    flock -x 200
    local tmp
    tmp=$(mktemp)
    jq --arg name "$match" --argjson val "$new_val" \
      '.[$name].private = $val' "$PORT_REGISTRY" > "$tmp"
    mv -f "$tmp" "$PORT_REGISTRY"
    fix_registry_perms
  ) 200>"${PORT_REGISTRY}.lock"

  if [ "$new_val" = "true" ]; then
    log "'$match' is now private (hidden from other users)"
  else
    log "'$match' is now public (visible to all users)"
  fi
}

cmd_gc() {
  ensure_dirs
  local global=false
  if [[ "${1:-}" == "--global" ]]; then
    global=true
  fi

  local sessions
  if $global; then
    sessions=$(jq -r --arg user "$USER" '[to_entries[] | select(.value.private != true or .value.owner == $user or .value.owner == null)] | .[].key' "$PORT_REGISTRY" 2>/dev/null)
  else
    sessions=$(jq -r --arg user "$USER" 'to_entries[] | select(.value.owner == $user) | .key' "$PORT_REGISTRY" 2>/dev/null)
  fi

  if [ -z "$sessions" ]; then
    echo "No sessions to clean up."
    return 0
  fi

  # Find dead sessions (tmux gone)
  local dead=()
  while IFS= read -r name; do
    if ! tmux has-session -t "$name" 2>/dev/null; then
      dead+=("$name")
    fi
  done <<< "$sessions"

  if [ ${#dead[@]} -eq 0 ]; then
    log "No dead sessions found. All clean!"
    return 0
  fi

  echo ""
  echo -e "  ${BOLD}Dead sessions:${NC}"
  echo ""
  for name in "${dead[@]}"; do
    local created age branch
    created=$(get_session_field "$name" "created")
    age=$(human_readable_age "$created")
    branch=$(get_session_field "$name" "branch")
    echo -e "  ${RED}●${NC} $name  ${DIM}($branch, $age old)${NC}"
  done

  echo ""
  echo -ne "  ${YELLOW}Remove ${#dead[@]} dead session(s)? [y/N]:${NC} "
  read -r confirm
  [ "$confirm" = "y" ] || [ "$confirm" = "Y" ] || { echo "  Cancelled."; return 0; }

  for name in "${dead[@]}"; do
    info "Cleaning up $name..."
    local worktree_path project
    worktree_path=$(get_session_field "$name" "path")
    project=$(get_session_field "$name" "project")
    local bare_dir="$PROJECTS_DIR/$project"

    # Stop devcontainer if present
    local gc_container_id
    gc_container_id=$(get_session_field "$name" "container_id")
    if [ -n "$gc_container_id" ]; then
      stop_devcontainer "$name" "$gc_container_id"
    fi

    # Remove worktree
    if [ -d "$bare_dir" ]; then
      cd "$bare_dir"
      if [ -d "$worktree_path" ]; then
        git worktree remove "$worktree_path" --force 2>/dev/null || {
          rm -rf "$worktree_path"
        }
      fi
      git worktree prune 2>/dev/null || true
    elif [ -d "$worktree_path" ]; then
      rm -rf "$worktree_path"
    fi

    # Unregister
    unregister_session "$name"
    log "Removed $name"
  done

  echo ""
  log "Garbage collection complete. Removed ${#dead[@]} session(s)."
}

cmd_stats() {
  local session_count=0
  if [[ -f "$PORT_REGISTRY" ]]; then
    session_count=$(jq 'length' "$PORT_REGISTRY" 2>/dev/null || echo 0)
  fi

  if is_compact; then
    # Text-based stats for narrow terminals
    echo ""
    echo -e "  ${BOLD}dev stats${NC} — VPS Overview"
    echo ""

    # CPU usage from /proc/stat
    local cpu_line idle total cpu_pct
    cpu_line=$(head -1 /proc/stat 2>/dev/null)
    if [ -n "$cpu_line" ]; then
      total=0
      idle=0
      local i=0
      for val in $(echo "$cpu_line" | awk '{for(i=2;i<=NF;i++) print $i}'); do
        total=$((total + val))
        [ "$i" -eq 3 ] && idle=$val
        i=$((i + 1))
      done
      if [ "$total" -gt 0 ]; then
        cpu_pct=$(( (total - idle) * 100 / total ))
      else
        cpu_pct=0
      fi
    else
      cpu_pct="?"
    fi

    # Memory from free
    local mem_info mem_used mem_total mem_pct
    mem_info=$(free -m 2>/dev/null | awk '/^Mem:/ {print $3, $2}')
    if [ -n "$mem_info" ]; then
      read -r mem_used mem_total <<< "$mem_info"
      mem_pct=$(( mem_used * 100 / mem_total ))
      # Format as G if >= 1024
      if [ "$mem_used" -ge 1024 ]; then
        mem_used="$(awk "BEGIN{printf \"%.1f\", $mem_used/1024}")G"
      else
        mem_used="${mem_used}M"
      fi
      if [ "$mem_total" -ge 1024 ]; then
        mem_total="$(awk "BEGIN{printf \"%.1f\", $mem_total/1024}")G"
      else
        mem_total="${mem_total}M"
      fi
    else
      mem_used="?" mem_total="?" mem_pct="?"
    fi

    # Disk usage
    local disk_pct
    disk_pct=$(df / 2>/dev/null | awk 'NR==2 {gsub(/%/,"",$5); print $5}')
    disk_pct="${disk_pct:-?}"

    # Load averages
    local load_avg
    load_avg=$(uptime | awk -F'load average: ' '{print $2}')

    # Uptime
    local up
    up=$(uptime -p 2>/dev/null | sed 's/^up //' || uptime | awk -F'up ' '{print $2}' | awk -F',' '{print $1}')

    echo -e "  ${CYAN}CPU:${NC} ${cpu_pct}%  ${CYAN}MEM:${NC} ${mem_used}/${mem_total} (${mem_pct}%)  ${CYAN}DISK:${NC} ${disk_pct}%"
    echo -e "  ${CYAN}Load:${NC} $load_avg"
    echo -e "  ${CYAN}Sessions:${NC} $session_count/$MAX_SLOTS  ${CYAN}Uptime:${NC} $up"
    echo ""
  else
    # Wide terminal: launch btop
    echo ""
    echo -e "  ${BOLD}dev stats${NC} — VPS Resource Monitor"
    echo -e "  ${CYAN}Active sessions:${NC} $session_count  ${DIM}|${NC}  ${CYAN}Load:${NC} $(uptime | awk -F'load average: ' '{print $2}')"
    echo ""
    exec btop
  fi
}

cmd_doctor() {
  echo ""
  echo -e "  ${BOLD}dev doctor${NC} — System Health Check"
  echo ""

  local ok=0 warn_count=0 fail=0

  # Check required tools
  echo -e "  ${BOLD}Tools${NC}"
  for tool in jq tmux git gh lazygit delta docker tailscale; do
    if command -v "$tool" &>/dev/null; then
      echo -e "  ${GREEN}✓${NC} $tool $(command -v "$tool")"
      ok=$((ok + 1))
    else
      echo -e "  ${RED}✗${NC} $tool — NOT FOUND"
      fail=$((fail + 1))
    fi
  done
  # Optional: devcontainer CLI (only needed for --container mode)
  if command -v devcontainer &>/dev/null; then
    echo -e "  ${GREEN}✓${NC} devcontainer $(command -v devcontainer)"
    ok=$((ok + 1))
  else
    echo -e "  ${YELLOW}○${NC} devcontainer — not installed (optional, needed for: dev new --container)"
    warn_count=$((warn_count + 1))
  fi
  echo ""

  # Docker daemon
  echo -e "  ${BOLD}Services${NC}"
  if command -v docker &>/dev/null; then
    if docker info &>/dev/null; then
      echo -e "  ${GREEN}✓${NC} Docker daemon running"
      ok=$((ok + 1))
    else
      echo -e "  ${RED}✗${NC} Docker installed but daemon not running"
      fail=$((fail + 1))
    fi
  fi
  echo ""

  # Auth checks
  echo -e "  ${BOLD}Auth${NC}"

  # GitHub CLI
  if command -v gh &>/dev/null; then
    if gh auth status &>/dev/null; then
      local gh_user
      gh_user=$(gh api user -q '.login' 2>/dev/null || echo "authenticated")
      echo -e "  ${GREEN}✓${NC} GitHub — $gh_user"
      ok=$((ok + 1))
    else
      echo -e "  ${RED}✗${NC} GitHub — not authenticated (run: gh auth login)"
      fail=$((fail + 1))
    fi
  else
    echo -e "  ${RED}✗${NC} GitHub — gh not installed"
    fail=$((fail + 1))
  fi

  # Claude Code
  if command -v claude &>/dev/null; then
    local has_claude_auth=false
    if [ -f "$SECRETS_FILE" ]; then
      grep -qE '^(CLAUDE_CODE_OAUTH_TOKEN|ANTHROPIC_API_KEY)=' "$SECRETS_FILE" 2>/dev/null && has_claude_auth=true
    fi
    if [ "$has_claude_auth" = true ]; then
      echo -e "  ${GREEN}✓${NC} Claude Code — authenticated (via secrets.env)"
      ok=$((ok + 1))
    else
      echo -e "  ${YELLOW}○${NC} Claude Code — no auth in secrets.env (add CLAUDE_CODE_OAUTH_TOKEN or ANTHROPIC_API_KEY)"
      warn_count=$((warn_count + 1))
    fi
  else
    echo -e "  ${YELLOW}○${NC} Claude Code — not installed"
    warn_count=$((warn_count + 1))
  fi

  # Codex
  if command -v codex &>/dev/null; then
    if [ -n "${OPENAI_API_KEY:-}" ] || [ -f "$HOME/.codex/auth.json" ]; then
      echo -e "  ${GREEN}✓${NC} Codex — authenticated"
      ok=$((ok + 1))
    else
      echo -e "  ${YELLOW}○${NC} Codex — not authenticated (run: codex login)"
      warn_count=$((warn_count + 1))
    fi
  else
    echo -e "  ${YELLOW}○${NC} Codex — not installed"
    warn_count=$((warn_count + 1))
  fi
  echo ""

  # Secrets file
  echo -e "  ${BOLD}Config${NC}"
  if [ -f "$CONFIG_DIR/secrets.env" ]; then
    local perms
    perms=$(stat -c '%a' "$CONFIG_DIR/secrets.env" 2>/dev/null || stat -f '%Lp' "$CONFIG_DIR/secrets.env" 2>/dev/null || echo "unknown")
    if [ "$perms" = "600" ]; then
      echo -e "  ${GREEN}✓${NC} secrets.env (perms: $perms)"
      ok=$((ok + 1))
    else
      echo -e "  ${YELLOW}!${NC} secrets.env (perms: $perms — should be 600)"
      warn_count=$((warn_count + 1))
    fi
  else
    echo -e "  ${YELLOW}○${NC} secrets.env — not found"
    warn_count=$((warn_count + 1))
  fi

  # Port registry
  if [ -f "$PORT_REGISTRY" ]; then
    if jq empty "$PORT_REGISTRY" 2>/dev/null; then
      echo -e "  ${GREEN}✓${NC} ports.json — valid JSON"
      ok=$((ok + 1))
    else
      echo -e "  ${RED}✗${NC} ports.json — invalid JSON!"
      fail=$((fail + 1))
    fi
  else
    echo -e "  ${YELLOW}○${NC} ports.json — not found"
    warn_count=$((warn_count + 1))
  fi
  echo ""

  # Session/tmux consistency
  echo -e "  ${BOLD}Sessions${NC}"
  local sessions
  sessions=$(jq -r 'keys[]' "$PORT_REGISTRY" 2>/dev/null)
  if [ -n "$sessions" ]; then
    local total=0 alive=0 dead=0
    while IFS= read -r name; do
      total=$((total + 1))
      if tmux has-session -t "$name" 2>/dev/null; then
        alive=$((alive + 1))
      else
        dead=$((dead + 1))
      fi
    done <<< "$sessions"
    echo -e "  Total: $total  Alive: ${GREEN}$alive${NC}  Dead: ${RED}$dead${NC}"
    if [ "$dead" -gt 0 ]; then
      echo -e "  ${YELLOW}!${NC} Run 'dev gc' to clean up dead sessions"
      warn_count=$((warn_count + 1))
    fi
  else
    echo -e "  ${DIM}No sessions registered${NC}"
  fi
  echo ""

  # --- Security checks (multi-user mode only) ---
  if type has_user_registry &>/dev/null && has_user_registry; then
      echo ""
      echo -e "  ${BOLD}Security:${NC}"

      if is_user_registered "$USER"; then
          local role status
          role=$(get_user_role "$USER")
          status=$(get_user_status "$USER")
          echo -e "  ${GREEN}✓${NC} User registration: $USER (role: $role, status: $status)"
          ok=$((ok + 1))
      else
          echo -e "  ${RED}✗${NC} User registration: $USER not in registry"
          fail=$((fail + 1))
      fi

      if command -v authbind &>/dev/null; then
          echo -e "  ${GREEN}✓${NC} Port isolation: authbind installed"
          ok=$((ok + 1))
      else
          echo -e "  ${YELLOW}⚠${NC} Port isolation: authbind not installed"
          warn_count=$((warn_count + 1))
      fi

      if [[ -f /usr/local/bin/validate-tailscale-identity ]]; then
          echo -e "  ${GREEN}✓${NC} SSH binding: identity validation installed"
          ok=$((ok + 1))
      else
          echo -e "  ${YELLOW}⚠${NC} SSH binding: not configured"
          warn_count=$((warn_count + 1))
      fi

      local current max
      current=$(count_user_sessions "$USER")
      max=$(get_user_max_sessions "$USER")
      echo -e "  ${GREEN}✓${NC} Session limit: $current/$max sessions"
  fi

  # Summary
  echo ""
  echo -e "  ─────────────────────────────────"
  echo -e "  ${GREEN}$ok passed${NC}  ${YELLOW}$warn_count warnings${NC}  ${RED}$fail failed${NC}"
  echo ""
}

cmd_restart() {
  local name="${2:-}"
  [ -z "$name" ] && die "Usage: dev restart <session>"

  local match
  match=$(jq -r "keys[] | select(contains(\"$name\"))" "$PORT_REGISTRY" | head -1)
  [ -z "$match" ] && die "No session matching '$name'"

  local worktree_path agents
  worktree_path=$(get_session_field "$match" "path")
  agents=$(get_session_agents "$match")

  info "Restarting session '$match'..."

  # Kill existing tmux session
  tmux kill-session -t "$match" 2>/dev/null || true

  # Check if session uses a devcontainer
  local container_id
  container_id=$(get_session_field "$match" "container_id")

  # Source secrets — skip in container mode (secrets passed via --remote-env)
  local env_prefix=""
  if [ -z "$container_id" ]; then
    env_prefix=$(build_env_prefix)
  fi

  if [[ "$agents" == *claude* ]]; then
    validate_claude_auth || true
  fi

  # Parse agents list and determine primary agent
  local primary_agent
  primary_agent=$(echo "$agents" | cut -d',' -f1)

  # Read port info from registry
  local slot frontend backend supa_api supa_db supa_studio
  slot=$(get_session_field "$match" "slot")
  frontend=$(get_session_field "$match" "ports.frontend")
  backend=$(get_session_field "$match" "ports.backend")
  supa_api=$(get_session_field "$match" "ports.supa_api")
  supa_db=$(get_session_field "$match" "ports.supa_db")
  supa_studio=$(get_session_field "$match" "ports.supa_studio")

  # Resolve project name, run command, and yolo mode
  local project
  project=$(get_session_field "$match" "project")
  local run_cmd="" yolo=false
  if [ -n "$project" ] && [ -f "$CONFIG_DIR/projects/${project}.json" ]; then
    run_cmd=$(jq -r '.run_cmd // empty' "$CONFIG_DIR/projects/${project}.json")
    local config_yolo
    config_yolo=$(jq -r '.skip_permissions // false' "$CONFIG_DIR/projects/${project}.json")
    [ "$config_yolo" = "true" ] && yolo=true
  fi

  local claude_flags=""
  if [ "$yolo" = true ]; then
    claude_flags=" --dangerously-skip-permissions"
    [ -z "$container_id" ] && ensure_claude_skip_prompt
  fi

  # Trust only needed on host — container handles it in postCreateCommand
  [ -z "$container_id" ] && ensure_claude_trust "$worktree_path"
  if [ -n "$container_id" ]; then
    # Ensure container is running, restart it if needed
    if ! docker inspect "$container_id" --format '{{.State.Status}}' 2>/dev/null | grep -q "running"; then
      info "Restarting devcontainer..."
      # Clean up the old stopped container first to avoid accumulating stale containers
      stop_devcontainer "$match" "$container_id"
      local container_env_flag
      container_env_flag=$(get_session_field "$match" "container_env")
      container_id=$(start_devcontainer "$worktree_path" "$match" "${container_env_flag:-false}")
      # Update registry with new container ID
      (
        flock -x 200
        local tmp
        tmp=$(mktemp)
        jq --arg name "$match" --arg cid "$container_id" \
           '.[$name].container_id = $cid' "$PORT_REGISTRY" > "$tmp"
        mv -f "$tmp" "$PORT_REGISTRY"
        fix_registry_perms
      ) 200>"${PORT_REGISTRY}.lock"
    fi
  fi

  # Restore headless mode if the session was created with it
  local session_headless prompt_arg=""
  session_headless=$(get_session_field "$match" "headless")
  if [ "$session_headless" = "true" ]; then
    local stored_prompt
    stored_prompt=$(get_session_field "$match" "headless_prompt")
    if [ -n "$stored_prompt" ] && [ "$stored_prompt" != "null" ]; then
      if [ -n "$container_id" ]; then
        printf '%s' "$stored_prompt" > "$worktree_path/.dev-prompt"
        local container_workspace="/workspaces/$(basename "$worktree_path")"
        prompt_arg=" < $container_workspace/.dev-prompt"
      else
        local escaped_prompt="${stored_prompt//\\/\\\\}"
        escaped_prompt="${escaped_prompt//\$/\\\$}"
        escaped_prompt="${escaped_prompt//\`/\\\`}"
        escaped_prompt="${escaped_prompt//\"/\\\"}"
        prompt_arg=" \"${escaped_prompt}\""
      fi
      info "Restarting in headless mode with stored prompt"
    else
      warn "Headless session but no stored prompt — restarting in interactive mode"
      session_headless="false"
    fi
  fi

  # Recreate tmux session with primary agent
  local agent_cmd
  agent_cmd=$(build_agent_cmd "$primary_agent" "$worktree_path" "$container_id" "$claude_flags" "$prompt_arg" "$session_headless")

  local ip
  ip=$(get_ip)
  create_tmux_windows "$match" "$project" "$worktree_path" "$env_prefix" "$agent_cmd" "$run_cmd" "$frontend" "$backend" "$ip" "$container_id"

  # Create additional agent windows for dual-agent mode
  local IFS_BAK="$IFS"
  IFS=',' read -ra agent_list <<< "$agents"
  IFS="$IFS_BAK"
  if [ ${#agent_list[@]} -gt 1 ]; then
    for extra_agent in "${agent_list[@]:1}"; do
      local extra_cmd
      extra_cmd=$(build_agent_cmd "$extra_agent" "$worktree_path" "$container_id" "$claude_flags") || { warn "Unknown agent '$extra_agent', skipping"; continue; }
      tmux new-window -t "$match" -n "agent-${extra_agent}" "${env_prefix}${extra_cmd}"
    done
  fi

  [ "$frontend" != "null" ] && [ -n "$frontend" ] && tmux set-environment -t "$match" DEV_FRONTEND_PORT "$frontend"
  [ "$backend" != "null" ] && [ -n "$backend" ] && tmux set-environment -t "$match" DEV_BACKEND_PORT "$backend"
  [ "$supa_api" != "null" ] && [ -n "$supa_api" ] && tmux set-environment -t "$match" DEV_SUPA_API_PORT "$supa_api"
  [ "$supa_db" != "null" ] && [ -n "$supa_db" ] && tmux set-environment -t "$match" DEV_SUPA_DB_PORT "$supa_db"
  [ "$supa_studio" != "null" ] && [ -n "$supa_studio" ] && tmux set-environment -t "$match" DEV_SUPA_STUDIO_PORT "$supa_studio"
  tmux set-environment -t "$match" DEV_SLOT "$slot"

  log "Session '$match' restarted with $agents"
}

cmd_yolo() {
  local name="${2:-}"
  [ -z "$name" ] && die "Usage: dev yolo <session>"

  local match
  match=$(jq -r "keys[] | select(contains(\"$name\"))" "$PORT_REGISTRY" | head -1)
  [ -z "$match" ] && die "No session matching '$name'"

  # Verify the tmux session is alive
  tmux has-session -t "$match" 2>/dev/null || die "No live tmux session for '$match' (run 'dev gc' to clean up)"

  # Verify agent is claude
  local agents primary_agent
  agents=$(get_session_agents "$match")
  primary_agent=$(echo "$agents" | cut -d',' -f1)
  [ "$primary_agent" != "claude" ] && die "Yolo mode only supported for Claude sessions (agent: $primary_agent)"

  local worktree_path container_id
  worktree_path=$(get_session_field "$match" "path")
  container_id=$(get_session_field "$match" "container_id")

  info "Enabling yolo mode for session '$match'..."

  validate_claude_auth || true

  # Suppress the skip-permissions confirmation dialog
  [ -z "$container_id" ] && ensure_claude_skip_prompt

  # Pre-trust the worktree so Claude doesn't prompt on relaunch
  [ -z "$container_id" ] && ensure_claude_trust "$worktree_path"

  # Build env prefix for secrets
  local env_prefix=""
  [ -z "$container_id" ] && env_prefix=$(build_env_prefix)

  # Build the new agent command with yolo + continue to resume conversation
  # Pass "continue" as the prompt so Claude immediately resumes work after restarting
  local claude_flags=" --dangerously-skip-permissions --continue"
  local agent_cmd
  agent_cmd=$(build_agent_cmd "claude" "$worktree_path" "$container_id" "$claude_flags" " \"continue\"")

  # Find the agent window — check both "agent" (original name) and any window
  # whose name starts with "agent" (tmux automatic-rename may have changed it)
  local agent_win=""
  agent_win=$(tmux list-windows -t "$match" -F '#I:#W' 2>/dev/null | grep -E ':agent(-claude)?$' | head -1 | cut -d: -f1)

  if [ -n "$agent_win" ]; then
    # Gracefully signal Claude to exit so it can save conversation state,
    # then wait briefly before hard-killing and respawning
    tmux send-keys -t "$match:${agent_win}" C-c C-c 2>/dev/null || true
    sleep 2
    tmux respawn-window -t "$match:${agent_win}" -k "${env_prefix}${agent_cmd}"
  else
    tmux new-window -t "$match" -n "agent" "${env_prefix}${agent_cmd}"
  fi

  log "Session '$match' is now in yolo mode — claude resumed with --dangerously-skip-permissions"
}

cmd_img() {
  local subcmd="${2:-ls}"
  local IMAGES_DIR="$HOME/images"
  mkdir -p "$IMAGES_DIR"

  case "$subcmd" in
    ls|list)
      # List recent images
      local count="${3:-10}"
      echo ""
      echo -e "  ${BOLD}Recent images${NC} ($IMAGES_DIR)"
      echo ""
      local files
      files=$(ls -1t "$IMAGES_DIR" 2>/dev/null | head -"$count")
      if [ -z "$files" ]; then
        echo -e "  ${DIM}No images yet. Upload with: vpsimg <file> (from Mac)${NC}"
      else
        while IFS= read -r f; do
          local size
          size=$(du -h "$IMAGES_DIR/$f" | cut -f1)
          local mtime
          mtime=$(stat -c '%y' "$IMAGES_DIR/$f" 2>/dev/null | cut -d'.' -f1)
          printf "  ${CYAN}%-40s${NC} %6s  %s\n" "$f" "$size" "$mtime"
        done <<< "$files"
      fi
      echo ""
      echo -e "  ${DIM}Full path: $IMAGES_DIR/<filename>${NC}"
      echo ""
      ;;

    cp|copy)
      # Copy an image into a session's worktree
      local session="${3:-}" file="${4:-}"
      [ -z "$session" ] || [ -z "$file" ] && die "Usage: dev img cp <session> <filename>"

      local match
      match=$(jq -r "keys[] | select(contains(\"$session\"))" "$PORT_REGISTRY" | head -1)
      [ -z "$match" ] && die "No session matching '$session'"

      local worktree_path
      worktree_path=$(get_session_field "$match" "path")

      # Check images dir and worktree
      local src="$IMAGES_DIR/$file"
      [ -f "$src" ] || die "Image not found: $src"

      cp "$src" "$worktree_path/$file"
      log "Copied to $worktree_path/$file"
      echo -e "  ${DIM}Use in Claude Code: ./$file${NC}"
      ;;

    grab)
      # Download image from URL
      local url="${3:-}"
      [ -z "$url" ] && die "Usage: dev img grab <url>"

      local filename
      filename=$(basename "$url" | sed 's/?.*//')
      # Add timestamp if filename is generic
      if [[ "$filename" == "image" ]] || [[ "$filename" == "download" ]]; then
        filename="img-$(date +%s).png"
      fi

      info "Downloading $url..."
      wget -q "$url" -O "$IMAGES_DIR/$filename" || curl -sL "$url" -o "$IMAGES_DIR/$filename"
      log "Saved to $IMAGES_DIR/$filename"
      echo -e "  ${DIM}Full path: $IMAGES_DIR/$filename${NC}"
      ;;

    path)
      # Print full path for a recent image (for easy pasting)
      local file="${3:-}"
      if [ -z "$file" ]; then
        # Show most recent
        file=$(ls -1t "$IMAGES_DIR" 2>/dev/null | head -1)
        [ -z "$file" ] && die "No images found"
      fi
      [ -f "$IMAGES_DIR/$file" ] || die "Image not found: $IMAGES_DIR/$file"
      echo "$IMAGES_DIR/$file"
      ;;

    clean)
      # Remove images older than N days (default 7)
      local days="${3:-7}"
      local count
      count=$(find "$IMAGES_DIR" -type f -mtime +"$days" | wc -l)
      if [ "$count" -eq 0 ]; then
        echo "No images older than $days days."
        return 0
      fi
      warn "Delete $count images older than $days days? [y/N]"
      read -rp "" confirm
      [ "$confirm" = "y" ] || [ "$confirm" = "Y" ] || { echo "Cancelled."; return 0; }
      find "$IMAGES_DIR" -type f -mtime +"$days" -delete
      log "Cleaned $count old images"
      ;;

    *)
      echo ""
      echo "  dev img — Manage images for AI agents"
      echo ""
      echo "  dev img ls [count]                 List recent images (default 10)"
      echo "  dev img cp <session> <filename>    Copy image into a session's worktree"
      echo "  dev img grab <url>                 Download image from URL"
      echo "  dev img path [filename]            Print full path (latest if no arg)"
      echo "  dev img clean [days]               Remove images older than N days"
      echo ""
      echo "  Upload from Mac:"
      echo "    vpsimg ~/Desktop/screenshot.png"
      echo "    vpsimg ~/Desktop/screenshot.png klyra-feat-auth  # direct to worktree"
      echo ""
      ;;
  esac
}

cmd_projects() {
  local projects_dir="$CONFIG_DIR/projects"
  if [ ! -d "$projects_dir" ] || [ -z "$(ls -A "$projects_dir" 2>/dev/null)" ]; then
    echo -e "${DIM}No projects configured. Run 'dev setup' to set up a project.${NC}"
    return 0
  fi

  echo ""
  printf "  ${BOLD}%-20s %-10s %-10s %-10s %-10s${NC}\n" \
    "PROJECT" "FRONTEND" "BACKEND" "SUPABASE" "PKG MGR"
  printf "  ${DIM}%-20s %-10s %-10s %-10s %-10s${NC}\n" \
    "────────────────────" "──────────" "──────────" "──────────" "──────────"

  for config in "$projects_dir"/*.json; do
    local name has_next has_back has_supa pkg
    name=$(jq -r '.name' "$config")
    has_next=$(jq -r '.has_nextjs' "$config")
    has_back=$(jq -r '.has_backend' "$config")
    has_supa=$(jq -r '.has_supabase' "$config")
    pkg=$(jq -r '.pkg_manager' "$config")

    printf "  %-20s %-10s %-10s %-10s %-10s\n" \
      "$name" \
      "$([[ "$has_next" =~ ^[Yy] ]] && echo "next.js" || echo "-")" \
      "$([[ "$has_back" =~ ^[Yy] ]] && echo "express" || echo "-")" \
      "$([[ "$has_supa" =~ ^[Yy] ]] && echo "yes" || echo "-")" \
      "$pkg"
  done
  echo ""
}

cmd_update() {
  local GITHUB_REPO="theholdinco/dev-cli"
  local BRANCH="${1:-main}"
  
  if ! command -v gh &>/dev/null; then
    die "GitHub CLI (gh) is required for update. Install: https://cli.github.com"
  fi

  local tmp_dir
  tmp_dir=$(mktemp -d)
  # shellcheck disable=SC2064
  trap "rm -rf '$tmp_dir'" EXIT

  info "Downloading latest dev-cli from GitHub (${BRANCH})..."
  if ! gh api "repos/${GITHUB_REPO}/tarball/${BRANCH}" > "$tmp_dir/dev-cli.tar.gz" 2>/dev/null; then
    rm -rf "$tmp_dir"
    trap - EXIT
    die "Failed to download from GitHub. Check 'gh auth status'."
  fi

  info "Extracting..."
  tar -xzf "$tmp_dir/dev-cli.tar.gz" -C "$tmp_dir" --strip-components=1

  if [ ! -f "$tmp_dir/install.sh" ]; then
    rm -rf "$tmp_dir"
    trap - EXIT
    die "Invalid archive — install.sh not found"
  fi

  info "Installing..."
  bash "$tmp_dir/install.sh" <<< "N"

  rm -rf "$tmp_dir"
  trap - EXIT

  log "Updated to latest version from GitHub (${BRANCH})"
}

cmd_config() {
  local subcmd="${2:-}"

  case "$subcmd" in
    show)
      echo ""
      echo -e "  ${BOLD}Current Configuration${NC}"
      echo ""
      echo -e "  ${CYAN}Global config:${NC} $GLOBAL_CONFIG"
      echo ""
      if [ -f "$GLOBAL_CONFIG" ]; then
        jq '.' "$GLOBAL_CONFIG" | sed 's/^/  /'
      else
        echo "$DEFAULT_CONFIG" | jq '.' | sed 's/^/  /'
      fi
      echo ""
      ;;

    reset)
      echo "$DEFAULT_CONFIG" > "$GLOBAL_CONFIG"
      log "Configuration reset to defaults"
      ;;

    project)
      local pname="${3:-}"
      [ -z "$pname" ] && die "Usage: dev config project <name> [--json]"
      local pconfig="$CONFIG_DIR/projects/${pname}.json"

      if [ "${4:-}" = "--json" ]; then
        if [ ! -f "$pconfig" ]; then
          echo '{}' > "$pconfig"
        fi
        ${EDITOR:-vi} "$pconfig"
        log "Project config updated for '$pname'"
      else
        echo ""
        echo -e "  ${BOLD}Configure project: $pname${NC}"
        echo ""

        local cur_pkg="" cur_run="" cur_agent="" cur_yolo=""
        if [ -f "$pconfig" ]; then
          cur_pkg=$(jq -r '.pkg_manager // empty' "$pconfig")
          cur_run=$(jq -r '.run_cmd // empty' "$pconfig")
          cur_agent=$(jq -r '.default_agent // empty' "$pconfig")
          cur_yolo=$(jq -r '.skip_permissions // false' "$pconfig")
        fi

        echo -e "  Package manager:"
        echo "    1) npm"
        echo "    2) pnpm"
        echo "    3) yarn"
        local default_pkg_num=1
        case "${cur_pkg:-npm}" in
          pnpm) default_pkg_num=2 ;;
          yarn) default_pkg_num=3 ;;
        esac
        read -rp "  Select [$default_pkg_num]: " pkg_choice
        local pkg_mgr
        case "${pkg_choice:-$default_pkg_num}" in
          2) pkg_mgr="pnpm" ;;
          3) pkg_mgr="yarn" ;;
          *) pkg_mgr="npm" ;;
        esac

        echo ""
        echo -e "  Default agent:"
        echo "    1) claude"
        echo "    2) codex"
        echo "    3) none"
        local default_agent_num=1
        case "${cur_agent:-claude}" in
          codex) default_agent_num=2 ;;
          none) default_agent_num=3 ;;
        esac
        read -rp "  Select [$default_agent_num]: " agent_choice
        local def_agent
        case "${agent_choice:-$default_agent_num}" in
          2) def_agent="codex" ;;
          3) def_agent="none" ;;
          *) def_agent="claude" ;;
        esac

        echo ""
        local default_yolo="n"
        [ "${cur_yolo:-false}" = "true" ] && default_yolo="y"
        read -rp "  Skip permissions / yolo mode (y/n) [$default_yolo]: " yolo_choice
        local skip_perms=false
        case "${yolo_choice:-$default_yolo}" in
          y|Y|yes) skip_perms=true ;;
        esac

        echo ""
        read -rp "  Dev server command [${cur_run:-none}]: " new_run
        new_run="${new_run:-$cur_run}"

        echo ""
        local cur_container="" cur_container_env=""
        if [ -f "$pconfig" ]; then
          cur_container=$(jq -r '.use_container // false' "$pconfig")
          cur_container_env=$(jq -r '.container_env // false' "$pconfig")
        fi
        local default_container="n"
        [ "${cur_container:-false}" = "true" ] && default_container="y"
        read -rp "  Use devcontainer for isolation (y/n) [$default_container]: " container_choice
        local use_container=false
        case "${container_choice:-$default_container}" in
          y|Y|yes) use_container=true ;;
        esac

        local use_container_env=false new_claude_model="" new_claude_effort=""
        if [ "$use_container" = true ]; then
          local default_container_env="n"
          [ "${cur_container_env:-false}" = "true" ] && default_container_env="y"
          read -rp "  Pass secrets.env into container (y/n) [$default_container_env]: " container_env_choice
          case "${container_env_choice:-$default_container_env}" in
            y|Y|yes) use_container_env=true ;;
          esac

          local cur_claude_model="" cur_claude_effort=""
          if [ -f "$pconfig" ]; then
            cur_claude_model=$(jq -r '.claude_model // empty' "$pconfig" 2>/dev/null)
            cur_claude_effort=$(jq -r '.claude_effort // empty' "$pconfig" 2>/dev/null)
          fi
          read -rp "  Claude model (opus/sonnet/haiku) [${cur_claude_model:-opus}]: " new_claude_model
          new_claude_model="${new_claude_model:-${cur_claude_model:-opus}}"
          read -rp "  Claude effort level (high/medium/low) [${cur_claude_effort:-high}]: " new_claude_effort
          new_claude_effort="${new_claude_effort:-${cur_claude_effort:-high}}"
        fi

        echo ""
        echo -e "  Tmux window layout (leave blank to use global config):"
        read -rp "  Custom window names (comma-separated, e.g. agent,shell,server,logs) []: " win_input

        local tmp
        tmp=$(mktemp)
        local base='{}'
        [ -f "$pconfig" ] && base=$(cat "$pconfig")

        echo "$base" | jq \
          --arg pkg "$pkg_mgr" \
          --arg agent "$def_agent" \
          --arg run "$new_run" \
          --argjson yolo "$skip_perms" \
          --argjson use_container "$use_container" \
          --argjson container_env "$use_container_env" \
          --arg claude_model "$new_claude_model" \
          --arg claude_effort "$new_claude_effort" \
          '.pkg_manager = $pkg | .default_agent = $agent | .skip_permissions = $yolo | .use_container = $use_container | .container_env = $container_env | (if $run != "" then .run_cmd = $run else del(.run_cmd) end) | (if $claude_model != "" then .claude_model = $claude_model else del(.claude_model) end) | (if $claude_effort != "" then .claude_effort = $claude_effort else del(.claude_effort) end)' > "$tmp"

        if [ -n "$win_input" ]; then
          local windows_json="["
          local first=true
          IFS=',' read -ra WIN_NAMES <<< "$win_input"
          for wn in "${WIN_NAMES[@]}"; do
            wn=$(echo "$wn" | xargs)
            if [ "$first" = true ]; then first=false; else windows_json+=","; fi
            if [ "$wn" = "agent" ]; then
              windows_json+="{\"name\":\"agent\",\"command\":null}"
            elif [ "$wn" = "server" ]; then
              windows_json+="{\"name\":\"server\",\"command\":null}"
            elif [ "$wn" = "shell" ]; then
              windows_json+="{\"name\":\"shell\",\"command\":\"bash\"}"
            else
              windows_json+="{\"name\":\"$wn\",\"command\":\"bash\"}"
            fi
          done
          windows_json+="]"
          local tmp2
          tmp2=$(mktemp)
          jq --argjson wins "$windows_json" '.tmux.windows = $wins' "$tmp" > "$tmp2"
          mv "$tmp2" "$tmp"
        fi

        mv "$tmp" "$pconfig"
        log "Project config saved for '$pname'"
        echo ""
        jq '.' "$pconfig" | sed 's/^/  /'
        echo ""
      fi
      ;;

    --json)
      ${EDITOR:-vi} "$GLOBAL_CONFIG"
      log "Global config updated"
      ;;

    "")
      echo ""
      echo -e "  ${BOLD}Configure dev-cli${NC}"
      echo ""

      local cur_agent
      cur_agent=$(get_config_value '.defaults.agents[0]' 'claude')
      echo -e "  ${CYAN}1. Default agent${NC}"
      echo "    1) claude"
      echo "    2) codex"
      echo "    3) none"
      local default_num=1
      case "$cur_agent" in
        codex) default_num=2 ;;
        none) default_num=3 ;;
      esac
      read -rp "  Select [$default_num]: " choice
      local new_agent
      case "${choice:-$default_num}" in
        2) new_agent="codex" ;;
        3) new_agent="none" ;;
        *) new_agent="claude" ;;
      esac

      echo ""
      local cur_pkg
      cur_pkg=$(get_config_value '.defaults.package_manager' 'npm')
      echo -e "  ${CYAN}2. Default package manager${NC}"
      echo "    1) npm"
      echo "    2) pnpm"
      echo "    3) yarn"
      default_num=1
      case "$cur_pkg" in
        pnpm) default_num=2 ;;
        yarn) default_num=3 ;;
      esac
      read -rp "  Select [$default_num]: " choice
      local new_pkg
      case "${choice:-$default_num}" in
        2) new_pkg="pnpm" ;;
        3) new_pkg="yarn" ;;
        *) new_pkg="npm" ;;
      esac

      echo ""
      local cur_filter
      cur_filter=$(get_config_value '.defaults.task_filter' 'all')
      echo -e "  ${CYAN}3. Default task list filter${NC}"
      echo "    1) all  2) pending  3) running  4) done  5) failed"
      local filter_num=1
      case "$cur_filter" in
        pending) filter_num=2 ;; running) filter_num=3 ;; done) filter_num=4 ;; failed) filter_num=5 ;;
      esac
      read -rp "  Select [$filter_num]: " choice
      local new_filter
      case "${choice:-$filter_num}" in
        2) new_filter="pending" ;; 3) new_filter="running" ;; 4) new_filter="done" ;; 5) new_filter="failed" ;;
        *) new_filter="all" ;;
      esac

      echo ""
      local cur_accent
      cur_accent=$(get_config_value '.hub.theme.accent' 'cyan')
      echo -e "  ${CYAN}4. Hub accent color${NC}"
      echo "    1) cyan  2) green  3) blue  4) yellow  5) red"
      local accent_num=1
      case "$cur_accent" in
        green) accent_num=2 ;; blue) accent_num=3 ;; yellow) accent_num=4 ;; red) accent_num=5 ;;
      esac
      read -rp "  Select [$accent_num]: " choice
      local new_accent
      case "${choice:-$accent_num}" in
        2) new_accent="green" ;; 3) new_accent="blue" ;; 4) new_accent="yellow" ;; 5) new_accent="red" ;;
        *) new_accent="cyan" ;;
      esac

      echo ""
      local cur_refresh
      cur_refresh=$(get_config_value '.hub.refresh_seconds' '5')
      echo -e "  ${CYAN}5. Hub refresh interval (seconds)${NC}"
      read -rp "  Seconds [$cur_refresh]: " new_refresh
      new_refresh="${new_refresh:-$cur_refresh}"

      echo ""
      local cur_auto_fix
      cur_auto_fix=$(get_config_value '.review.auto_fix' 'false')
      local default_auto_fix="n"
      [ "$cur_auto_fix" = "true" ] && default_auto_fix="y"
      echo -e "  ${CYAN}6. Auto-fix issues after review${NC}"
      echo -e "  ${DIM}When enabled, the review agent will also fix issues and open a fix PR${NC}"
      read -rp "  Enable auto-fix (y/n) [$default_auto_fix]: " auto_fix_choice
      local new_auto_fix=false
      case "${auto_fix_choice:-$default_auto_fix}" in
        y|Y|yes) new_auto_fix=true ;;
      esac

      echo ""
      echo -e "  ${CYAN}7. Tmux window layout${NC}"
      local cur_windows
      cur_windows=$(get_tmux_windows "")
      local cur_win_names
      cur_win_names=$(echo "$cur_windows" | jq -r '.[].name' | paste -sd',' -)
      echo -e "  Current: $cur_win_names"
      read -rp "  Window names (comma-separated) [$cur_win_names]: " win_input
      win_input="${win_input:-$cur_win_names}"

      local windows_json="["
      local first=true
      IFS=',' read -ra WIN_NAMES <<< "$win_input"
      for wn in "${WIN_NAMES[@]}"; do
        wn=$(echo "$wn" | xargs)
        if [ "$first" = true ]; then first=false; else windows_json+=","; fi
        if [ "$wn" = "agent" ]; then
          windows_json+="{\"name\":\"agent\",\"command\":null}"
        elif [ "$wn" = "server" ]; then
          windows_json+="{\"name\":\"server\",\"command\":null}"
        elif [ "$wn" = "shell" ]; then
          windows_json+="{\"name\":\"shell\",\"command\":\"bash\"}"
        else
          windows_json+="{\"name\":\"$wn\",\"command\":\"bash\"}"
        fi
      done
      windows_json+="]"

      local tmp
      tmp=$(mktemp)
      jq \
        --arg agent "$new_agent" \
        --arg pkg "$new_pkg" \
        --arg filter "$new_filter" \
        --arg accent "$new_accent" \
        --argjson refresh "$new_refresh" \
        --argjson wins "$windows_json" \
        --argjson auto_fix "$new_auto_fix" \
        '.defaults.agents = [$agent] | .defaults.package_manager = $pkg | .defaults.task_filter = $filter | .hub.theme.accent = $accent | .hub.refresh_seconds = $refresh | .tmux.windows = $wins | .review.auto_fix = $auto_fix' \
        "$GLOBAL_CONFIG" > "$tmp"
      mv "$tmp" "$GLOBAL_CONFIG"

      echo ""
      log "Configuration saved"
      echo ""
      jq '.' "$GLOBAL_CONFIG" | sed 's/^/  /'
      echo ""
      ;;

    *)
      die "Unknown config subcommand: $subcmd. Use: dev config [show|reset|project <name>|--json]"
      ;;
  esac
}

cmd_agent() {
  local subcmd="${2:-}"
  [ -z "$subcmd" ] && die "Usage: dev agent <add|remove|list> <session> [claude|codex]"

  case "$subcmd" in
    add)
      local session_name="${3:-}" agent_type="${4:-}"
      [ -z "$session_name" ] && die "Usage: dev agent add <session> <claude|codex>"
      [ -z "$agent_type" ] && die "Usage: dev agent add <session> <claude|codex>"

      # Validate agent type
      case "$agent_type" in
        claude|codex) ;;
        *) die "Unknown agent type: $agent_type. Use claude or codex." ;;
      esac

      # Find session (partial matching)
      local match
      match=$(jq -r "keys[] | select(contains(\"$session_name\"))" "$PORT_REGISTRY" | head -1)
      [ -z "$match" ] && die "No session matching '$session_name'"

      # Check if agent type already running
      if has_agent "$match" "$agent_type"; then
        die "Agent '$agent_type' is already running in session '$match'"
      fi

      # Check if tmux session is alive
      tmux has-session -t "$match" 2>/dev/null || die "Session '$match' is not running"

      local worktree_path
      worktree_path=$(get_session_field "$match" "path")

      # Build agent command (container-aware)
      local agent_cmd
      local cid
      cid=$(get_session_field "$match" "container_id")

      # Source secrets — skip in container mode (secrets passed via --remote-env)
      local env_prefix=""
      if [ -z "$cid" ]; then
        env_prefix=$(build_env_prefix)
      fi

      if [[ "$agent_type" == *claude* ]]; then
        validate_claude_auth || true
      fi

      # Resolve yolo from project config
      local project yolo=false claude_flags=""
      project=$(get_session_field "$match" "project")
      if [ -n "$project" ] && [ -f "$CONFIG_DIR/projects/${project}.json" ]; then
        local config_yolo
        config_yolo=$(jq -r '.skip_permissions // false' "$CONFIG_DIR/projects/${project}.json")
        [ "$config_yolo" = "true" ] && yolo=true
      fi
      if [ "$yolo" = true ]; then
        claude_flags=" --dangerously-skip-permissions"
        [ -z "$cid" ] && ensure_claude_skip_prompt
      fi

      # Trust only needed on host — container handles it in postCreateCommand
      [ -z "$cid" ] && ensure_claude_trust "$worktree_path"
      if [ -n "$cid" ]; then
        # Verify container is running before trying to exec into it
        if ! docker inspect "$cid" --format '{{.State.Status}}' 2>/dev/null | grep -q "running"; then
          die "Container ${cid:0:12} is not running. Use 'dev restart $match' to restart the session."
        fi
      fi
      agent_cmd=$(build_agent_cmd "$agent_type" "$worktree_path" "$cid" "$claude_flags")

      # Create new tmux window named agent-<type>
      tmux new-window -t "$match" -n "agent-${agent_type}" "${env_prefix}${agent_cmd}"

      # Update port registry to include new agent in agents array
      local tmp
      tmp=$(mktemp)
      jq --arg name "$match" --arg agent_type "$agent_type" \
        '(.[$name].agents // [.[$name].agent]) as $current |
         .[$name].agents = ($current + [$agent_type] | unique)' \
        "$PORT_REGISTRY" > "$tmp"
      mv -f "$tmp" "$PORT_REGISTRY"
      fix_registry_perms

      log "Added $agent_type agent to session '$match'"
      ;;

    remove|rm)
      local session_name="${3:-}" agent_type="${4:-}"
      [ -z "$session_name" ] && die "Usage: dev agent remove <session> <claude|codex>"
      [ -z "$agent_type" ] && die "Usage: dev agent remove <session> <claude|codex>"

      # Find session (partial matching)
      local match
      match=$(jq -r "keys[] | select(contains(\"$session_name\"))" "$PORT_REGISTRY" | head -1)
      [ -z "$match" ] && die "No session matching '$session_name'"

      # Check if agent is in the session
      if ! has_agent "$match" "$agent_type"; then
        die "Agent '$agent_type' is not running in session '$match'"
      fi

      # Kill the specific tmux window (agent-<type>)
      tmux kill-window -t "$match:agent-${agent_type}" 2>/dev/null || \
        tmux kill-window -t "$match:agent" 2>/dev/null || \
        warn "Could not find tmux window for agent-${agent_type}"

      # Update port registry agents array
      local tmp
      tmp=$(mktemp)
      jq --arg name "$match" --arg agent_type "$agent_type" \
        '(.[$name].agents // [.[$name].agent]) as $current |
         .[$name].agents = ($current | map(select(. != $agent_type)))' \
        "$PORT_REGISTRY" > "$tmp"
      mv -f "$tmp" "$PORT_REGISTRY"
      fix_registry_perms

      log "Removed $agent_type agent from session '$match'"
      ;;

    list|ls)
      local session_name="${3:-}"
      [ -z "$session_name" ] && die "Usage: dev agent list <session>"

      # Find session (partial matching)
      local match
      match=$(jq -r "keys[] | select(contains(\"$session_name\"))" "$PORT_REGISTRY" | head -1)
      [ -z "$match" ] && die "No session matching '$session_name'"

      local agents
      agents=$(get_session_agents "$match")

      echo ""
      echo -e "  ${BOLD}Agents for: $match${NC}"
      echo ""

      # List agents from registry
      local IFS_BAK="$IFS"
      IFS=',' read -ra agent_arr <<< "$agents"
      IFS="$IFS_BAK"
      for a in "${agent_arr[@]}"; do
        # Check if corresponding tmux window exists
        local window_name
        if [ "$a" = "$(echo "$agents" | cut -d',' -f1)" ]; then
          window_name="agent"
        else
          window_name="agent-${a}"
        fi
        if tmux has-session -t "$match" 2>/dev/null && tmux list-windows -t "$match" -F '#{window_name}' 2>/dev/null | grep -qx "$window_name"; then
          echo -e "  ${GREEN}●${NC} $a  ${DIM}(window: $window_name)${NC}"
        else
          echo -e "  ${RED}●${NC} $a  ${DIM}(window not found)${NC}"
        fi
      done

      # Also list any agent tmux windows not tracked in registry
      if tmux has-session -t "$match" 2>/dev/null; then
        local tmux_windows
        tmux_windows=$(tmux list-windows -t "$match" -F '#{window_name}' 2>/dev/null | grep '^agent' || true)
        if [ -n "$tmux_windows" ]; then
          while IFS= read -r win; do
            local tracked=false
            for a in "${agent_arr[@]}"; do
              if [ "$win" = "agent" ] || [ "$win" = "agent-${a}" ]; then
                tracked=true
                break
              fi
            done
            if [ "$tracked" = false ]; then
              echo -e "  ${YELLOW}●${NC} ${win}  ${DIM}(untracked tmux window)${NC}"
            fi
          done <<< "$tmux_windows"
        fi
      fi
      echo ""
      ;;

    *)
      die "Unknown agent subcommand: $subcmd. Use add, remove, or list."
      ;;
  esac
}

# Launch a new tmux window with a specific agent in an existing session.
# Usage: cmd_launch_agent <agent_type> "$@"
# Called by `dev claude [name]` and `dev codex [name]`.
cmd_launch_agent() {
  local agent_type="$1"
  shift  # drop agent_type
  local session_name="${2:-}"
  local yolo=false prompt=""
  shift 2 || shift $# || true
  while [[ $# -gt 0 ]]; do
    case "${1:-}" in
      --yolo|-y) yolo=true; shift ;;
      *) [ -z "$prompt" ] && prompt="$1"; shift ;;
    esac
  done

  [ -z "$session_name" ] && die "Usage: dev $agent_type <session> [--yolo] [prompt]"

  # Find session (partial matching)
  local match
  match=$(jq -r "keys[] | select(contains(\"$session_name\"))" "$PORT_REGISTRY" | head -1)
  [ -z "$match" ] && die "No session matching '$session_name'"

  # Check if tmux session is alive
  tmux has-session -t "$match" 2>/dev/null || die "Session '$match' is not running"

  local worktree_path
  worktree_path=$(get_session_field "$match" "path")

  # Build agent command (container-aware)
  local cid
  cid=$(get_session_field "$match" "container_id")

  # Source secrets — skip in container mode
  local env_prefix=""
  if [ -z "$cid" ]; then
    env_prefix=$(build_env_prefix)
  fi

  if [[ "$agent_type" == *claude* ]]; then
    validate_claude_auth || true
  fi

  # Resolve yolo from project config if not set via flag
  local project claude_flags=""
  project=$(get_session_field "$match" "project")
  if [ "$yolo" = false ] && [ -n "$project" ] && [ -f "$CONFIG_DIR/projects/${project}.json" ]; then
    local config_yolo
    config_yolo=$(jq -r '.skip_permissions // false' "$CONFIG_DIR/projects/${project}.json")
    [ "$config_yolo" = "true" ] && yolo=true
  fi
  if [ "$yolo" = true ] && [ "$agent_type" = "claude" ]; then
    claude_flags=" --dangerously-skip-permissions"
    [ -z "$cid" ] && ensure_claude_skip_prompt
  fi

  # Trust only needed on host
  [ -z "$cid" ] && [ "$agent_type" = "claude" ] && ensure_claude_trust "$worktree_path"
  if [ -n "$cid" ]; then
    if ! docker inspect "$cid" --format '{{.State.Status}}' 2>/dev/null | grep -q "running"; then
      die "Container ${cid:0:12} is not running. Use 'dev restart $match' to restart the session."
    fi
  fi

  local prompt_arg=""
  [ -n "$prompt" ] && prompt_arg=" \"$prompt\""

  local agent_cmd
  agent_cmd=$(build_agent_cmd "$agent_type" "$worktree_path" "$cid" "$claude_flags" "$prompt_arg")

  # Create new tmux window
  tmux new-window -t "$match" -n "agent-${agent_type}" "${env_prefix}${agent_cmd}"

  # Update port registry agents array
  if ! has_agent "$match" "$agent_type"; then
    local tmp
    tmp=$(mktemp)
    jq --arg name "$match" --arg agent_type "$agent_type" \
      '(.[$name].agents // [.[$name].agent]) as $current |
       .[$name].agents = ($current + [$agent_type] | unique)' \
      "$PORT_REGISTRY" > "$tmp"
    mv -f "$tmp" "$PORT_REGISTRY"
    fix_registry_perms
  fi

  log "Launched $agent_type in session '$match'"
}

cmd_web() {
  local subcmd="${2:-help}"
  case "$subcmd" in
    setup)
      info "Setting up web dashboard..."
      if ! command -v python3 &>/dev/null; then
        die "python3 is required. Install it first."
      fi
      local venv_dir="$CONFIG_DIR/venv"
      if [ ! -d "$venv_dir" ]; then
        info "Creating Python virtual environment..."
        python3 -m venv "$venv_dir"
      fi
      info "Installing dependencies..."
      "$venv_dir/bin/pip" install -q -r "$WEB_DIR/requirements.txt"
      log "Web dashboard setup complete"
      ;;
    start)
      if systemctl is-active dev-web.service &>/dev/null; then
        die "Web dashboard is managed by systemd. Use 'dev services stop' first, or 'dev services restart'"
      fi
      local port="${3:-$(get_config_value '.web.port' '8080')}"
      local venv_dir="$CONFIG_DIR/venv"
      local pid_file="$CONFIG_DIR/web.pid"
      [ -d "$venv_dir" ] || die "Run 'dev web setup' first"
      if [ -f "$pid_file" ] && kill -0 "$(cat "$pid_file")" 2>/dev/null; then
        die "Web dashboard already running (PID $(cat "$pid_file"))"
      fi
      info "Starting web dashboard on port $port..."
      cd "$WEB_DIR"
      PYTHONPATH="$WEB_DIR" "$venv_dir/bin/gunicorn" \
        --bind "0.0.0.0:$port" \
        --workers 2 \
        --timeout 120 \
        --pid "$pid_file" \
        --daemon \
        --access-logfile "$LOG_DIR/web-access.log" \
        --error-logfile "$LOG_DIR/web-error.log" \
        "dashboard.app:create_app()"
      sleep 1
      if [ -f "$pid_file" ] && kill -0 "$(cat "$pid_file")" 2>/dev/null; then
        local ip
        ip=$(get_ip 2>/dev/null || echo "localhost")
        log "Web dashboard running at http://${ip}:${port}"
      else
        die "Failed to start web dashboard. Check $LOG_DIR/web-error.log"
      fi
      ;;
    stop)
      local pid_file="$CONFIG_DIR/web.pid"
      if [ -f "$pid_file" ]; then
        local pid
        pid=$(cat "$pid_file")
        if kill -0 "$pid" 2>/dev/null; then
          kill "$pid"
          rm -f "$pid_file"
          log "Web dashboard stopped"
        else
          rm -f "$pid_file"
          warn "Web dashboard was not running (stale PID file removed)"
        fi
      else
        warn "Web dashboard is not running"
      fi
      ;;
    status)
      local pid_file="$CONFIG_DIR/web.pid"
      if [ -f "$pid_file" ] && kill -0 "$(cat "$pid_file")" 2>/dev/null; then
        local port
        port=$(get_config_value '.web.port' '8080')
        local ip
        ip=$(get_ip 2>/dev/null || echo "localhost")
        echo -e "${GREEN}●${NC} Web dashboard is running (PID $(cat "$pid_file"))"
        echo -e "  URL: http://${ip}:${port}"
      else
        echo -e "${RED}●${NC} Web dashboard is not running"
        [ -f "$pid_file" ] && rm -f "$pid_file"
      fi
      ;;
    *)
      echo "Usage: dev web <setup|start [port]|stop|status>"
      ;;
  esac
}

cmd_bot() {
  local subcmd="${2:-help}"
  case "$subcmd" in
    setup)
      # Bot uses same venv as web
      cmd_web setup
      ;;
    start)
      if systemctl is-active dev-bot.service &>/dev/null; then
        die "Telegram bot is managed by systemd. Use 'dev services stop' first, or 'dev services restart'"
      fi
      local venv_dir="$CONFIG_DIR/venv"
      local pid_file="$CONFIG_DIR/bot.pid"
      [ -d "$venv_dir" ] || die "Run 'dev bot setup' first"
      local token
      token=$(get_config_value '.telegram.bot_token' '')
      [ -n "$token" ] || die "Set telegram.bot_token in $GLOBAL_CONFIG first"
      if [ -f "$pid_file" ] && kill -0 "$(cat "$pid_file")" 2>/dev/null; then
        die "Telegram bot already running (PID $(cat "$pid_file"))"
      fi
      info "Starting Telegram bot..."
      cd "$WEB_DIR"
      PYTHONPATH="$WEB_DIR" nohup "$venv_dir/bin/python" -m bot.app \
        > "$LOG_DIR/bot.log" 2>&1 &
      echo $! > "$pid_file"
      sleep 2
      if kill -0 "$(cat "$pid_file")" 2>/dev/null; then
        log "Telegram bot started (PID $(cat "$pid_file"))"
      else
        rm -f "$pid_file"
        die "Failed to start bot. Check $LOG_DIR/bot.log"
      fi
      ;;
    stop)
      local pid_file="$CONFIG_DIR/bot.pid"
      if [ -f "$pid_file" ]; then
        local pid
        pid=$(cat "$pid_file")
        if kill -0 "$pid" 2>/dev/null; then
          kill "$pid"
          rm -f "$pid_file"
          log "Telegram bot stopped"
        else
          rm -f "$pid_file"
          warn "Telegram bot was not running (stale PID file removed)"
        fi
      else
        warn "Telegram bot is not running"
      fi
      ;;
    status)
      local pid_file="$CONFIG_DIR/bot.pid"
      if [ -f "$pid_file" ] && kill -0 "$(cat "$pid_file")" 2>/dev/null; then
        echo -e "${GREEN}●${NC} Telegram bot is running (PID $(cat "$pid_file"))"
      else
        echo -e "${RED}●${NC} Telegram bot is not running"
        [ -f "$pid_file" ] && rm -f "$pid_file"
      fi
      ;;
    *)
      echo "Usage: dev bot <setup|start|stop|status>"
      ;;
  esac
}

cmd_notify() {
  local subcmd="${2:-help}"
  case "$subcmd" in
    setup)
      # Use settings.local.json for hooks — these depend on claude-tg-notify
      # which is machine-specific (only installed where dev-cli is).
      # This avoids breaking shared dotfiles on machines without dev-cli.
      local settings_file="$HOME/.claude/settings.local.json"
      mkdir -p "$HOME/.claude"

      local hooks_config
      hooks_config=$(cat << 'HOOKS_JSON'
{
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "claude-tg-notify notify"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "claude-tg-notify notify"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "claude-tg-notify cancel"
          }
        ]
      }
    ]
  }
}
HOOKS_JSON
      )

      if [ -f "$settings_file" ]; then
        # Merge hooks into existing local settings
        local merged
        merged=$(jq -s '.[0] * .[1]' "$settings_file" <(echo "$hooks_config"))
        echo "$merged" > "$settings_file"
      else
        echo "$hooks_config" > "$settings_file"
      fi
      log "Installed Claude Code hooks into $settings_file"

      # Clean up hooks from settings.json if present (migrate to local)
      local global_settings="$HOME/.claude/settings.json"
      if [ -f "$global_settings" ] && jq -e '.hooks' "$global_settings" > /dev/null 2>&1; then
        local cleaned
        cleaned=$(jq 'del(.hooks)' "$global_settings")
        echo "$cleaned" > "$global_settings"
        info "Migrated hooks from settings.json to settings.local.json"
      fi

      # Check if bot_token is configured
      local token
      token=$(get_config_value '.telegram.bot_token' '')
      if [ -z "$token" ]; then
        warn "No bot_token configured. Set it with:"
        echo "  jq '.telegram.bot_token = \"YOUR_TOKEN\"' $GLOBAL_CONFIG > /tmp/cfg.json && mv /tmp/cfg.json $GLOBAL_CONFIG"
      fi
      local chat_ids
      chat_ids=$(jq -r '.telegram.allowed_chat_ids | length' "$GLOBAL_CONFIG" 2>/dev/null || echo "0")
      if [ "$chat_ids" = "0" ]; then
        warn "No chat_ids configured. Set them with:"
        echo "  jq '.telegram.allowed_chat_ids = [YOUR_CHAT_ID]' $GLOBAL_CONFIG > /tmp/cfg.json && mv /tmp/cfg.json $GLOBAL_CONFIG"
      fi
      ;;
    status)
      echo -e "${BOLD}Claude Code Notification Hooks${NC}"
      echo ""

      # Check hooks in settings.local.json (preferred) or settings.json (legacy)
      local local_settings="$HOME/.claude/settings.local.json"
      local global_settings="$HOME/.claude/settings.json"
      if [ -f "$local_settings" ] && jq -e '.hooks.Notification' "$local_settings" > /dev/null 2>&1; then
        echo -e "  Hooks:   ${GREEN}●${NC} installed in $local_settings"
      elif [ -f "$global_settings" ] && jq -e '.hooks.Notification' "$global_settings" > /dev/null 2>&1; then
        echo -e "  Hooks:   ${YELLOW}●${NC} installed in $global_settings (consider running 'dev notify setup' to migrate to settings.local.json)"
      else
        echo -e "  Hooks:   ${RED}●${NC} not installed (run 'dev notify setup')"
      fi

      # Check bot token
      local token
      token=$(get_config_value '.telegram.bot_token' '')
      if [ -n "$token" ]; then
        echo -e "  Token:   ${GREEN}●${NC} configured (${token:0:10}...)"
      else
        echo -e "  Token:   ${RED}●${NC} not configured"
      fi

      # Check chat IDs
      local chat_ids
      chat_ids=$(jq -r '.telegram.allowed_chat_ids // [] | join(", ")' "$GLOBAL_CONFIG" 2>/dev/null || echo "")
      if [ -n "$chat_ids" ]; then
        echo -e "  Chat IDs: ${GREEN}●${NC} $chat_ids"
      else
        echo -e "  Chat IDs: ${RED}●${NC} none configured"
      fi

      # Show delay
      local delay
      delay=$(get_config_value '.telegram.notify_delay_seconds' '30')
      echo -e "  Delay:   ${CYAN}${delay}s${NC}"
      echo ""
      ;;
    test)
      local token
      token=$(get_config_value '.telegram.bot_token' '')
      [ -n "$token" ] || die "No bot_token configured in $GLOBAL_CONFIG"

      local chat_ids
      chat_ids=$(jq -r '.telegram.allowed_chat_ids[]?' "$GLOBAL_CONFIG" 2>/dev/null || true)
      [ -n "$chat_ids" ] || die "No chat_ids configured in $GLOBAL_CONFIG"

      local hostname
      hostname=$(hostname 2>/dev/null || echo "unknown")
      local text="🔔 *dev-cli test*
✅ Notifications working from \`${hostname}\`"

      info "Sending test notification..."
      while IFS= read -r chat_id; do
        [ -n "$chat_id" ] || continue
        local result
        result=$(curl -s -X POST "https://api.telegram.org/bot${token}/sendMessage" \
          -d chat_id="$chat_id" \
          -d text="$text" \
          -d parse_mode="Markdown" 2>&1)
        if echo "$result" | jq -e '.ok' > /dev/null 2>&1; then
          log "Sent to chat $chat_id"
        else
          local desc
          desc=$(echo "$result" | jq -r '.description // "unknown error"' 2>/dev/null)
          die "Failed to send to chat $chat_id: $desc"
        fi
      done <<< "$chat_ids"
      ;;
    delay)
      local seconds="${3:-}"
      [ -n "$seconds" ] || die "Usage: dev notify delay <seconds>"
      # Validate it's a number
      [[ "$seconds" =~ ^[0-9]+$ ]] || die "Delay must be a positive integer"

      local tmp
      tmp=$(mktemp)
      jq --argjson delay "$seconds" '.telegram.notify_delay_seconds = $delay' "$GLOBAL_CONFIG" > "$tmp" && mv "$tmp" "$GLOBAL_CONFIG"
      log "Notification delay set to ${seconds}s"
      ;;
    *)
      echo "Usage: dev notify <setup|status|test|delay>"
      echo ""
      echo "  setup          Install Claude Code hooks for Telegram notifications"
      echo "  status         Show current notification config and status"
      echo "  test           Send a test notification"
      echo "  delay <secs>   Set notification delay (default: 30s)"
      ;;
  esac
}

cmd_services() {
  local subcmd="${2:-help}"
  local service_dir="/etc/systemd/system"
  local venv_dir="$CONFIG_DIR/venv"
  local run_user="$USER"
  local run_home="$HOME"

  _write_service_files() {
    local web_port
    web_port=$(get_config_value '.web.port' '8080')

    sudo tee "$service_dir/dev-web.service" > /dev/null << EOF
[Unit]
Description=dev-cli Web Dashboard
After=network.target

[Service]
Type=exec
User=$run_user
WorkingDirectory=$WEB_DIR
Environment=PYTHONPATH=$WEB_DIR
Environment=HOME=$run_home
ExecStart=$venv_dir/bin/gunicorn --bind 0.0.0.0:$web_port --workers 2 --timeout 120 "dashboard.app:create_app()"
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

    sudo tee "$service_dir/dev-bot.service" > /dev/null << EOF
[Unit]
Description=dev-cli Telegram Bot
After=network.target

[Service]
Type=exec
User=$run_user
WorkingDirectory=$WEB_DIR
Environment=PYTHONPATH=$WEB_DIR
Environment=HOME=$run_home
ExecStart=$venv_dir/bin/python -m bot.app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

    sudo tee "$service_dir/dev-task-runner.service" > /dev/null << EOF
[Unit]
Description=dev-cli Task Runner
After=network.target

[Service]
Type=exec
User=$run_user
Environment=HOME=$run_home
Environment=PATH=$run_home/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=$run_home/.local/bin/dev-task-runner --watch
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
EOF

    sudo tee "$service_dir/dev-linear.service" > /dev/null << EOF
[Unit]
Description=dev-cli Linear Integration
After=network.target

[Service]
Type=exec
User=$run_user
Environment=HOME=$run_home
Environment=PATH=$run_home/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=$run_home/.local/bin/dev-linear --watch
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
EOF
  }

  case "$subcmd" in
    install)
      [ -d "$venv_dir" ] || die "Python venv not found. Run 'dev web setup' first"
      [ -d "$WEB_DIR" ] || die "Web dashboard not installed. Run install.sh first"
      # Kill any existing dev web start / dev bot start processes
      local web_pid="$CONFIG_DIR/web.pid"
      if [ -f "$web_pid" ]; then
        local pid
        pid=$(cat "$web_pid")
        if kill -0 "$pid" 2>/dev/null; then
          kill "$pid" 2>/dev/null
          info "Stopped old web dashboard process (PID $pid)"
        fi
        rm -f "$web_pid"
      fi
      local bot_pid="$CONFIG_DIR/bot.pid"
      if [ -f "$bot_pid" ]; then
        local pid
        pid=$(cat "$bot_pid")
        if kill -0 "$pid" 2>/dev/null; then
          kill "$pid" 2>/dev/null
          info "Stopped old Telegram bot process (PID $pid)"
        fi
        rm -f "$bot_pid"
      fi
      _write_service_files
      sudo systemctl daemon-reload
      sudo systemctl enable dev-web.service
      log "dev-web service installed and enabled"
      # Only enable bot if token is configured
      local token
      token=$(get_config_value '.telegram.bot_token' '')
      if [ -n "$token" ]; then
        sudo systemctl enable dev-bot.service
        log "dev-bot service installed and enabled"
      else
        info "Telegram bot not enabled (no bot_token configured)"
        info "Set telegram.bot_token in config, then run: dev services install"
      fi
      sudo systemctl enable dev-task-runner.service
      log "dev-task-runner service installed and enabled"
      local linear_key
      linear_key=$(get_config_value '.linear.api_key' '')
      if [ -n "$linear_key" ]; then
        sudo systemctl enable dev-linear.service
        log "dev-linear service installed and enabled"
      else
        info "Linear integration not enabled (not configured)"
        info "Run 'dev linear setup', then: dev services install"
      fi
      info "Services will auto-start on boot. Start now with: dev services start"
      ;;
    uninstall)
      sudo systemctl stop dev-web.service 2>/dev/null || true
      sudo systemctl stop dev-bot.service 2>/dev/null || true
      sudo systemctl stop dev-task-runner.service 2>/dev/null || true
      sudo systemctl stop dev-linear.service 2>/dev/null || true
      sudo systemctl disable dev-web.service 2>/dev/null || true
      sudo systemctl disable dev-bot.service 2>/dev/null || true
      sudo systemctl disable dev-task-runner.service 2>/dev/null || true
      sudo systemctl disable dev-linear.service 2>/dev/null || true
      sudo rm -f "$service_dir/dev-web.service" "$service_dir/dev-bot.service" "$service_dir/dev-task-runner.service" "$service_dir/dev-linear.service"
      sudo systemctl daemon-reload
      log "Services uninstalled"
      ;;
    start)
      sudo systemctl start dev-web.service
      log "Web dashboard started"
      local token
      token=$(get_config_value '.telegram.bot_token' '')
      if [ -n "$token" ]; then
        sudo systemctl start dev-bot.service
        log "Telegram bot started"
      fi
      sudo systemctl start dev-task-runner.service
      log "Task runner started"
      if systemctl is-enabled dev-linear.service &>/dev/null; then
        sudo systemctl start dev-linear.service
        log "Linear integration started"
      fi
      ;;
    stop)
      sudo systemctl stop dev-web.service 2>/dev/null && log "Web dashboard stopped" || true
      sudo systemctl stop dev-bot.service 2>/dev/null && log "Telegram bot stopped" || true
      sudo systemctl stop dev-task-runner.service 2>/dev/null && log "Task runner stopped" || true
      sudo systemctl stop dev-linear.service 2>/dev/null && log "Linear integration stopped" || true
      ;;
    restart)
      sudo systemctl restart dev-web.service
      log "Web dashboard restarted"
      local token
      token=$(get_config_value '.telegram.bot_token' '')
      if [ -n "$token" ]; then
        sudo systemctl restart dev-bot.service
        log "Telegram bot restarted"
      fi
      sudo systemctl restart dev-task-runner.service
      log "Task runner restarted"
      if systemctl is-enabled dev-linear.service &>/dev/null; then
        sudo systemctl restart dev-linear.service
        log "Linear integration restarted"
      fi
      ;;
    status)
      echo -e "${BOLD}Services:${NC}"
      echo ""
      if systemctl is-active dev-web.service &>/dev/null; then
        local web_port
        web_port=$(get_config_value '.web.port' '8080')
        local ip
        ip=$(get_ip 2>/dev/null || echo "localhost")
        echo -e "  ${GREEN}●${NC} Web dashboard  (http://${ip}:${web_port})"
      else
        echo -e "  ${RED}●${NC} Web dashboard"
      fi
      if systemctl is-active dev-bot.service &>/dev/null; then
        echo -e "  ${GREEN}●${NC} Telegram bot"
      else
        echo -e "  ${RED}●${NC} Telegram bot"
      fi
      if systemctl is-active dev-task-runner.service &>/dev/null; then
        echo -e "  ${GREEN}●${NC} Task runner"
      else
        echo -e "  ${RED}●${NC} Task runner"
      fi
      if [ -f "$service_dir/dev-linear.service" ]; then
        if systemctl is-active dev-linear.service &>/dev/null; then
          echo -e "  ${GREEN}●${NC} Linear integration"
        else
          echo -e "  ${RED}●${NC} Linear integration"
        fi
      fi
      echo ""
      if [ -f "$service_dir/dev-web.service" ] || [ -f "$service_dir/dev-linear.service" ]; then
        echo -e "  Installed: ${GREEN}yes${NC} (auto-start on boot)"
      else
        echo -e "  Installed: ${RED}no${NC} (run 'dev services install')"
      fi
      ;;
    logs)
      local service="${3:-web}"
      case "$service" in
        web) journalctl -u dev-web.service -f --no-hostname ;;
        bot) journalctl -u dev-bot.service -f --no-hostname ;;
        task-runner) journalctl -u dev-task-runner.service -f --no-hostname ;;
        linear) journalctl -u dev-linear.service -f --no-hostname ;;
        *)   die "Unknown service: $service. Use 'web', 'bot', 'task-runner', or 'linear'" ;;
      esac
      ;;
    *)
      echo "Usage: dev services <install|uninstall|start|stop|restart|status|logs [web|bot|task-runner|linear]>"
      ;;
  esac
}

cmd_mobile() {
  echo ""
  echo -e "  ${BOLD}${CYAN}DEV MOBILE${NC}"
  echo ""
  echo -e "  ${BOLD}1)${NC} ls        — List sessions"
  echo -e "  ${BOLD}2)${NC} attach    — Attach to session"
  echo -e "  ${BOLD}3)${NC} new       — Create session"
  echo -e "  ${BOLD}4)${NC} logs      — View logs"
  echo -e "  ${BOLD}5)${NC} stats     — System stats"
  echo -e "  ${BOLD}6)${NC} hub       — Open hub"
  echo ""
  read -rp "  Choice [1-6]: " choice
  echo ""

  case "$choice" in
    1) cmd_ls ls ;;
    2) cmd_attach attach ;;
    3)
      read -rp "  Project: " project
      read -rp "  Branch: " branch
      [ -n "$project" ] && [ -n "$branch" ] && dev new "$project" "$branch"
      ;;
    4)
      read -rp "  Session: " session
      [ -n "$session" ] && cmd_logs logs "$session"
      ;;
    5) cmd_stats ;;
    6) cmd_hub ;;
    *) echo -e "  ${DIM}Invalid choice.${NC}" ;;
  esac
}

cmd_task() {
  local subcmd="${2:-ls}"

  case "$subcmd" in
    add)
      local project="" branch="" description="" from_branch="" private=false mode="normal"
      shift 2  # skip "task add"

      # Parse positional args and flags
      while [[ $# -gt 0 ]]; do
        case "${1:-}" in
          --from) from_branch="${2:-}"; shift 2 ;;
          --from=*) from_branch="${1#*=}"; shift ;;
          --private) private=true; shift ;;
          --plan) mode="plan"; shift ;;
          *)
            if [ -z "$project" ]; then
              project="$1"
            elif [ -z "$branch" ]; then
              branch="$1"
            elif [ -z "$description" ]; then
              description="$1"
            fi
            shift
            ;;
        esac
      done

      # If only two positional args given (project + description, no branch),
      # treat second arg as description and auto-generate branch name
      if [ -n "$branch" ] && [ -z "$description" ]; then
        description="$branch"
        branch=""
      fi

      [ -n "$project" ] || die "Usage: dev task add <project> [branch] \"description\" [--from <base>] [--private] [--plan]"

      # If the first arg is not a valid project and no description was given,
      # the user likely entered only the description — prompt them to select a project
      if ! [ -f "$CONFIG_DIR/projects/${project}.json" ] && [ -z "$description" ]; then
        description="$project"
        project=""

        local available_projects
        available_projects=$(ls "$CONFIG_DIR/projects/" 2>/dev/null | sed 's/\.json$//' | sort)

        if [ -z "$available_projects" ]; then
          die "No projects configured. Run 'dev setup' first."
        fi

        echo "Available projects:"
        local i=1
        while IFS= read -r p; do
          echo "  $i) $p"
          i=$((i + 1))
        done <<< "$available_projects"
        echo ""
        read -rp "Select project number: " choice
        project=$(echo "$available_projects" | sed -n "${choice}p")
        [ -z "$project" ] && die "Invalid selection."
      fi

      [ -n "$description" ] || die "Usage: dev task add <project> [branch] \"description\" [--from <base>] [--private] [--plan]"

      # Auto-generate branch name from description if not provided
      if [ -z "$branch" ]; then
        local id_for_branch
        id_for_branch=$(jq -r '.next_id' "$TASK_REGISTRY")
        branch="task-${id_for_branch}"
        info "Auto-generated branch: $branch"
      fi

      # Validate project exists
      [ -d "$CONFIG_DIR/projects" ] && [ -f "$CONFIG_DIR/projects/${project}.json" ] \
        || die "Project '$project' not found. Run 'dev setup' first."

      local id now tmp
      id=$(jq -r '.next_id' "$TASK_REGISTRY")
      now=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
      tmp="$TASK_REGISTRY.tmp.$$"

      jq --arg id "$id" --arg proj "$project" --arg br "$branch" \
         --arg desc "$description" --arg now "$now" \
         --arg from "$from_branch" \
         --argjson private "$private" \
         --arg mode "$mode" \
        '.tasks += [{
          id: $id,
          project: $proj,
          branch: $br,
          description: $desc,
          from_branch: (if $from == "" then null else $from end),
          private: $private,
          mode: $mode,
          status: "pending",
          session: null,
          pr_url: null,
          created: $now,
          started: null,
          completed: null
        }] | .next_id = (.next_id + 1)' "$TASK_REGISTRY" > "$tmp" && mv "$tmp" "$TASK_REGISTRY"

      local mode_label=""
      [ "$mode" = "plan" ] && mode_label=" [plan mode]"
      if [ -n "$from_branch" ]; then
        log "Task #$id added: $project/$branch (from $from_branch)${mode_label} — $description"
      else
        log "Task #$id added: $project/$branch${mode_label} — $description"
      fi
      ;;
    ls|list)
      if ! jq -e '.tasks | length > 0' "$TASK_REGISTRY" &>/dev/null; then
        info "No tasks. Add one with: dev task add <project> [branch] \"description\""
        return
      fi

      # Parse filter flags
      local filter=""
      local i=3
      while [ $i -le $# ]; do
        local arg="${!i}"
        case "$arg" in
          --all)        filter="all" ;;
          --pending)    filter="pending" ;;
          --running)    filter="running" ;;
          --done)       filter="done" ;;
          --failed)     filter="failed" ;;
          --pr-created)   filter="pr-created" ;;
          --plan-review)  filter="plan-review" ;;
          *) warn "Unknown flag: $arg" ;;
        esac
        i=$((i + 1))
      done

      # Fall back to configured default if no flag given
      if [ -z "$filter" ]; then
        filter=$(get_config_value '.defaults.task_filter' 'all')
      fi

      # Build jq filter
      local jq_filter='.tasks[]'
      if [ "$filter" != "all" ]; then
        jq_filter=".tasks[] | select(.status == \"$filter\")"
      fi

      local count
      count=$(jq "[${jq_filter}] | length" "$TASK_REGISTRY")
      if [ "$count" -eq 0 ]; then
        info "No tasks with status '${filter}'."
        return
      fi

      echo ""
      if [ "$filter" != "all" ]; then
        echo -e "  ${DIM}Showing: ${filter} (use --all to see all)${NC}"
        echo ""
      fi
      printf "  ${BOLD}%-4s %-12s %-20s %-25s %s${NC}\n" "ID" "STATUS" "PROJECT" "BRANCH" "DESCRIPTION"
      echo "  ─────────────────────────────────────────────────────────────────────────────────"
      jq -r "${jq_filter} | [.id, .status, .project, .branch, .description] | @tsv" "$TASK_REGISTRY" | \
      while IFS=$'\t' read -r id status project branch desc; do
        local color="$NC"
        case "$status" in
          pending)     color="$YELLOW" ;;
          running)     color="$BLUE" ;;
          plan-review) color="$MAGENTA" ;;
          pr-created)  color="$CYAN" ;;
          done)        color="$GREEN" ;;
          failed)      color="$RED" ;;
        esac
        printf "  %-4s ${color}%-12s${NC} %-20s %-25s %s\n" "$id" "$status" "$project" "$branch" "$desc"
      done
      echo ""
      ;;
    prune)
      # Parse flags
      local prune_filter="done"
      local dry_run=false
      local i=3
      while [ $i -le $# ]; do
        local arg="${!i}"
        case "$arg" in
          --failed)       prune_filter="failed" ;;
          --all-finished) prune_filter="all-finished" ;;
          --dry-run)      dry_run=true ;;
          *) warn "Unknown flag: $arg" ;;
        esac
        i=$((i + 1))
      done

      # Build jq select expression for tasks to prune
      local select_expr
      case "$prune_filter" in
        done)         select_expr='select(.status == "done")' ;;
        failed)       select_expr='select(.status == "failed")' ;;
        all-finished) select_expr='select(.status == "done" or .status == "failed" or .status == "pr-created")' ;;
      esac

      local count
      count=$(jq "[.tasks[] | ${select_expr}] | length" "$TASK_REGISTRY")

      if [ "$count" -eq 0 ]; then
        info "No tasks to prune (filter: ${prune_filter})."
        return
      fi

      if [ "$dry_run" = true ]; then
        echo ""
        echo -e "  ${DIM}Would prune $count task(s):${NC}"
        echo ""
        printf "  ${BOLD}%-4s %-12s %-20s %-25s %s${NC}\n" "ID" "STATUS" "PROJECT" "BRANCH" "DESCRIPTION"
        echo "  ─────────────────────────────────────────────────────────────────────────────────"
        jq -r ".tasks[] | ${select_expr} | [.id, .status, .project, .branch, .description] | @tsv" "$TASK_REGISTRY" | \
        while IFS=$'\t' read -r id status project branch desc; do
          printf "  %-4s %-12s %-20s %-25s %s\n" "$id" "$status" "$project" "$branch" "$desc"
        done
        echo ""
        return
      fi

      local tmp="$TASK_REGISTRY.tmp.$$"
      jq ".tasks = [.tasks[] | ${select_expr} | not // empty] // []" "$TASK_REGISTRY" > /dev/null 2>&1 || true
      # Use the inverse select to keep non-matching tasks
      local keep_expr
      case "$prune_filter" in
        done)         keep_expr='select(.status != "done")' ;;
        failed)       keep_expr='select(.status != "failed")' ;;
        all-finished) keep_expr='select(.status != "done" and .status != "failed" and .status != "pr-created")' ;;
      esac
      jq ".tasks = [.tasks[] | ${keep_expr}]" "$TASK_REGISTRY" > "$tmp" && mv "$tmp" "$TASK_REGISTRY"
      log "Pruned $count task(s) (filter: ${prune_filter})"
      ;;
    approve)
      local id="${3:-}"
      [ -n "$id" ] || die "Usage: dev task approve <id>"

      # Validate task exists and has plan-review status
      local task_status task_mode
      task_status=$(jq -r --arg id "$id" '.tasks[] | select(.id == $id) | .status' "$TASK_REGISTRY")
      [ -n "$task_status" ] || die "Task #$id not found"
      [ "$task_status" = "plan-review" ] || die "Task #$id is not in plan-review status (current: $task_status)"

      task_mode=$(jq -r --arg id "$id" '.tasks[] | select(.id == $id) | .mode // "normal"' "$TASK_REGISTRY")
      [ "$task_mode" = "plan" ] || die "Task #$id is not a plan-mode task"

      # Get session and worktree
      local session worktree
      session=$(jq -r --arg id "$id" '.tasks[] | select(.id == $id) | .session // empty' "$TASK_REGISTRY")
      [ -n "$session" ] || die "Task #$id has no session"

      worktree=$(jq -r --arg s "$session" '.[$s].worktree // .[$s].path // empty' "$PORT_REGISTRY")
      [ -n "$worktree" ] && [ -d "$worktree" ] || die "Worktree not found for session '$session'"

      # Remove plan-ready marker
      rm -f "$worktree/.task-plan-ready"

      # Rewrite TASK.md with implementation instructions
      local description branch
      description=$(jq -r --arg id "$id" '.tasks[] | select(.id == $id) | .description' "$TASK_REGISTRY")
      branch=$(jq -r --arg id "$id" '.tasks[] | select(.id == $id) | .branch' "$TASK_REGISTRY")

      cat > "$worktree/TASK.md" << TASKEOF
# Task: $description

## Project
$(jq -r --arg id "$id" '.tasks[] | select(.id == $id) | .project' "$TASK_REGISTRY")

## Branch
$branch

## Instructions

The plan has been approved. Now implement it.

Read PLAN.md in this project root — it contains the detailed implementation plan you created earlier.
Follow the plan step by step and implement all the changes described.

## When done

1. Make sure all changes are committed
2. Run any relevant tests to verify your changes work
3. Push your branch and create a PR:
   - Write a clear, concise PR title that describes what you actually changed (do NOT just use the task description verbatim)
   - Write a PR body with a summary of what was done and why
   - Use: \`gh pr create --title "Your title" --body "Your description" --head $branch\`
   - Save the PR URL to a file: \`echo "https://github.com/..." > .task-pr-url\`
4. After the PR is created, create the done marker: \`touch .task-done\`

**Important:** The PR title should be a proper, descriptive title (e.g. "Add retry logic to API client" or "Fix race condition in session cleanup"), NOT a copy of the task prompt. The PR body should summarize the changes made.

This signals the task runner that you've completed the work.
TASKEOF

      # Update task status back to running
      local now tmp
      now=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
      tmp="$TASK_REGISTRY.tmp.$$"
      jq --arg id "$id" --arg now "$now" \
        '(.tasks[] | select(.id == $id)) |= (.status = "running" | .approved = $now)' \
        "$TASK_REGISTRY" > "$tmp" && mv "$tmp" "$TASK_REGISTRY"

      # Restart the Claude session with implementation prompt
      local prompt="Read the TASK.md file in this project root. It contains your task. The plan in PLAN.md has been approved — implement it now. Follow the instructions carefully. When you are completely done, run: touch .task-done"

      # Source secrets
      local env_prefix=""
      if [ -f "$SECRETS_FILE" ]; then
        env_prefix="set -a && source $SECRETS_FILE && set +a && "
      fi

      # Resolve yolo mode
      local project yolo=false claude_flags=""
      project=$(jq -r --arg id "$id" '.tasks[] | select(.id == $id) | .project' "$TASK_REGISTRY")
      if [ -n "$project" ] && [ -f "$CONFIG_DIR/projects/${project}.json" ]; then
        local config_yolo
        config_yolo=$(jq -r '.skip_permissions // false' "$CONFIG_DIR/projects/${project}.json")
        [ "$config_yolo" = "true" ] && yolo=true
      fi
      if [ "$yolo" = true ]; then
        claude_flags=" --dangerously-skip-permissions"
        ensure_claude_skip_prompt
      fi
      ensure_claude_trust "$worktree"

      # Kill the agent window and recreate with new prompt
      tmux kill-window -t "${session}:agent" 2>/dev/null || true
      sleep 1
      tmux new-window -t "$session" -n "agent" "${env_prefix}cd $worktree && claude${claude_flags} --prompt $(printf '%q' "$prompt")"

      log "Task #$id approved — restarted Claude with implementation prompt"
      ;;
    import)
      local file="" import_project_default="" import_from="" import_private=false import_plan=false dry_run=false
      shift 2  # skip "task import"

      while [[ $# -gt 0 ]]; do
        case "${1:-}" in
          --from) import_from="${2:-}"; shift 2 ;;
          --from=*) import_from="${1#*=}"; shift ;;
          --private) import_private=true; shift ;;
          --plan) import_plan=true; shift ;;
          --dry-run) dry_run=true; shift ;;
          --project) import_project_default="${2:-}"; shift 2 ;;
          --project=*) import_project_default="${1#*=}"; shift ;;
          *)
            if [ -z "$file" ]; then
              file="$1"
            fi
            shift
            ;;
        esac
      done

      [ -n "$file" ] || die "Usage: dev task import <file.csv> [--project <default-project>] [--from <base>] [--private] [--plan] [--dry-run]"
      [ -f "$file" ] || die "File not found: $file"

      local count=0 errors=0 line_num=0
      local first_line=true

      while IFS= read -r line || [ -n "$line" ]; do
        line_num=$((line_num + 1))

        # Skip empty lines and comments
        [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue

        # Detect and skip header row (first non-empty, non-comment line starting with "project")
        if [ "$first_line" = true ]; then
          first_line=false
          if echo "$line" | grep -qiE '^[[:space:]]*"?project"?[[:space:]]*,'; then
            continue
          fi
        fi

        # Parse CSV fields — handle optional quoting
        local fields=()
        local current="" in_quotes=false
        local i
        for (( i=0; i<${#line}; i++ )); do
          local char="${line:$i:1}"
          if [ "$char" = '"' ]; then
            if [ "$in_quotes" = true ]; then
              # Check for escaped quote (double-quote)
              if [ "${line:$((i+1)):1}" = '"' ]; then
                current+="$char"
                i=$((i + 1))
              else
                in_quotes=false
              fi
            else
              in_quotes=true
            fi
          elif [ "$char" = ',' ] && [ "$in_quotes" = false ]; then
            fields+=("$current")
            current=""
          else
            current+="$char"
          fi
        done
        fields+=("$current")

        # Trim whitespace from fields
        local trimmed_fields=()
        for f in "${fields[@]}"; do
          f="${f#"${f%%[![:space:]]*}"}"  # ltrim
          f="${f%"${f##*[![:space:]]}"}"  # rtrim
          trimmed_fields+=("$f")
        done

        local csv_project="${trimmed_fields[0]:-}"
        local csv_description="${trimmed_fields[1]:-}"
        local csv_branch="${trimmed_fields[2]:-}"
        local csv_from="${trimmed_fields[3]:-}"
        local csv_private="${trimmed_fields[4]:-}"
        local csv_mode="${trimmed_fields[5]:-}"

        # Apply defaults
        [ -z "$csv_project" ] && csv_project="$import_project_default"
        [ -z "$csv_from" ] && csv_from="$import_from"
        if [ "$import_private" = true ] && [ -z "$csv_private" ]; then
          csv_private="true"
        fi
        if [ "$import_plan" = true ] && [ -z "$csv_mode" ]; then
          csv_mode="plan"
        fi

        # Validate required fields
        if [ -z "$csv_project" ]; then
          warn "Line $line_num: missing project — skipping"
          errors=$((errors + 1))
          continue
        fi
        if [ -z "$csv_description" ]; then
          warn "Line $line_num: missing description — skipping"
          errors=$((errors + 1))
          continue
        fi

        # Validate project exists
        if [ ! -f "$CONFIG_DIR/projects/${csv_project}.json" ]; then
          warn "Line $line_num: project '$csv_project' not found — skipping"
          errors=$((errors + 1))
          continue
        fi

        # Auto-generate branch if not provided
        if [ -z "$csv_branch" ]; then
          local id_for_branch
          id_for_branch=$(jq -r '.next_id' "$TASK_REGISTRY")
          csv_branch="task-${id_for_branch}"
        fi

        # Normalize private field
        local is_private=false
        [[ "$csv_private" =~ ^(true|yes|1)$ ]] && is_private=true

        # Normalize mode field
        local task_mode="normal"
        [[ "$csv_mode" =~ ^(plan|true|yes|1)$ ]] && task_mode="plan"

        if [ "$dry_run" = true ]; then
          local mode_tag=""
          [ "$task_mode" = "plan" ] && mode_tag=" ${MAGENTA}[plan]${NC}"
          echo -e "  ${DIM}[dry-run]${NC} $csv_project/$csv_branch — $csv_description${mode_tag}"
          count=$((count + 1))
          continue
        fi

        # Add the task
        local id now tmp
        id=$(jq -r '.next_id' "$TASK_REGISTRY")
        now=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
        tmp="$TASK_REGISTRY.tmp.$$"

        jq --arg id "$id" --arg proj "$csv_project" --arg br "$csv_branch" \
           --arg desc "$csv_description" --arg now "$now" \
           --arg from "$csv_from" \
           --argjson private "$is_private" \
           --arg mode "$task_mode" \
          '.tasks += [{
            id: $id,
            project: $proj,
            branch: $br,
            description: $desc,
            from_branch: (if $from == "" then null else $from end),
            private: $private,
            mode: $mode,
            status: "pending",
            session: null,
            pr_url: null,
            created: $now,
            started: null,
            completed: null
          }] | .next_id = (.next_id + 1)' "$TASK_REGISTRY" > "$tmp" && mv "$tmp" "$TASK_REGISTRY"

        log "Task #$id added: $csv_project/$csv_branch — $csv_description"
        count=$((count + 1))
      done < "$file"

      echo ""
      if [ "$dry_run" = true ]; then
        info "Dry run: $count task(s) would be imported ($errors skipped)"
      else
        log "Imported $count task(s) from $file"
        [ "$errors" -gt 0 ] && warn "$errors line(s) skipped due to errors"
      fi
      ;;
    rm|remove)
      local id="${3:-}"
      [ -n "$id" ] || die "Usage: dev task rm <id>"

      # If the task has a session, kill it first
      local session
      session=$(jq -r --arg id "$id" '.tasks[] | select(.id == $id) | .session // empty' "$TASK_REGISTRY")
      if [ -n "$session" ] && jq -e --arg s "$session" '.[$s]' "$PORT_REGISTRY" &>/dev/null; then
        info "Killing session '$session' for task #$id..."
        cmd_kill "kill" "$session" || true
      fi

      local tmp="$TASK_REGISTRY.tmp.$$"
      jq --arg id "$id" '.tasks = [.tasks[] | select(.id != $id)]' "$TASK_REGISTRY" > "$tmp" \
        && mv "$tmp" "$TASK_REGISTRY"
      log "Task #$id removed"
      ;;
    run)
      info "Running task runner (single pass)..."
      exec dev-task-runner --once
      ;;
    watch)
      info "Starting task runner in watch mode..."
      exec dev-task-runner --watch
      ;;
    log|logs)
      local logfile="$LOG_DIR/task-runner.log"
      if [ -f "$logfile" ]; then
        tail -f "$logfile"
      else
        info "No task runner log yet."
      fi
      ;;
    *)
      echo "Usage: dev task <add|import|ls|approve|rm|prune|run|watch|log>"
      echo ""
      echo "  add <project> [branch] \"desc\" [--from <base>] [--plan]"
      echo "                                 Add a task to the queue"
      echo "                                 --plan creates plan first, waits for approval"
      echo "  import <file.csv> [--project <p>] [--from <base>] [--private] [--plan] [--dry-run]"
      echo "                                 Batch-import tasks from a CSV file"
      echo "  approve <id>                   Approve a plan-review task and start implementation"
      echo "  ls [--pending|--running|...]    List tasks (filter by status)"
      echo "  rm <id>                        Remove a task"
      echo "  prune [--failed|--all-finished] [--dry-run]"
      echo "                                 Remove completed tasks (default: done only)"
      echo "  run                            Run task runner (single pass)"
      echo "  watch                          Run task runner (watch mode)"
      echo "  log                            Tail the runner log"
      ;;
  esac
}

cmd_ask() {
  local project="${2:-}" prompt="" agent="claude" print_mode=false yolo=false
  shift 2 || true

  # Parse options
  while [[ $# -gt 0 ]]; do
    case "${1:-}" in
      --agent) agent="${2:-claude}"; shift 2 ;;
      --agent=*) agent="${1#*=}"; shift ;;
      --print) print_mode=true; shift ;;
      --yolo) yolo=true; shift ;;
      *)
        # Collect remaining args as the prompt
        if [ -z "$prompt" ]; then
          prompt="$1"
        else
          prompt="$prompt $1"
        fi
        shift
        ;;
    esac
  done

  [ -z "$project" ] && die "Usage: dev ask <project> [prompt] [--agent claude|codex] [--print] [--yolo]"

  local bare_dir="$PROJECTS_DIR/$project"
  [ -d "$bare_dir" ] || die "Project '$project' not found. Run 'dev setup $project <url>' first."

  # Resolve yolo from project config
  if [ "$yolo" != true ] && [ -f "$CONFIG_DIR/projects/${project}.json" ]; then
    local config_yolo
    config_yolo=$(jq -r '.skip_permissions // false' "$CONFIG_DIR/projects/${project}.json" 2>/dev/null)
    [ "$config_yolo" = "true" ] && yolo=true
  fi

  # Create a temporary worktree from the main branch
  local base_branch
  cd "$bare_dir"
  base_branch=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's|refs/remotes/origin/||' || echo "main")

  local slug
  slug="ask-$(random_slug)"
  local wt_dir="$PROJECTS_DIR/${project}-worktrees"
  local tmp_path="$wt_dir/.${slug}"
  local name="${USER}-${project}-${slug}"

  # Check for existing ask session
  [ -z "$(get_session "$name")" ] || die "Session '$name' already exists."

  mkdir -p "$wt_dir"
  info "Creating temporary worktree from $base_branch..."
  git fetch origin --prune 2>/dev/null || true
  git worktree add "$tmp_path" "origin/$base_branch" --detach 2>/dev/null \
    || die "Failed to create temporary worktree"

  log "Temporary worktree ready"

  # --print mode: run agent non-interactively, print result, clean up
  if [ "$print_mode" = true ] && [ -n "$prompt" ]; then
    if [[ "$agent" == *claude* ]]; then
      validate_claude_auth || true
    fi
    info "Asking Claude: $prompt"
    echo ""
    local env_prefix=""
    env_prefix=$(build_env_prefix)
    cd "$tmp_path"
    eval "${env_prefix}claude --print \"\$prompt\"" || true
    echo ""
    info "Cleaning up temporary worktree..."
    cd "$bare_dir"
    git worktree remove "$tmp_path" --force 2>/dev/null || true
    log "Done"
    return 0
  fi

  # Register in port registry (no slot or ports — lightweight session)
  local agents_json
  agents_json=$(echo "$agent" | jq -R . | jq -s .)
  (
    flock -x 200
    local tmp
    tmp=$(mktemp)
    jq --arg name "$name" \
       --arg project "$project" \
       --arg branch "$base_branch" \
       --arg agent "$agent" \
       --argjson agents "$agents_json" \
       --arg path "$tmp_path" \
       --arg owner "$USER" \
       --arg created "$(date -Iseconds)" \
       '.[$name] = {
          project: $project,
          branch: $branch,
          slot: 0,
          agent: $agent,
          agents: $agents,
          path: $path,
          owner: $owner,
          type: "ask",
          ports: {
            frontend: null,
            backend: null,
            supa_api: null,
            supa_db: null,
            supa_studio: null
          },
          created: $created
        }' "$PORT_REGISTRY" > "$tmp"
    mv -f "$tmp" "$PORT_REGISTRY"
    fix_registry_perms
  ) 200>"${PORT_REGISTRY}.lock"

  # Source secrets
  local env_prefix=""
  env_prefix=$(build_env_prefix)

  if [[ "$agent" == *claude* ]]; then
    validate_claude_auth || true
  fi

  # Build agent command
  local claude_flags=""
  if [ "$yolo" = true ]; then
    claude_flags=" --dangerously-skip-permissions"
    ensure_claude_skip_prompt
  fi

  ensure_claude_trust "$tmp_path"

  local agent_cmd
  case "$agent" in
    claude)
      if [ -n "$prompt" ]; then
        agent_cmd="cd $tmp_path && claude${claude_flags} \"$prompt\""
      else
        agent_cmd="cd $tmp_path && claude${claude_flags}"
      fi
      ;;
    codex)
      agent_cmd="cd $tmp_path && codex"
      ;;
    *)
      die "Unknown agent: $agent. Use claude or codex."
      ;;
  esac

  # Create tmux session with agent only (no shell window for ask sessions)
  tmux new-session -d -s "$name" -n "agent" "${env_prefix}${agent_cmd}"

  log "Ask session '$name' is running!"
  echo ""
  echo -e "  ${BOLD}Session:${NC}  $name"
  echo -e "  ${BOLD}Agent:${NC}    $agent"
  echo -e "  ${BOLD}Project:${NC}  $project ($base_branch)"
  echo -e "  ${BOLD}Type:${NC}     ask ${DIM}(read-only, no ports)${NC}"
  echo ""
  echo -e "  ${DIM}Attach:    dev attach $name${NC}"
  echo -e "  ${DIM}Kill:      dev kill $name${NC}"
  echo ""
}

cmd_ghost() {
  local agent="claude" yolo=false name_suffix="" prompt=""
  shift || true

  # Parse options
  while [[ $# -gt 0 ]]; do
    case "${1:-}" in
      --agent) agent="${2:-claude}"; shift 2 ;;
      --agent=*) agent="${1#*=}"; shift ;;
      --yolo) yolo=true; shift ;;
      --name) name_suffix="${2:-}"; shift 2 ;;
      --name=*) name_suffix="${1#*=}"; shift ;;
      *)
        if [ -z "$prompt" ]; then
          prompt="$1"
        else
          prompt="$prompt $1"
        fi
        shift
        ;;
    esac
  done

  # Generate session name
  if [ -n "$name_suffix" ]; then
    local slug
    slug=$(slugify "$name_suffix")
    local name="${USER}-ghost-${slug}"
  else
    local name="${USER}-ghost-$(random_slug)"
  fi

  # Check for existing session with same name
  [ -z "$(get_session "$name")" ] || die "Session '$name' already exists."

  # Create a persistent working directory (no repo)
  local ghost_dir="$HOME/ghost/${name}"
  mkdir -p "$ghost_dir"

  # Symlink configured directories into ghost dir
  local linked_dirs
  linked_dirs=$(jq -r '.ghost.linked_dirs // [] | .[]' "$GLOBAL_CONFIG" 2>/dev/null || true)
  while IFS= read -r dir; do
    [ -z "$dir" ] && continue
    # Expand ~ to $HOME
    dir="${dir/#\~/$HOME}"
    local base
    base=$(basename "$dir")
    if [ -d "$dir" ] && [ ! -e "$ghost_dir/$base" ]; then
      ln -s "$dir" "$ghost_dir/$base"
    fi
  done <<< "$linked_dirs"

  # Register in port registry (no slot, no ports, no project)
  local agents_json
  agents_json=$(echo "$agent" | jq -R . | jq -s .)
  (
    flock -x 200
    local tmp
    tmp=$(mktemp)
    jq --arg name "$name" \
       --arg agent "$agent" \
       --argjson agents "$agents_json" \
       --arg path "$ghost_dir" \
       --arg owner "$USER" \
       --arg created "$(date -Iseconds)" \
       '.[$name] = {
          project: "ghost",
          branch: "none",
          slot: 0,
          agent: $agent,
          agents: $agents,
          path: $path,
          owner: $owner,
          type: "ghost",
          ports: {
            frontend: null,
            backend: null,
            supa_api: null,
            supa_db: null,
            supa_studio: null
          },
          created: $created
        }' "$PORT_REGISTRY" > "$tmp"
    mv -f "$tmp" "$PORT_REGISTRY"
    fix_registry_perms
  ) 200>"${PORT_REGISTRY}.lock"

  # Source secrets
  local env_prefix=""
  env_prefix=$(build_env_prefix)

  if [[ "$agent" == *claude* ]]; then
    validate_claude_auth || true
  fi

  # Build agent command
  local claude_flags=""
  if [ "$yolo" = true ]; then
    claude_flags=" --dangerously-skip-permissions"
    ensure_claude_skip_prompt
  fi

  ensure_claude_trust "$ghost_dir"

  local agent_cmd
  case "$agent" in
    claude)
      if [ -n "$prompt" ]; then
        agent_cmd="cd $ghost_dir && claude${claude_flags} \"$prompt\""
      else
        agent_cmd="cd $ghost_dir && claude${claude_flags}"
      fi
      ;;
    codex)
      agent_cmd="cd $ghost_dir && codex"
      ;;
    none)
      agent_cmd="cd $ghost_dir && echo 'Ready. No agent started.' && bash"
      ;;
    *)
      die "Unknown agent: $agent. Use claude, codex, or none."
      ;;
  esac

  # Create tmux session with agent only (no shell window for ghost sessions)
  tmux new-session -d -s "$name" -n "agent" "${env_prefix}${agent_cmd}"

  log "Ghost session '$name' is running!"
  random_celebration
  echo ""
  echo -e "  ${BOLD}Session:${NC}  $name"
  echo -e "  ${BOLD}Agent:${NC}    $agent"
  echo -e "  ${BOLD}Type:${NC}     ghost ${DIM}(no project, no ports)${NC}"
  echo -e "  ${BOLD}Path:${NC}     $ghost_dir"
  echo ""
  echo -e "  ${DIM}Attach:    dev attach $name${NC}"
  echo -e "  ${DIM}Kill:      dev kill $name${NC}"
  echo ""
}

cmd_scaffold() {
  local name="${2:-}" agent="claude" yolo=false attach=false prompt="" remote=""
  shift || true
  shift || true

  # Parse options
  while [[ $# -gt 0 ]]; do
    case "${1:-}" in
      --agent) agent="${2:-claude}"; shift 2 ;;
      --agent=*) agent="${1#*=}"; shift ;;
      --yolo) yolo=true; shift ;;
      --attach) attach=true; shift ;;
      --remote) remote="${2:-}"; shift 2 ;;
      --remote=*) remote="${1#*=}"; shift ;;
      --prompt) prompt="${2:-}"; shift 2 ;;
      --prompt=*) prompt="${1#*=}"; shift ;;
      *)
        if [ -z "$prompt" ]; then
          prompt="$1"
        else
          prompt="$prompt $1"
        fi
        shift
        ;;
    esac
  done

  [ -z "$name" ] && die "Usage: dev scaffold <name> [--agent claude|codex|none] [--yolo] [--attach] [--remote <git-url>] [--prompt \"...\"]"

  # Sanitize name
  name=$(echo "$name" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9-]/-/g' | sed 's/--*/-/g' | sed 's/^-//;s/-$//')
  [ -z "$name" ] && die "Invalid project name"

  local session_name="${USER}-scaffold-${name}"
  local scaffold_dir="$PROJECTS_DIR/$name"

  # Validate
  [ -z "$(get_session "$session_name")" ] || die "Session '$session_name' already exists."
  [ -d "$scaffold_dir" ] && die "Directory '$scaffold_dir' already exists. Choose a different name or remove it."

  # Create project directory and init git
  mkdir -p "$scaffold_dir"
  cd "$scaffold_dir"
  git init --initial-branch=main
  log "Initialized git repo at $scaffold_dir"

  # Add remote if provided
  if [ -n "$remote" ]; then
    git remote add origin "$remote"
    log "Added remote: $remote"
  fi

  # Allocate slot
  local slot
  slot=$(find_free_slot)
  info "Allocated slot $slot for $session_name"

  # Calculate ports
  local ports
  ports=$(slot_ports "$slot")
  read -r wt_frontend wt_backend wt_supa_api wt_supa_db wt_supa_studio <<< "$ports"

  # Register in port registry
  local agents_json
  agents_json=$(echo "$agent" | tr ',' '\n' | jq -R . | jq -s .)
  (
    flock -x 200
    local tmp
    tmp=$(mktemp)
    jq --arg name "$session_name" \
       --arg project "$name" \
       --arg agent "$agent" \
       --argjson agents "$agents_json" \
       --argjson slot "$slot" \
       --arg path "$scaffold_dir" \
       --arg owner "$USER" \
       --argjson frontend "$wt_frontend" \
       --argjson backend "$wt_backend" \
       --argjson supa_api "$wt_supa_api" \
       --argjson supa_db "$wt_supa_db" \
       --argjson supa_studio "$wt_supa_studio" \
       --arg created "$(date -Iseconds)" \
       '.[$name] = {
          project: $project,
          branch: "main",
          slot: $slot,
          agent: $agent,
          agents: $agents,
          path: $path,
          owner: $owner,
          type: "scaffold",
          ports: {
            frontend: $frontend,
            backend: $backend,
            supa_api: $supa_api,
            supa_db: $supa_db,
            supa_studio: $supa_studio
          },
          created: $created
        }' "$PORT_REGISTRY" > "$tmp"
    mv -f "$tmp" "$PORT_REGISTRY"
    fix_registry_perms
  ) 200>"${PORT_REGISTRY}.lock"

  # Source secrets
  local env_prefix=""
  if [ -f "$SECRETS_FILE" ]; then
    env_prefix="set -a && source $SECRETS_FILE && set +a && "
  fi

  # Build agent command
  local claude_flags=""
  if [ "$yolo" = true ]; then
    claude_flags=" --dangerously-skip-permissions"
    ensure_claude_skip_prompt
  fi

  ensure_claude_trust "$scaffold_dir"

  local agent_cmd
  local prompt_arg=""
  if [ -n "$prompt" ]; then
    local escaped_prompt="${prompt//\\/\\\\}"
    escaped_prompt="${escaped_prompt//\$/\\\$}"
    escaped_prompt="${escaped_prompt//\`/\\\`}"
    escaped_prompt="${escaped_prompt//\"/\\\"}"
    prompt_arg=" \"${escaped_prompt}\""
  fi

  local primary_agent
  primary_agent=$(echo "$agent" | cut -d',' -f1)

  case "$primary_agent" in
    claude)
      agent_cmd="cd $scaffold_dir && claude${claude_flags}${prompt_arg}"
      ;;
    codex)
      agent_cmd="cd $scaffold_dir && codex${prompt_arg}"
      ;;
    none)
      agent_cmd="cd $scaffold_dir && echo 'Ready. No agent started.' && bash"
      ;;
    *)
      die "Unknown agent: $primary_agent. Use claude, codex, or none."
      ;;
  esac

  # Set port env vars on tmux session
  local ip
  ip=$(get_ip)

  # Create tmux session with windows
  create_tmux_windows "$session_name" "scaffold" "$scaffold_dir" "$env_prefix" "$agent_cmd" "" "$wt_frontend" "$wt_backend" "$ip"

  # Add extra agent windows for dual-agent mode
  local IFS_BAK="$IFS"
  IFS=',' read -ra agent_list <<< "$agent"
  IFS="$IFS_BAK"
  if [ ${#agent_list[@]} -gt 1 ]; then
    for extra_agent in "${agent_list[@]:1}"; do
      local extra_cmd
      case "$extra_agent" in
        claude) extra_cmd="cd $scaffold_dir && claude${claude_flags}" ;;
        codex)  extra_cmd="cd $scaffold_dir && codex" ;;
        *)      warn "Unknown agent '$extra_agent', skipping"; continue ;;
      esac
      tmux new-window -t "$session_name" -n "agent-${extra_agent}" "${env_prefix}${extra_cmd}"
      info "Added agent window: agent-${extra_agent}"
    done
  fi

  [ "$wt_frontend" != "null" ] && tmux set-environment -t "$session_name" DEV_FRONTEND_PORT "$wt_frontend"
  [ "$wt_backend" != "null" ] && tmux set-environment -t "$session_name" DEV_BACKEND_PORT "$wt_backend"
  tmux set-environment -t "$session_name" DEV_SLOT "$slot"

  log "Scaffold session '$session_name' is running!"
  random_celebration
  echo ""
  echo -e "  ${BOLD}Session:${NC}  $session_name"
  echo -e "  ${BOLD}Agent(s):${NC} $agent"
  echo -e "  ${BOLD}Type:${NC}     scaffold ${DIM}(new project, no worktree)${NC}"
  echo -e "  ${BOLD}Path:${NC}     $scaffold_dir"
  echo -e "  ${BOLD}Frontend:${NC} http://$ip:$wt_frontend"
  echo -e "  ${BOLD}Backend:${NC}  http://$ip:$wt_backend"
  if [ -n "$remote" ]; then
    echo -e "  ${BOLD}Remote:${NC}   $remote"
  fi
  echo ""
  echo -e "  ${DIM}Attach:    dev attach $session_name${NC}"
  echo -e "  ${DIM}Kill:      dev kill $session_name${NC}"
  if [ -z "$remote" ]; then
    echo -e "  ${DIM}Add remote: cd $scaffold_dir && git remote add origin <url>${NC}"
  fi
  echo ""

  if [ "$attach" = true ]; then
    tmux attach-session -t "$session_name"
  fi
}

cmd_review() {
  local session_or_pr="${2:-}" yolo=false fix="" local_project=""
  shift || true
  shift || true

  # Parse options
  while [[ $# -gt 0 ]]; do
    case "${1:-}" in
      --yolo) yolo=true; shift ;;
      --fix) fix=true; shift ;;
      --no-fix) fix=false; shift ;;
      --project) local_project="${2:-}"; shift 2 ;;
      *) shift ;;
    esac
  done

  [ -z "$session_or_pr" ] && die "Usage: dev review <session|pr-url> [--yolo] [--fix|--no-fix] [--project <local-project>]"

  # Resolve auto_fix from global config if not set by flag
  if [ -z "$fix" ]; then
    fix=$(get_config_value '.review.auto_fix' 'false')
  fi

  local pr_url="" project="" branch="" worktree=""

  # Check if argument is a PR URL
  if [[ "$session_or_pr" == http* ]]; then
    pr_url="$session_or_pr"
    # Extract project and branch from the PR
    project=$(gh pr view "$pr_url" --json headRepository --jq '.headRepository.name' 2>/dev/null) \
      || die "Could not fetch PR info from $pr_url"
    branch=$(gh pr view "$pr_url" --json headRefName --jq '.headRefName' 2>/dev/null) \
      || die "Could not fetch branch from $pr_url"
    # Allow overriding the local project name (e.g. GitHub repo is 'dev-cli' but local project is 'cli')
    [ -n "$local_project" ] && project="$local_project"
  else
    # Argument is a session name — resolve it
    local match
    match=$(jq -r "keys[] | select(contains(\"$session_or_pr\"))" "$PORT_REGISTRY" | head -1)
    [ -z "$match" ] && die "No session matching '$session_or_pr'"

    project=$(get_session_field "$match" "project")
    branch=$(get_session_field "$match" "branch")
    worktree=$(get_session_field "$match" "path")

    # Try to find the PR for this branch
    pr_url=$(cd "$worktree" && gh pr view "$branch" --json url --jq '.url' 2>/dev/null) || true
    [ -z "$pr_url" ] && die "No PR found for branch '$branch'. Push and create a PR first."
  fi

  local bare_dir="$PROJECTS_DIR/$project"
  [ -d "$bare_dir" ] || die "Project '$project' not found."

  # Resolve yolo from project config
  if [ "$yolo" != true ] && [ -f "$CONFIG_DIR/projects/${project}.json" ]; then
    local config_yolo
    config_yolo=$(jq -r '.skip_permissions // false' "$CONFIG_DIR/projects/${project}.json" 2>/dev/null)
    [ "$config_yolo" = "true" ] && yolo=true
  fi

  # Create a temporary worktree on the PR branch
  local ts
  ts=$(date +%s)
  local wt_dir="$PROJECTS_DIR/${project}-worktrees"
  local tmp_path="$wt_dir/.review-${ts}"
  local slug
  slug=$(slugify "$branch")
  local name="${USER}-${project}-review-${slug}"

  # Check for existing review session
  [ -z "$(get_session "$name")" ] || die "Review session '$name' already exists."

  mkdir -p "$wt_dir"
  info "Creating review worktree for branch '$branch'..."
  cd "$bare_dir"
  git fetch origin --prune 2>/dev/null || true
  git worktree add "$tmp_path" "origin/$branch" --detach 2>/dev/null \
    || die "Failed to create review worktree"

  # Register in port registry (no slot or ports — lightweight review session)
  local agents_json='["claude"]'
  (
    flock -x 200
    local tmp
    tmp=$(mktemp)
    jq --arg name "$name" \
       --arg project "$project" \
       --arg branch "$branch" \
       --arg path "$tmp_path" \
       --arg owner "$USER" \
       --arg pr_url "$pr_url" \
       --arg created "$(date -Iseconds)" \
       '.[$name] = {
          project: $project,
          branch: $branch,
          slot: 0,
          agent: "claude",
          agents: ["claude"],
          path: $path,
          owner: $owner,
          type: "review",
          pr_url: $pr_url,
          ports: {
            frontend: null,
            backend: null,
            supa_api: null,
            supa_db: null,
            supa_studio: null
          },
          created: $created
        }' "$PORT_REGISTRY" > "$tmp"
    mv -f "$tmp" "$PORT_REGISTRY"
    fix_registry_perms
  ) 200>"${PORT_REGISTRY}.lock"

  # Source secrets
  local env_prefix=""
  env_prefix=$(build_env_prefix)

  validate_claude_auth || true

  # Build agent command
  local claude_flags=""
  if [ "$yolo" = true ]; then
    claude_flags=" --dangerously-skip-permissions"
    ensure_claude_skip_prompt
  fi

  ensure_claude_trust "$tmp_path"

  # Load review prompt
  local prompt_file=""
  if [ -f "$CONFIG_DIR/prompts/pr-review.md" ]; then
    prompt_file="$CONFIG_DIR/prompts/pr-review.md"
  elif [ -f "$(dirname "$(readlink -f "$0")")/../prompts/pr-review.md" ]; then
    prompt_file="$(dirname "$(readlink -f "$0")")/../prompts/pr-review.md"
  fi

  # Build fix suffix for the agent prompt
  local fix_instruction=""
  if [ "$fix" = "true" ]; then
    fix_instruction=" After submitting your review, fix any issues you found: create a new branch off the PR branch, commit your fixes, push, and open a pull request targeting the original PR branch so the fixes can be merged in."
  fi

  local agent_cmd
  if [ -n "$prompt_file" ]; then
    # Copy prompt into the review worktree so Claude can read it
    cp "$prompt_file" "$tmp_path/.review-prompt.md"
    agent_cmd="cd $tmp_path && claude${claude_flags} \"Read .review-prompt.md and follow the instructions to review this PR. The PR URL is: $pr_url.${fix_instruction}\""
  else
    agent_cmd="cd $tmp_path && claude${claude_flags} \"Review the PR at $pr_url. Run gh pr diff to see changes, run pnpm lint if available, check for code quality issues, slop comments, performance problems, and security concerns. Submit your review using gh pr review --comment.${fix_instruction} When done, run: touch .review-done\""
  fi

  # Create tmux session
  tmux new-session -d -s "$name" -n "agent" "${env_prefix}${agent_cmd}"
  tmux new-window -t "$name" -n "shell" "cd $tmp_path && bash"
  tmux select-window -t "$name:agent"

  log "Review session '$name' is running!"
  echo ""
  echo -e "  ${BOLD}Session:${NC}  $name"
  echo -e "  ${BOLD}Agent:${NC}    claude"
  echo -e "  ${BOLD}Project:${NC}  $project"
  echo -e "  ${BOLD}Branch:${NC}   $branch"
  echo -e "  ${BOLD}PR:${NC}       $pr_url"
  local fix_label="review only"
  [ "$fix" = "true" ] && fix_label="review + fix PR"
  echo -e "  ${BOLD}Type:${NC}     review ${DIM}(no ports — $fix_label)${NC}"
  echo ""
  echo -e "  ${DIM}Attach:    dev attach $name${NC}"
  echo -e "  ${DIM}Kill:      dev kill $name${NC}"
  echo ""
}

cmd_linear() {
  local subcmd="${2:-status}"

  case "$subcmd" in
    setup)
      echo ""
      echo -e "  ${BOLD}${CYAN}Linear Integration Setup${NC}"
      echo ""

      # API Key
      local cur_key
      cur_key=$(jq -r '.linear.api_key // empty' "$GLOBAL_CONFIG" 2>/dev/null)
      if [ -n "$cur_key" ]; then
        echo -e "  Current API key: ${DIM}${cur_key:0:12}...${NC}"
        read -rp "  Linear API key (Enter to keep existing): " api_key
        api_key="${api_key:-$cur_key}"
      else
        read -rp "  Linear API key (lin_api_...): " api_key
      fi
      [ -n "$api_key" ] || die "API key is required"

      # Auto-detect Linear user
      local detected_user_id detected_user_name user_id cur_user_id
      cur_user_id=$(jq -r '.linear.user_id // empty' "$GLOBAL_CONFIG" 2>/dev/null)
      echo ""
      echo -e "  ${DIM}Detecting your Linear user...${NC}"
      local viewer_query viewer_response
      viewer_query='{"query":"{ viewer { id name } }"}'
      viewer_response=$(curl -s -X POST "https://api.linear.app/graphql" \
        -H "Content-Type: application/json" \
        -H "Authorization: $api_key" \
        -d "$viewer_query" 2>/dev/null) || viewer_response=""
      detected_user_id=$(echo "$viewer_response" | jq -r '.data.viewer.id // empty' 2>/dev/null)
      detected_user_name=$(echo "$viewer_response" | jq -r '.data.viewer.name // empty' 2>/dev/null)

      if [ -n "$detected_user_id" ]; then
        echo -e "  Detected as: ${BOLD}${detected_user_name}${NC} (${DIM}${detected_user_id}${NC})"
        read -rp "  Use this user ID to filter issues? [Y/n]: " use_detected
        if [[ "$use_detected" =~ ^[Nn]$ ]]; then
          local prompt_uid="  Linear user ID"
          [ -n "$cur_user_id" ] && prompt_uid+=" [${cur_user_id}]"
          read -rp "${prompt_uid}: " user_id
          user_id="${user_id:-$cur_user_id}"
          [ -n "$user_id" ] || die "User ID is required"
        else
          user_id="$detected_user_id"
        fi
      else
        echo -e "  ${YELLOW}Could not auto-detect user (check API key or network).${NC}"
        local prompt_uid="  Linear user ID (UUID)"
        [ -n "$cur_user_id" ] && prompt_uid+=" [${cur_user_id}]"
        read -rp "${prompt_uid}: " user_id
        user_id="${user_id:-$cur_user_id}"
        [ -n "$user_id" ] || die "User ID is required"
      fi

      # Team ID
      local cur_team
      cur_team=$(jq -r '.linear.team_id // empty' "$GLOBAL_CONFIG" 2>/dev/null)
      if [ -n "$cur_team" ]; then
        read -rp "  Team ID [${cur_team}]: " team_id
        team_id="${team_id:-$cur_team}"
      else
        read -rp "  Team ID (UUID from Linear settings): " team_id
      fi
      [ -n "$team_id" ] || die "Team ID is required"

      # Label name
      local cur_label
      cur_label=$(jq -r '.linear.label_name // "auto-agent"' "$GLOBAL_CONFIG" 2>/dev/null)
      read -rp "  Label name to watch [${cur_label}]: " label_name
      label_name="${label_name:-$cur_label}"

      # Default project
      local cur_project
      cur_project=$(jq -r '.linear.default_project // empty' "$GLOBAL_CONFIG" 2>/dev/null)
      if [ -n "$cur_project" ]; then
        echo -e "  Current default project: ${DIM}${cur_project}${NC}"
      fi
      echo ""
      echo -e "  ${DIM}Available projects:${NC}"
      ls "$CONFIG_DIR/projects/" 2>/dev/null | sed 's/\.json$//' | while read -r p; do
        echo -e "    ${DIM}•${NC} $p"
      done
      echo ""
      local prompt_proj="  Default dev-cli project"
      [ -n "$cur_project" ] && prompt_proj+=" [${cur_project}]"
      read -rp "${prompt_proj}: " default_project
      default_project="${default_project:-$cur_project}"
      [ -n "$default_project" ] || die "Default project is required"

      # Validate project exists
      [ -f "$CONFIG_DIR/projects/${default_project}.json" ] \
        || die "Project '${default_project}' not found. Run 'dev setup' first."

      # Base branch
      local cur_from
      cur_from=$(jq -r '.linear.default_from_branch // "main"' "$GLOBAL_CONFIG" 2>/dev/null)
      read -rp "  Base branch [${cur_from}]: " from_branch
      from_branch="${from_branch:-$cur_from}"

      # Poll interval
      local cur_interval
      cur_interval=$(jq -r '.linear.poll_interval_seconds // 90' "$GLOBAL_CONFIG" 2>/dev/null)
      read -rp "  Poll interval in seconds [${cur_interval}]: " poll_interval
      poll_interval="${poll_interval:-$cur_interval}"

      # MCP enabled
      local cur_mcp
      cur_mcp=$(jq -r '.linear.mcp_enabled // false' "$GLOBAL_CONFIG" 2>/dev/null)
      read -rp "  Inject Linear MCP into worktrees? [y/N] (currently: ${cur_mcp}): " mcp_yn
      local mcp_enabled=false
      [[ "$mcp_yn" =~ ^[Yy]$ ]] && mcp_enabled=true

      # Project map (optional)
      echo ""
      echo -e "  ${DIM}Project mapping: Linear project name → dev-cli project${NC}"
      echo -e "  ${DIM}Press Enter to skip (uses default project for all issues)${NC}"
      local project_map="{}"
      while true; do
        read -rp "  Linear project name (blank to finish): " lp_name
        [ -n "$lp_name" ] || break
        read -rp "  → dev-cli project: " dp_name
        [ -n "$dp_name" ] || break
        project_map=$(echo "$project_map" | jq --arg k "$lp_name" --arg v "$dp_name" '.[$k] = $v')
      done

      # State name configuration (optional)
      echo ""
      echo -e "  ${DIM}State name configuration (optional — press Enter to skip each)${NC}"

      local cur_filter_state cur_in_review cur_blocked cur_ready
      cur_filter_state=$(jq -r '.linear.filter_by_state_name // empty' "$GLOBAL_CONFIG" 2>/dev/null)
      cur_in_review=$(jq -r '.linear.state_in_review // empty' "$GLOBAL_CONFIG" 2>/dev/null)
      cur_blocked=$(jq -r '.linear.state_blocked // empty' "$GLOBAL_CONFIG" 2>/dev/null)
      cur_ready=$(jq -r '.linear.state_ready // empty' "$GLOBAL_CONFIG" 2>/dev/null)

      local prompt_filter="  Filter issues by Linear state name (blank = use label+type filter)"
      [ -n "$cur_filter_state" ] && prompt_filter+=" [${cur_filter_state}]"
      read -rp "${prompt_filter}: " filter_state_name
      filter_state_name="${filter_state_name:-$cur_filter_state}"

      local prompt_review="  State name for \"In Review\" (blank to skip)"
      [ -n "$cur_in_review" ] && prompt_review+=" [${cur_in_review}]"
      read -rp "${prompt_review}: " state_in_review
      state_in_review="${state_in_review:-$cur_in_review}"

      local prompt_blocked="  State name for \"Blocked\" (blank to skip)"
      [ -n "$cur_blocked" ] && prompt_blocked+=" [${cur_blocked}]"
      read -rp "${prompt_blocked}: " state_blocked
      state_blocked="${state_blocked:-$cur_blocked}"

      local prompt_ready="  State name to re-queue failed tasks (blank = first unstarted state)"
      [ -n "$cur_ready" ] && prompt_ready+=" [${cur_ready}]"
      read -rp "${prompt_ready}: " state_ready
      state_ready="${state_ready:-$cur_ready}"

      # Write config
      local tmp="$GLOBAL_CONFIG.tmp.$$"
      jq --arg key "$api_key" \
         --arg uid "$user_id" \
         --arg team "$team_id" \
         --arg label "$label_name" \
         --arg proj "$default_project" \
         --arg from "$from_branch" \
         --argjson interval "$poll_interval" \
         --argjson mcp "$mcp_enabled" \
         --argjson pmap "$project_map" \
         --arg filter_state "$filter_state_name" \
         --arg in_review "$state_in_review" \
         --arg blocked "$state_blocked" \
         --arg ready "$state_ready" \
        '.linear = {
          api_key: $key,
          user_id: $uid,
          team_id: $team,
          label_name: $label,
          default_project: $proj,
          default_from_branch: $from,
          poll_interval_seconds: $interval,
          default_mode: "normal",
          mcp_enabled: $mcp,
          project_map: $pmap,
          filter_by_state_name: $filter_state,
          state_in_review: $in_review,
          state_blocked: $blocked,
          state_ready: $ready
        }' "$GLOBAL_CONFIG" > "$tmp" && mv "$tmp" "$GLOBAL_CONFIG"

      echo ""
      log "Linear integration configured."
      info "Test connectivity with: dev linear test"
      info "Start polling with:     dev linear watch"
      echo ""
      ;;

    sync)
      local dry_flag=""
      [ "${3:-}" = "--dry-run" ] && dry_flag="--dry-run"
      info "Running Linear sync..."
      dev-linear --once $dry_flag
      ;;

    watch)
      info "Starting Linear daemon (foreground)..."
      info "Press Ctrl+C to stop."
      echo ""
      dev-linear --watch
      ;;

    status)
      echo ""
      echo -e "  ${BOLD}${CYAN}Linear Integration${NC}"
      echo ""

      if ! jq -e '.linear' "$GLOBAL_CONFIG" &>/dev/null; then
        echo -e "  ${YELLOW}Not configured.${NC} Run: dev linear setup"
        echo ""
        return
      fi

      local api_key user_id team_id label_name default_project poll_interval mcp_enabled
      local filter_state in_review_state blocked_state ready_state
      api_key=$(jq -r '.linear.api_key // ""' "$GLOBAL_CONFIG")
      user_id=$(jq -r '.linear.user_id // ""' "$GLOBAL_CONFIG")
      team_id=$(jq -r '.linear.team_id // ""' "$GLOBAL_CONFIG")
      label_name=$(jq -r '.linear.label_name // "auto-agent"' "$GLOBAL_CONFIG")
      default_project=$(jq -r '.linear.default_project // ""' "$GLOBAL_CONFIG")
      poll_interval=$(jq -r '.linear.poll_interval_seconds // 90' "$GLOBAL_CONFIG")
      mcp_enabled=$(jq -r '.linear.mcp_enabled // false' "$GLOBAL_CONFIG")
      filter_state=$(jq -r '.linear.filter_by_state_name // empty' "$GLOBAL_CONFIG")
      in_review_state=$(jq -r '.linear.state_in_review // empty' "$GLOBAL_CONFIG")
      blocked_state=$(jq -r '.linear.state_blocked // empty' "$GLOBAL_CONFIG")
      ready_state=$(jq -r '.linear.state_ready // empty' "$GLOBAL_CONFIG")

      echo -e "  ${BOLD}Config:${NC}"
      echo -e "    API key:         ${DIM}${api_key:0:12}...${NC}"
      echo -e "    User filter:     $user_id"
      echo -e "    Team ID:         $team_id"
      echo -e "    Label:           $label_name"
      echo -e "    Default project: $default_project"
      echo -e "    Poll interval:   ${poll_interval}s"
      echo -e "    MCP enabled:     $mcp_enabled"
      local state_filter_display
      [ -n "$filter_state" ] && state_filter_display="$filter_state" || state_filter_display="(label+type)"
      echo -e "    State filter:    $state_filter_display"
      [ -n "$in_review_state" ] && echo -e "    In Review state: $in_review_state"
      [ -n "$blocked_state" ]   && echo -e "    Blocked state:   $blocked_state"
      [ -n "$ready_state" ]     && echo -e "    Ready state:     $ready_state"
      echo ""

      if [ -f "$CONFIG_DIR/linear-state.json" ]; then
        local last_sync issue_count last_error
        last_sync=$(jq -r '.last_sync // "never"' "$CONFIG_DIR/linear-state.json")
        issue_count=$(jq '.issue_to_task | length' "$CONFIG_DIR/linear-state.json")
        last_error=$(jq -r '.last_error // empty' "$CONFIG_DIR/linear-state.json")

        echo -e "  ${BOLD}State:${NC}"
        echo -e "    Last sync:       $last_sync"
        echo -e "    Issues tracked:  $issue_count"
        if [ -n "$last_error" ]; then
          echo -e "    Last error:      ${RED}$last_error${NC}"
        fi
        echo ""
      else
        echo -e "  ${DIM}No sync state yet. Run: dev linear sync${NC}"
        echo ""
      fi
      ;;

    log)
      local log_file="$CONFIG_DIR/logs/linear.log"
      if [ ! -f "$log_file" ]; then
        info "No log file yet. Run: dev linear sync"
        return
      fi
      tail -f "$log_file"
      ;;

    test)
      local api_key team_id
      api_key=$(jq -r '.linear.api_key // empty' "$GLOBAL_CONFIG" 2>/dev/null)
      team_id=$(jq -r '.linear.team_id // empty' "$GLOBAL_CONFIG" 2>/dev/null)

      [ -n "$api_key" ] || die "Linear not configured. Run: dev linear setup"
      [ -n "$team_id" ] || die "Linear not configured. Run: dev linear setup"

      info "Testing Linear API connectivity..."

      local query response
      query=$(jq -n --arg team_id "$team_id" \
        '{"query": "{ team(id: \"\($team_id)\") { name } }"}')

      response=$(curl -s -X POST "https://api.linear.app/graphql" \
        -H "Content-Type: application/json" \
        -H "Authorization: $api_key" \
        -d "$query" 2>&1) || die "curl failed: $response"

      local errors team_name
      errors=$(echo "$response" | jq -r '.errors // empty' 2>/dev/null)
      team_name=$(echo "$response" | jq -r '.data.team.name // empty' 2>/dev/null)

      if [ -n "$errors" ] && [ "$errors" != "null" ]; then
        die "API error: $errors"
      fi

      if [ -n "$team_name" ]; then
        log "Connected to Linear team: $team_name"
        info "API key and team ID are valid."
      else
        die "Unexpected response: $response"
      fi
      ;;

    *)
      echo "Usage: dev linear <setup|sync|watch|status|log|test>"
      echo ""
      echo "  setup   Interactive configuration wizard"
      echo "  sync    Run one sync pass (fetch new issues + update Linear statuses)"
      echo "  watch   Run polling daemon in foreground"
      echo "  status  Show configuration and last sync info"
      echo "  log     Tail the Linear daemon log"
      echo "  test    Test API key and team ID connectivity"
      ;;
  esac
}

cmd_vibes() {
  local arts=(
    "
    ${CYAN}    ╔══════════════════════════════════╗
    ║   ${BOLD}🤖 AGENTS ARE CODING 🤖${NC}${CYAN}        ║
    ║                                  ║
    ║   ${NC}${DIM}While you sleep, they ship.${NC}${CYAN}     ║
    ║   ${NC}${DIM}While you eat, they commit.${NC}${CYAN}    ║
    ║   ${NC}${DIM}While you dream, they deploy.${NC}${CYAN}  ║
    ║                                  ║
    ╚══════════════════════════════════╝${NC}"
    "
    ${GREEN}        _______________
       /               \\
      |  $ dev new ...  |
      |  ${DIM}spawning agent${NC}${GREEN} |
       \\_____   _______/
             | /
         ${NC}${BOLD}(•_•)${NC}${GREEN}
         ${NC}${BOLD}<)  )╯${NC}  ${DIM}ship it!${NC}
         ${NC}${BOLD} /  \\${NC}"
    "
    ${YELLOW}  ┌─────────────────────────────┐
  │                             │
  │   ${NC}${BOLD}TODAY'S VIBE:${NC}${YELLOW}              │
  │                             │
  │   ${NC}Let the machines handle${YELLOW}    │
  │   ${NC}the boring stuff.${YELLOW}          │
  │   ${NC}You focus on the${YELLOW}           │
  │   ${NC}${BOLD}creative${NC} ${NC}stuff.${YELLOW}            │
  │                             │
  └─────────────────────────────┘${NC}"
  )

  local idx=$((RANDOM % ${#arts[@]}))
  echo ""
  echo -e "${arts[$idx]}"
  echo ""

  local session_count=0
  if [[ -f "$PORT_REGISTRY" ]]; then
    session_count=$(jq 'length' "$PORT_REGISTRY" 2>/dev/null || echo 0)
  fi

  if [ "$session_count" -gt 0 ]; then
    local alive=0
    local sessions
    sessions=$(jq -r 'keys[]' "$PORT_REGISTRY" 2>/dev/null)
    while IFS= read -r name; do
      tmux has-session -t "$name" 2>/dev/null && alive=$((alive + 1))
    done <<< "$sessions"
    echo -e "  ${BOLD}${alive}${NC} agent(s) currently vibing across ${BOLD}${session_count}${NC} session(s)"
  else
    echo -e "  ${DIM}No sessions running. Start one with ${CYAN}dev new${DIM} and get the vibes going!${NC}"
  fi
  echo ""
  random_tip
  echo ""
}

cmd_fortune() {
  local idx=$((RANDOM % ${#FORTUNES[@]}))
  echo ""
  echo -e "  ${CYAN}╭────────────────────────────────────────╮${NC}"
  echo -e "  ${CYAN}│${NC}  ${BOLD}🔮 Dev Fortune${NC}                        ${CYAN}│${NC}"
  echo -e "  ${CYAN}│${NC}                                        ${CYAN}│${NC}"
  while IFS= read -r line; do
    printf "  ${CYAN}│${NC}  %-38s${CYAN}│${NC}\n" "$line"
  done <<< "$(echo -e "${FORTUNES[$idx]}")"
  echo -e "  ${CYAN}│${NC}                                        ${CYAN}│${NC}"
  echo -e "  ${CYAN}╰────────────────────────────────────────╯${NC}"
  echo ""
}

cmd_lenny() {
  local lennys=(
    "( ͡° ͜ʖ ͡°)"
    "¯\\_(ツ)_/¯"
    "(╯°□°)╯︵ ┻━┻"
    "┬─┬ノ( º _ ºノ)"
    "ʕ•ᴥ•ʔ"
    "(☞ﾟヮﾟ)☞"
    "( ˘ ³˘)♥"
    "ᕕ( ᐛ )ᕗ"
    "(⌐■_■)"
    "~(˘▾˘~)"
    "ಠ_ಠ"
    "(ノಠ益ಠ)ノ彡┻━┻"
    "( ͡~ ͜ʖ ͡°)"
    "¯\\(°_o)/¯"
  )
  local idx=$((RANDOM % ${#lennys[@]}))
  echo ""
  echo -e "  ${lennys[$idx]}"
  echo ""
}

cmd_setup_account() {
    echo -e "${BOLD}Welcome to dev-cli! Let's set up your account.${NC}"
    echo ""

    # Step 1: Check user registration
    if type is_user_registered &>/dev/null && has_user_registry; then
        if ! is_user_registered "$USER"; then
            die "Your account ($USER) is not registered. Ask your admin to run: dev admin add-user $USER --tailscale-email <your-email>"
        fi

        local status
        status=$(get_user_status "$USER")
        if [[ "$status" != "active" ]]; then
            die "Your account is $status. Contact your admin."
        fi

        local email
        email=$(get_user_field "$USER" "tailscale_email")
        log "Account registered as: $USER <$email>"
    else
        info "Running in single-user mode (no user registry)"
    fi

    # Step 2: Tailscale verification
    echo ""
    info "Checking Tailscale..."
    if command -v tailscale &>/dev/null; then
        if tailscale status --self &>/dev/null; then
            local ts_ip
            ts_ip=$(tailscale ip -4 2>/dev/null || echo "unknown")
            log "Tailscale connected (IP: $ts_ip)"
        else
            warn "Tailscale is installed but not connected."
            echo "  Run: sudo tailscale up"
            echo "  Then re-run: dev setup-account"
            return 1
        fi
    else
        warn "Tailscale not installed. Ask your admin for setup instructions."
    fi

    # Step 3: GitHub auth
    echo ""
    info "Checking GitHub CLI..."
    if command -v gh &>/dev/null; then
        if gh auth status &>/dev/null 2>&1; then
            local gh_user
            gh_user=$(gh api user --jq '.login' 2>/dev/null || echo "unknown")
            log "GitHub authenticated as: $gh_user"
        else
            warn "GitHub CLI not authenticated."
            echo "  Run: gh auth login"
            echo ""
            read -rp "Would you like to authenticate now? [Y/n] " answer
            if [[ "${answer:-y}" =~ ^[Yy] ]]; then
                gh auth login
            fi
        fi
    else
        warn "GitHub CLI (gh) not installed."
    fi

    # Step 4: Claude auth
    echo ""
    info "Checking Claude Code..."
    if command -v claude &>/dev/null; then
        # Check if claude has valid auth
        if [[ -f "$HOME/.config/dev-cli/secrets.env" ]]; then
            if grep -q "CLAUDE_CODE_OAUTH_TOKEN\|ANTHROPIC_API_KEY" "$HOME/.config/dev-cli/secrets.env" 2>/dev/null; then
                log "Claude Code credentials found in secrets.env"
            else
                warn "No Claude credentials in secrets.env"
                echo "  Run: claude login"
                echo ""
                read -rp "Would you like to authenticate now? [Y/n] " answer
                if [[ "${answer:-y}" =~ ^[Yy] ]]; then
                    claude login
                fi
            fi
        else
            warn "No secrets.env found."
        fi
    else
        warn "Claude Code not installed."
        echo "  Run: curl -fsSL https://claude.ai/install.sh | sh"
    fi

    # Step 5: Run doctor
    echo ""
    info "Running health check..."
    cmd_doctor

    # Step 6: Mark as onboarded
    if type set_user_field_raw &>/dev/null && has_user_registry; then
        set_user_field_raw "$USER" "onboarded" "true"
    fi

    echo ""
    log "Account setup complete!"
    echo ""
    echo "Quick start:"
    echo "  dev init <project>     Set up a project for the first time"
    echo "  dev new <branch>       Start a new session"
    echo "  dev hub                Launch the interactive dashboard"
    echo "  dev help               See all commands"
}

cmd_help() {
  cat << 'HELPEOF'

  dev — Multi-Agent Worktree Manager

  SETUP
    dev setup [project] [git-url]           Set up a new project (quick or detailed)
    dev projects                            List all configured projects
    dev update [branch]                     Download latest from GitHub and reinstall
    dev help                                Show this help

  SESSIONS
    dev new <project> <branch> [--from <base>] [--agent claude|codex|none] [--agents claude,codex] [--yolo] [--attach] [--run "<cmd>"] [--private] [--container] [--headless] [--env] [--prompt "..."]
                                            Create worktree + start agent(s)
                                            --from base the new branch off a specific branch (instead of main)
                                            --agents starts multiple agents (comma-separated)
                                            --yolo launches Claude with --dangerously-skip-permissions
                                            --attach auto-attach to the session after creation
                                            --run auto-starts a command in the server window
                                            --private hide session from other users' listings
                                            --container run agent inside a devcontainer (experimental in interactive mode)
                                            --headless run non-interactively with claude -p (requires --prompt)
                                            --prompt pass initial prompt to agent (auto-enables headless with --container)
                                            --env pass host secrets.env into the container (only with --container)
    dev ls                                  List your active sessions
    dev ls --all                              List all users' sessions
    dev attach [session] [--all]             Attach to tmux session (interactive picker if no arg, shows only your sessions by default)
    dev kill <session>                      Stop agent + remove worktree + free ports
    dev kill --all                          Kill all sessions
    dev kill --project <name>               Kill all sessions for a project
    dev kill <session> -f|--force           Skip confirmation prompts
    dev restart <session>                   Restart tmux + agent (keep worktree)
    dev yolo <session>                      Re-launch Claude in yolo mode, resuming the conversation
    dev status <session>                    Show detailed session health
    dev send <session> <prompt>             Send text to agent pane
    dev send <session> --file <path>        Send file contents to agent
    dev diff <session>                      Show git diff --stat for session
    dev diff <session> --full               Show full git diff
    dev rename <session> [new-name]          Rename a session (interactive if no new name)
    dev private <session> [on|off]          Toggle or set session privacy (hidden from other users)
    dev sync <session>                      Rebase session on upstream base branch
    dev ask <project> [prompt]              Ask AI about the code (lightweight session, no ports)
                                            --agent claude|codex (default: claude)
                                            --print  One-shot answer, no tmux session
                                            --yolo   Skip permissions (Claude only)
    dev scaffold <name> [--agent claude|codex|none] [--yolo] [--attach] [--remote <git-url>] [--prompt "..."]
                                            Scaffold a new project from scratch
                                            Creates a directory, inits git, starts agent
                                            Use the agent to generate initial project code
                                            --remote sets a git remote for pushing later
                                            --prompt provides an initial instruction for the agent
    dev ghost [prompt]                      Start a standalone AI session (no project/repo)
                                            --agent claude|codex|none (default: claude)
                                            --name <label>  Custom session name
                                            --yolo   Skip permissions (Claude only)
                                            Symlinks dirs from ghost.linked_dirs in config.json
    dev hub                                 Interactive TUI control center
    dev dashboard                           Split-pane view of all agents (read-only)

  AGENTS (dual agent support)
    dev claude <session> [--yolo] [prompt]  Open a new Claude window in a session
    dev codex <session> [prompt]            Open a new Codex window in a session
    dev agent add <session> <claude|codex>  Add a second agent to a running session
    dev agent remove <session> <claude|codex>
                                            Remove an agent from a session
    dev agent list <session>                List running agents in a session

  START FROM PR
    dev pr-start <project> <pr-number|url> [--agent claude|codex|none] [--agents claude,codex] [--yolo] [--attach] [--private] [--prompt "..."]
                                            Start a session from an existing PR
                                            Fetches the PR branch, creates a full worktree session,
                                            and sends PR context to the agent
                                            --prompt provides a custom instruction for the agent

  FINISH & MERGE
    dev pr <session>                        Push, create PR, optionally kill session
    dev pr <session> --draft                Create as draft PR
    dev pr <session> --title "Fix auth"     Set PR title
    dev pr <session> --kill                 Auto-kill session after PR creation

  CODE REVIEW
    dev review <session>                    Auto-review the PR for a session
    dev review <pr-url>                     Review a PR by URL
    dev review <session|pr-url> --yolo      Skip agent permissions
    dev review <session|pr-url> --fix       Review and fix issues, opening a fix PR
    dev review <session|pr-url> --no-fix    Review only (override auto_fix config)
    dev review <pr-url> --project <name>    Use local project name (if different from GitHub repo name)

  UTILITIES
    dev ports                               Show port allocation table
    dev url <session>                       Print access URLs
    dev logs <session>                      Show recent agent output
    dev shell <session>                     Open shell in worktree
    dev worktree <project> <branch>         Create worktree without an agent

  SUPABASE
    dev supabase <session> start            Start local Supabase (auto-fills .env.local keys)
    dev supabase <session> stop             Stop local Supabase
    dev supabase <session> reset            Reset database
    dev supabase <session> status           Show Supabase status

  IMAGES
    dev img ls                              List recent uploaded images
    dev img cp <session> <filename>         Copy image into a session's worktree
    dev img grab <url>                      Download image from URL
    dev img path [filename]                 Print full path (latest if omitted)
    dev img clean [days]                    Remove old images (default: 7 days)

  CONFIGURATION
    dev config                              Interactive configuration walk-through
    dev config --json                       Edit raw config JSON in $EDITOR
    dev config show                         Pretty-print current effective config
    dev config reset                        Reset configuration to defaults
    dev config project <name>               Interactive config for a project
    dev config project <name> --json        Edit project config JSON in $EDITOR

  MAINTENANCE
    dev gc                                  Clean up your dead sessions
    dev gc --global                          Clean up all users' dead sessions
    dev stats                               Launch resource monitor (btop)
    dev mobile                              Mobile-friendly quick menu (alias: dev m)
    dev doctor                              System health check
    dev template <project>                  Edit project hook/template

  NOTIFICATIONS
    dev notify setup                        Install Claude Code hooks for Telegram alerts
    dev notify status                       Show notification config and status
    dev notify test                         Send a test Telegram notification
    dev notify delay <seconds>              Set inactivity delay (default: 30s)

  WEB & BOT
    dev web setup                           Install Python deps for dashboard
    dev web start [port]                    Start web dashboard (default: 8080)
    dev web stop                            Stop web dashboard
    dev web status                          Show dashboard status
    dev bot setup                           Install Python deps for bot
    dev bot start                           Start Telegram bot
    dev bot stop                            Stop Telegram bot
    dev bot status                          Show bot status

  TASKS (automated task queue)
    dev task add <project> [branch] "desc" [--from <base>] [--private] [--plan]
                                            Add a task to the queue
                                            Branch is optional — auto-generated from description if omitted
                                            --from base the worktree off a specific branch
                                            --private hide task from other users
                                            --plan create a plan first, wait for approval before implementing
    dev task import <file.csv> [--project <default>] [--from <base>] [--private] [--plan] [--dry-run]
                                            Batch-import tasks from a CSV file
                                            CSV columns: project,description[,branch][,from_branch][,private][,mode]
                                            --project sets default project for rows missing one
                                            --plan set all imported tasks to plan mode (unless overridden per-row)
                                            --dry-run preview without adding tasks
    dev task approve <id>                   Approve a plan-review task and start implementation
    dev task ls [--pending|--running|--done|--failed|--pr-created|--plan-review|--all]
                                            List tasks (filterable by status)
    dev task rm <id>                        Remove a task
    dev task prune [--failed|--all-finished] [--dry-run]
                                            Remove completed tasks
    dev task run                            Run task runner (single pass)
    dev task watch                          Run task runner (watch mode)
    dev task log                            Tail the runner log

  SERVICES (systemd — auto-start on boot)
    dev services install                    Install and enable systemd services
    dev services uninstall                  Remove systemd services
    dev services start                      Start all services
    dev services stop                       Stop all services
    dev services restart                    Restart all services
    dev services status                     Show service status
    dev services logs [web|bot|task-runner|linear]  Follow service logs

  LINEAR INTEGRATION
    dev linear setup                        Configure Linear API key, team, label, and filters
    dev linear status                       Show current Linear configuration
    dev linear run                          Run Linear poller (single pass)
    dev linear watch                        Run Linear poller (watch mode)
    dev linear test                         Test Linear API connectivity

  DEVCONTAINER (sandboxed agent sessions)
    --container                             Run agent inside a devcontainer
    --headless                              Non-interactive mode (uses claude -p, skips all onboarding)
    --prompt "..."                          Pass task to agent (auto-enables headless with --container)
    --env                                   Copy secrets.env vars into the container

    Headless mode (recommended): --container --prompt "task description"
      Agent works non-interactively inside the container. No onboarding prompts.
      Watch progress with: dev attach <session>

    Interactive mode (experimental): --container (without --prompt)
      You interact with Claude directly inside the container.
      May show onboarding prompts on first launch.

    Project config: "use_container": true, "container_env": true
                    "claude_model": "opus", "claude_effort": "high"
    Uses existing .devcontainer/devcontainer.json if present, or generates one.
    Requires: npm install -g @devcontainers/cli

  SETUP HOOKS (checked in priority order)
    1. <worktree>/.dev/setup.sh             In-repo hook (travels with the code)
    2. ~/.config/dev-cli/hooks/<project>/setup.sh
                                            Global hook (per-project)
    3. Default env generation               .env.local + supabase config patch

    Available env vars in hooks:
      DEV_SLOT, DEV_PROJECT, DEV_BRANCH, DEV_WORKTREE, DEV_IP,
      DEV_FRONTEND_PORT, DEV_BACKEND_PORT,
      DEV_SUPA_API_PORT, DEV_SUPA_DB_PORT, DEV_SUPA_STUDIO_PORT

  EXAMPLES
    dev setup                                # interactive setup for new project
    dev setup klyra git@github.com:org/klyra.git   # quick setup with args
    dev setup klyra https://github.com/org/klyra.git  # HTTPS URL also works
    dev new klyra feat/trading-ui --agent claude
    dev new klyra feat/trading-ui --yolo
    dev new klyra fix/auth-bug --agents claude,codex
    dev new klyra refactor/api --container --prompt "Refactor the API layer"  # headless, fire-and-forget
    dev new klyra fix/db --container --env --prompt "Fix the DB connection bug"  # headless + secrets
    dev new klyra feat/ui --container              # interactive container (experimental)
    dev pr-start klyra 42                         # start session from PR #42
    dev pr-start klyra 42 --yolo --attach        # start from PR, skip perms, attach
    dev pr-start klyra https://github.com/org/klyra/pull/42  # start from PR URL
    dev ask klyra "how does the auth flow work?"
    dev ask klyra                                # interactive session
    dev scaffold my-app                            # scaffold a new project
    dev scaffold my-app --remote git@github.com:me/my-app.git  # with remote
    dev scaffold my-app --yolo --prompt "create a Next.js app with auth"
    dev ghost                                    # standalone AI, no project
    dev ghost --name research "explain OAuth2"   # named ghost session
    dev agent add klyra-feat-trading-ui codex
    dev ls
    dev attach klyra-feat-trading-ui
    dev kill klyra-fix-auth-bug

  FUN
    dev vibes                               Show ASCII art + agent status + random tip
    dev fortune                             Random dev joke / wisdom
    dev lenny                               Random lenny face (essential tooling)

  ADMIN
    dev admin <cmd>    Admin commands (user management, monitoring, operations)
                       Run 'dev admin help' for details

  GETTING STARTED
    dev setup-account  Interactive first-time account setup

  TMUX CHEATSHEET (inside a session)
    Ctrl+a d          Detach (session keeps running)
    Ctrl+a s          Switch between sessions
    Ctrl+a 1/2/3      Switch window (agent/shell/server)
    Ctrl+a z          Zoom pane (fullscreen toggle)
    Ctrl+a |          Split vertically
    Ctrl+a -          Split horizontally

HELPEOF
  echo ""
  random_tip
  echo ""
}

# ── Main ────────────────────────────────────────────────────────────────────

ensure_dirs

case "${1:-help}" in
  setup)     cmd_setup "$@" ;;
  new)       cmd_new "$@" ;;
  ls|list)   cmd_ls "$@" ;;
  attach|a)  cmd_attach "$@" ;;
  kill|rm)   cmd_kill "$@" ;;
  hub)       cmd_hub ;;
  dashboard) cmd_dashboard ;;
  ports)     cmd_ports ;;
  logs)      cmd_logs "$@" ;;
  url)       cmd_url "$@" ;;
  supabase)  cmd_supabase "$@" ;;
  pr)        cmd_pr "$@" ;;
  pr-start)  cmd_pr_start "$@" ;;
  shell|sh)  cmd_shell "$@" ;;
  img)       cmd_img "$@" ;;
  worktree)  cmd_worktree "$@" ;;
  projects)  cmd_projects ;;
  update)    cmd_update "${2:-}" ;;
  status)    cmd_status "$@" ;;
  restart)   cmd_restart "$@" ;;
  yolo)      cmd_yolo "$@" ;;
  send)      cmd_send "$@" ;;
  diff)      cmd_diff "$@" ;;
  sync)      cmd_sync "$@" ;;
  gc)        cmd_gc "$@" ;;
  rename)    cmd_rename "$@" ;;
  private)   cmd_private "$@" ;;
  template)  cmd_template "$@" ;;
  config)    cmd_config "$@" ;;
  agent)     cmd_agent "$@" ;;
  claude)    cmd_launch_agent "claude" "$@" ;;
  codex)     cmd_launch_agent "codex" "$@" ;;
  stats)     cmd_stats ;;
  doctor)    cmd_doctor ;;
  web)       cmd_web "$@" ;;
  bot)       cmd_bot "$@" ;;
  services)  cmd_services "$@" ;;
  task)      cmd_task "$@" ;;
  notify)    cmd_notify "$@" ;;
  ask)       cmd_ask "$@" ;;
  ghost)     cmd_ghost "$@" ;;
  scaffold)  cmd_scaffold "$@" ;;
  review)    cmd_review "$@" ;;
  linear)    cmd_linear "$@" ;;
  mobile|m)  cmd_mobile ;;
  vibes)     cmd_vibes ;;
  fortune)   cmd_fortune ;;
  lenny)     cmd_lenny ;;
  admin)          shift; bash "$_dev_script_dir/dev-admin" "$@" ;;
  setup-account)  cmd_setup_account "$@" ;;
  --version|-v)   echo "dev-cli $(cat "$_dev_script_dir/.dev-version" 2>/dev/null || echo "unknown")"; exit 0 ;;
  help|-h|--help) cmd_help ;;
  *)         die "Unknown command: $1. Run 'dev help' for usage." ;;
esac
