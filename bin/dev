# ── Terminal Detection ─────────────────────────────────────────────────────
term_width() { tput cols 2>/dev/null || echo 80; }
is_compact() { [[ $(term_width) -lt 90 ]]; }

# ── Helpers ─────────────────────────────────────────────────────────────────

