#!/usr/bin/env bash
###############################################################################
# dev-hub — Interactive TUI for managing agent sessions
#
# Launched by `dev hub`. Runs inside tmux as a persistent control center.
# Shows active sessions with preview pane and keyboard shortcuts.
###############################################################################

set -euo pipefail

CONFIG_DIR="$HOME/.config/dev-cli"
GLOBAL_PORT_REGISTRY="/etc/dev-cli/ports.json"
if [ -f "$GLOBAL_PORT_REGISTRY" ] && [ -r "$GLOBAL_PORT_REGISTRY" ]; then
  PORT_REGISTRY="$GLOBAL_PORT_REGISTRY"
else
  PORT_REGISTRY="$CONFIG_DIR/ports.json"
fi
PROJECTS_DIR="$HOME/projects"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
DIM='\033[2m'
BOLD='\033[1m'
NC='\033[0m'
BG_SELECT='\033[48;5;236m'
INVERSE='\033[7m'

# State
SELECTED=1
MAX_SLOTS=50
PREVIEW_LINES=8
SHOW_ALL=true  # show all users by default in hub
GLOBAL_CONFIG="$CONFIG_DIR/config.json"

# ── Config Helpers ─────────────────────────────────────────

# Read a keybind from config, falling back to provided default
get_keybind() {
  local action="$1" default="$2"
  if [ -f "$GLOBAL_CONFIG" ]; then
    local val
    val=$(jq -r ".hub.keybinds.${action} // empty" "$GLOBAL_CONFIG" 2>/dev/null)
    if [ -n "$val" ]; then
      echo "$val"
      return
    fi
  fi
  echo "$default"
}

# Read a theme color name from config, return ANSI code
get_theme_color() {
  local name="$1" default="$2"
  local color_name="$default"
  if [ -f "$GLOBAL_CONFIG" ]; then
    local val
    val=$(jq -r ".hub.theme.${name} // empty" "$GLOBAL_CONFIG" 2>/dev/null)
    if [ -n "$val" ]; then
      color_name="$val"
    fi
  fi
  case "$color_name" in
    red)    echo '\033[0;31m' ;;
    green)  echo '\033[0;32m' ;;
    blue)   echo '\033[0;34m' ;;
    yellow) echo '\033[1;33m' ;;
    cyan)   echo '\033[0;36m' ;;
    *)      echo '\033[0;36m' ;;
  esac
}

# Load theme colors and keybinds from config
load_config() {
  THEME_ACCENT=$(get_theme_color "accent" "cyan")
  THEME_ALIVE=$(get_theme_color "alive" "green")
  THEME_DEAD=$(get_theme_color "dead" "red")

  KEY_NEW=$(get_keybind "new" "n")
  KEY_KILL=$(get_keybind "kill" "k")
  KEY_LAZYGIT=$(get_keybind "lazygit" "l")

  # Refresh interval
  REFRESH_SECONDS=5
  if [ -f "$GLOBAL_CONFIG" ]; then
    local val
    val=$(jq -r '.hub.refresh_seconds // empty' "$GLOBAL_CONFIG" 2>/dev/null)
    if [ -n "$val" ]; then
      REFRESH_SECONDS="$val"
    fi
  fi
}

# ── Helpers ─────────────────────────────────────────────────

get_ip() {
  tailscale ip -4 2>/dev/null || hostname -I | awk '{print $1}'
}

get_sessions() {
  jq -r 'to_entries | sort_by(.value.slot) | .[].key' "$PORT_REGISTRY" 2>/dev/null
}

get_session_field() {
  jq -r ".[\"$1\"].$2 // empty" "$PORT_REGISTRY" 2>/dev/null
}

session_at_slot() {
  jq -r "to_entries[] | select(.value.slot == $1) | .key" "$PORT_REGISTRY" 2>/dev/null
}

session_count() {
  jq 'length' "$PORT_REGISTRY" 2>/dev/null || echo "0"
}

# Get active sessions sorted by slot, one per line: "slot\tname"
# If SHOW_ALL=false, filter to current $USER only
get_active_sessions_sorted() {
  if [ "$SHOW_ALL" = true ]; then
    jq -r 'to_entries | sort_by(.value.slot) | .[] | "\(.value.slot)\t\(.key)"' "$PORT_REGISTRY" 2>/dev/null
  else
    jq -r --arg user "$USER" 'to_entries | map(select(.value.owner == $user or .value.owner == null)) | sort_by(.value.slot) | .[] | "\(.value.slot)\t\(.key)"' "$PORT_REGISTRY" 2>/dev/null
  fi
}

active_session_count() {
  local sessions
  sessions=$(get_active_sessions_sorted)
  if [ -z "$sessions" ]; then
    echo "0"
  else
    echo "$sessions" | wc -l | tr -d ' '
  fi
}

# Get last N lines from a tmux session's agent pane
get_preview() {
  local name="$1" lines="${2:-$PREVIEW_LINES}"
  if tmux has-session -t "$name" 2>/dev/null; then
    tmux capture-pane -t "$name:1" -p -S -"$lines" 2>/dev/null | tail -"$lines"
  else
    echo -e "${DIM}(session not running)${NC}"
  fi
}

# Check if a tmux session is alive
is_alive() {
  tmux has-session -t "$1" 2>/dev/null
}

# Convert ISO timestamp to human-readable age (2m, 3h, 5d, 2w)
human_readable_age() {
  local created="$1"
  local now
  now=$(date +%s)
  local then
  then=$(date -d "$created" +%s 2>/dev/null || date -jf "%Y-%m-%dT%H:%M:%S" "${created%%+*}" +%s 2>/dev/null || echo "$now")
  local diff=$(( now - then ))

  if [ "$diff" -lt 60 ]; then
    echo "${diff}s"
  elif [ "$diff" -lt 3600 ]; then
    echo "$(( diff / 60 ))m"
  elif [ "$diff" -lt 86400 ]; then
    echo "$(( diff / 3600 ))h"
  elif [ "$diff" -lt 604800 ]; then
    echo "$(( diff / 86400 ))d"
  else
    echo "$(( diff / 604800 ))w"
  fi
}

# Get git status summary: [3 dirty, 2↑]
get_git_info() {
  local path="$1"
  [ -d "$path" ] || return

  local parts=()

  # Dirty file count
  local dirty
  dirty=$(git -C "$path" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
  if [ "$dirty" -gt 0 ]; then
    parts+=("${dirty} dirty")
  fi

  # Ahead count
  local ahead
  ahead=$(git -C "$path" rev-list --count '@{upstream}..HEAD' 2>/dev/null || echo "0")
  if [ "$ahead" -gt 0 ]; then
    parts+=("${ahead}↑")
  fi

  if [ ${#parts[@]} -gt 0 ]; then
    local IFS=', '
    echo "[${parts[*]}]"
  fi
}

# ── Terminal Detection ─────────────────────────────────────
hub_term_width() { tput cols 2>/dev/null || echo 80; }
hub_is_compact() { [[ $(hub_term_width) -lt 90 ]]; }

# ── Render ──────────────────────────────────────────────────

render() {
  # Clear screen
  printf '\033[2J\033[H'

  local w
  w=$(hub_term_width)
  local compact=false
  [[ "$w" -lt 90 ]] && compact=true

  local ip
  ip=$(get_ip)
  local now
  now=$(date '+%H:%M')
  local count
  count=$(session_count)

  # Header
  echo ""
  if [ "$compact" = true ]; then
    echo -e "  ${BOLD}${THEME_ACCENT}DEV HUB${NC}  ${DIM}$now${NC}"
  else
    echo -e "  ${BOLD}${THEME_ACCENT}DEV HUB${NC}                                      ${DIM}$now${NC}"
  fi
  local filter_label
  if [ "$SHOW_ALL" = true ]; then
    filter_label="all users"
  else
    filter_label="$USER only"
  fi
  echo -e "  ${DIM}$count/$MAX_SLOTS slots · $ip · $filter_label${NC}"
  echo ""

  # Build active sessions list (index-based selection, not slot-based)
  local active_sessions
  active_sessions=$(get_active_sessions_sorted)
  local active_count
  active_count=$(active_session_count)

  # Clamp SELECTED to valid range
  if [ "$active_count" -gt 0 ] && [ "$SELECTED" -gt "$active_count" ]; then
    SELECTED="$active_count"
  fi
  if [ "$SELECTED" -lt 1 ]; then
    SELECTED=1
  fi

  # Session list
  local selected_name=""
  if [ -z "$active_sessions" ]; then
    echo -e "  ${DIM}  No active sessions. Press [n] to create one.${NC}"
    echo ""
  else
    local idx=0
    while IFS=$'\t' read -r slot name; do
      idx=$((idx + 1))

      local agent branch frontend owner status_icon
      # Show all agents (handles both old "agent" string and new "agents" array)
      agent=$(jq -r ".[\"$name\"].agents // null" "$PORT_REGISTRY" 2>/dev/null)
      if [ "$agent" != "null" ] && [ -n "$agent" ]; then
        agent=$(jq -r ".[\"$name\"].agents | join(\",\")" "$PORT_REGISTRY" 2>/dev/null)
      else
        agent=$(get_session_field "$name" "agent")
      fi
      branch=$(get_session_field "$name" "branch")
      frontend=$(get_session_field "$name" "ports.frontend")
      owner=$(get_session_field "$name" "owner")
      owner="${owner:-?}"

      local created age git_info
      created=$(get_session_field "$name" "created")
      age=$(human_readable_age "$created")
      local wt_path
      wt_path=$(get_session_field "$name" "path")
      git_info=$(get_git_info "$wt_path")

      if is_alive "$name"; then
        status_icon="${THEME_ALIVE}●${NC}"
      else
        status_icon="${THEME_DEAD}●${NC}"
      fi

      if [ "$compact" = true ]; then
        # Compact: 2-line card layout
        local short_name port_display
        short_name=$(echo "$name" | cut -c1-$((w - 6)))
        [ "$frontend" != "null" ] && [ -n "$frontend" ] && port_display=":${frontend}" || port_display="-"
        if [ "$idx" -eq "$SELECTED" ]; then
          selected_name="$name"
          echo -e "  ${BG_SELECT}${BOLD} $status_icon $short_name${NC}"
          echo -e "  ${BG_SELECT}   ${DIM}$agent ${port_display} ${age}${NC}${BG_SELECT} ${git_info:-}${NC}"
        else
          echo -e "   $status_icon ${BOLD}$short_name${NC}"
          echo -e "     ${DIM}$agent ${port_display} ${age} ${git_info:-}${NC}"
        fi
      else
        # Wide: single-line layout
        local display_name
        display_name=$(printf "%-24s" "$name")

        local owner_badge=""
        if [ "$SHOW_ALL" = true ] && [ -n "$owner" ]; then
          owner_badge="${DIM}[$owner]${NC} "
        fi

        local port_display
        [ "$frontend" != "null" ] && [ -n "$frontend" ] && port_display=":${frontend}" || port_display="-"
        if [ "$idx" -eq "$SELECTED" ]; then
          selected_name="$name"
          echo -e "  ${BG_SELECT}${BOLD} $status_icon $display_name ${owner_badge}${agent}  ${port_display}  ${DIM}${age}${NC}${BG_SELECT} ${git_info:-} ${NC}"
        else
          echo -e "   $status_icon ${display_name} ${owner_badge}${DIM}${agent}  ${port_display}  ${age} ${git_info:-}${NC}"
        fi
      fi
    done <<< "$active_sessions"
  fi

  # Preview
  echo ""
  if [ -n "$selected_name" ]; then
    local sep_len=$((w - 16 - ${#selected_name}))
    [ "$sep_len" -lt 4 ] && sep_len=4
    echo -e "  ${DIM}── Preview: ${NC}${BOLD}$selected_name${NC} ${DIM}$( printf '─%.0s' $(seq 1 "$sep_len") )${NC}"
    echo ""
    local preview
    preview=$(get_preview "$selected_name")
    while IFS= read -r line; do
      echo -e "  ${DIM}│${NC} $line"
    done <<< "$preview"
  else
    local sep_len=$((w - 4))
    [ "$sep_len" -lt 20 ] && sep_len=20
    echo -e "  ${DIM}$( printf '─%.0s' $(seq 1 "$sep_len") )${NC}"
    echo ""
    echo -e "  ${DIM}│ Press [n] to create a new session${NC}"
  fi

  # Footer
  echo ""
  local sep_len=$((w - 4))
  [ "$sep_len" -lt 20 ] && sep_len=20
  echo -e "  ${DIM}$( printf '─%.0s' $(seq 1 "$sep_len") )${NC}"
  echo ""
  if [ "$compact" = true ]; then
    echo -e "  ${BOLD}[↑↓]${NC}sel ${BOLD}[⏎]${NC}attach ${BOLD}[${KEY_NEW}]${NC}ew ${BOLD}[${KEY_KILL}]${NC}ill"
    echo -e "  ${BOLD}[p]${NC}orts ${BOLD}[d]${NC}iff ${BOLD}[s]${NC}hell ${BOLD}[u]${NC}rl ${BOLD}[e]${NC} rename"
    echo -e "  ${BOLD}[m]${NC}erge ${BOLD}[i]${NC}nfo ${BOLD}[a]${NC}ll ${BOLD}[q]${NC}uit"
  else
    echo -e "  ${BOLD}[↑↓]${NC} select  ${BOLD}[Enter]${NC} attach  ${BOLD}[${KEY_NEW}]${NC}ew  ${BOLD}[${KEY_KILL}]${NC}ill  ${BOLD}[p]${NC}orts  ${BOLD}[d]${NC}iff  ${BOLD}[+]${NC} add agent  ${BOLD}[e]${NC} rename"
    echo -e "  ${BOLD}[m]${NC}erge/PR  ${BOLD}[${KEY_LAZYGIT}]${NC}azygit  ${BOLD}[s]${NC}hell  ${BOLD}[u]${NC}rl  ${BOLD}[i]${NC}nfo  ${BOLD}[a]${NC}ll  ${BOLD}[r]${NC}efresh  ${BOLD}[q]${NC}uit"
  fi
  echo ""
}

# ── Actions ─────────────────────────────────────────────────

# Get the session name at a given 1-based index in the active list
selected_session_name() {
  get_active_sessions_sorted | sed -n "${SELECTED}p" | cut -f2
}

action_attach() {
  local name
  name=$(selected_session_name)
  [ -z "$name" ] && return

  if is_alive "$name"; then
    tmux switch-client -t "$name"
  fi
}

action_new() {
  # Check if there's a free slot
  local free_slot=""
  for slot in $(seq 1 $MAX_SLOTS); do
    if [ -z "$(session_at_slot "$slot")" ]; then
      free_slot="$slot"
      break
    fi
  done

  if [ -z "$free_slot" ]; then
    echo -e "\n  ${RED}All slots are full. Kill a session first.${NC}"
    sleep 2
    return
  fi

  printf '\033[2J\033[H'
  echo ""
  echo -e "  ${BOLD}New Session${NC} (slot $free_slot)"
  echo ""

  # List available projects
  local projects_dir="$CONFIG_DIR/projects"
  if [ -d "$projects_dir" ] && [ -n "$(ls -A "$projects_dir" 2>/dev/null)" ]; then
    echo -e "  ${DIM}Available projects:${NC}"
    local i=1
    local project_list=()
    for config in "$projects_dir"/*.json; do
      local pname
      pname=$(jq -r '.name' "$config")
      project_list+=("$pname")
      echo "    $i) $pname"
      i=$((i + 1))
    done
    echo ""
    read -rp "  Project (name or number): " project_input

    # Check if it's a number
    if [[ "$project_input" =~ ^[0-9]+$ ]] && [ "$project_input" -le "${#project_list[@]}" ]; then
      project_input="${project_list[$((project_input - 1))]}"
    fi
  else
    read -rp "  Project name: " project_input
  fi

  [ -z "$project_input" ] && return

  echo ""
  read -rp "  Branch name (e.g. feat/my-feature): " branch_input
  [ -z "$branch_input" ] && return

  echo ""
  echo -e "  ${DIM}Base branch (leave empty for default/main):${NC}"
  read -rp "  Base branch (--from): " from_input

  echo ""
  echo "  Agent(s):"
  echo "    1) claude (default)"
  echo "    2) codex"
  echo "    3) claude + codex (dual)"
  echo "    4) none"
  read -rp "  Select [1]: " agent_choice
  local agent agent_flag
  case "${agent_choice:-1}" in
    2) agent="codex"; agent_flag="--agent" ;;
    3) agent="claude,codex"; agent_flag="--agents" ;;
    4) agent="none"; agent_flag="--agent" ;;
    *) agent="claude"; agent_flag="--agent" ;;
  esac

  echo ""
  echo -e "  ${BLUE}→${NC} Creating session..."

  # Build from flag if specified
  local from_args=()
  if [ -n "$from_input" ]; then
    from_args=(--from "$from_input")
  fi

  # Run dev new in a way that we can see the output
  dev new "$project_input" "$branch_input" "${from_args[@]}" "$agent_flag" "$agent" 2>&1

  echo ""
  read -rp "  Press Enter to return to hub..." _
}

action_kill() {
  local name
  name=$(selected_session_name)
  [ -z "$name" ] && return

  echo ""
  echo -ne "  ${YELLOW}Kill session '$name'? [y/N]:${NC} "
  read -rsn1 confirm
  echo ""

  if [ "$confirm" = "y" ] || [ "$confirm" = "Y" ]; then
    dev kill "$name" --force 2>&1
    sleep 1
  fi
}

action_shell() {
  local name
  name=$(selected_session_name)
  [ -z "$name" ] && return

  if is_alive "$name"; then
    tmux switch-client -t "$name:2"
  fi
}

action_lazygit() {
  local name
  name=$(selected_session_name)
  [ -z "$name" ] && return

  local path
  path=$(get_session_field "$name" "path")
  [ -z "$path" ] && return

  # Open lazygit in a temporary window in the hub session
  tmux new-window -t hub -n "lazygit" "cd $path && lazygit"
}

action_url() {
  local name
  name=$(selected_session_name)
  [ -z "$name" ] && return

  local ip frontend backend
  ip=$(get_ip)
  frontend=$(get_session_field "$name" "ports.frontend")
  backend=$(get_session_field "$name" "ports.backend")

  echo ""
  if [ "$frontend" != "null" ] && [ -n "$frontend" ]; then
    echo -e "  ${CYAN}Frontend:${NC} http://$ip:$frontend"
  fi
  if [ "$backend" != "null" ] && [ -n "$backend" ]; then
    echo -e "  ${CYAN}Backend:${NC}  http://$ip:$backend"
  fi
  if { [ "$frontend" = "null" ] || [ -z "$frontend" ]; } && { [ "$backend" = "null" ] || [ -z "$backend" ]; }; then
    echo -e "  ${DIM}No ports allocated for this project.${NC}"
  fi
  echo ""
  read -rp "  Press Enter to continue..." _
}

action_pr() {
  local name
  name=$(selected_session_name)
  [ -z "$name" ] && return

  printf '\033[2J\033[H'
  echo ""
  echo -e "  ${BOLD}Create PR for: $name${NC}"
  echo ""

  dev pr "$name" 2>&1

  echo ""
  read -rp "  Press Enter to return to hub..." _
}

action_ports() {
  printf '\033[2J\033[H'
  dev ports
  echo ""
  read -rp "  Press Enter to return to hub..." _
}

action_diff() {
  local name
  name=$(selected_session_name)
  [ -z "$name" ] && return

  local path
  path=$(get_session_field "$name" "path")
  [ -z "$path" ] && return

  # Use delta if available, otherwise plain diff
  local diff_cmd="git diff"
  if command -v delta &>/dev/null; then
    diff_cmd="git diff | delta"
  fi

  tmux new-window -t hub -n "diff" "cd $path && $diff_cmd; echo ''; echo 'Press Enter to close...'; read"
}

action_info() {
  local name
  name=$(selected_session_name)
  [ -z "$name" ] && return

  local path project branch agent created frontend backend owner
  path=$(get_session_field "$name" "path")
  project=$(get_session_field "$name" "project")
  branch=$(get_session_field "$name" "branch")
  # Show all agents (handles both old "agent" string and new "agents" array)
  agent=$(jq -r ".[\"$name\"].agents // null" "$PORT_REGISTRY" 2>/dev/null)
  if [ "$agent" != "null" ] && [ -n "$agent" ]; then
    agent=$(jq -r ".[\"$name\"].agents | join(\",\")" "$PORT_REGISTRY" 2>/dev/null)
  else
    agent=$(get_session_field "$name" "agent")
  fi
  created=$(get_session_field "$name" "created")
  frontend=$(get_session_field "$name" "ports.frontend")
  backend=$(get_session_field "$name" "ports.backend")
  owner=$(get_session_field "$name" "owner")
  owner="${owner:-unknown}"
  local age
  age=$(human_readable_age "$created")

  printf '\033[2J\033[H'
  echo ""
  echo -e "  ${BOLD}Session Info: $name${NC}"
  echo ""
  echo -e "  Owner:      $owner"
  echo -e "  Project:    $project"
  echo -e "  Branch:     $branch"
  echo -e "  Agent(s):   $agent"
  echo -e "  Age:        $age"
  echo -e "  Path:       $path"
  if [ "$frontend" != "null" ] && [ -n "$frontend" ]; then
    echo -e "  Frontend:   :$frontend"
  fi
  if [ "$backend" != "null" ] && [ -n "$backend" ]; then
    echo -e "  Backend:    :$backend"
  fi
  echo ""

  if [ -d "$path" ]; then
    echo -e "  ${BOLD}Git${NC}"
    local dirty
    dirty=$(git -C "$path" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
    echo -e "  Dirty files: $dirty"

    local file_count
    file_count=$(git -C "$path" ls-files 2>/dev/null | wc -l | tr -d ' ')
    echo -e "  Tracked:     $file_count files"

    echo ""
    echo -e "  ${BOLD}Recent commits${NC}"
    git -C "$path" log --oneline -5 2>/dev/null | sed 's/^/  /'
    echo ""

    # Port checks
    echo -e "  ${BOLD}Ports${NC}"
    for port_info in "Frontend:$frontend" "Backend:$backend"; do
      local label="${port_info%%:*}"
      local port="${port_info##*:}"
      if (echo >/dev/tcp/localhost/"$port") 2>/dev/null; then
        echo -e "  $label:  :$port ${GREEN}listening${NC}"
      else
        echo -e "  $label:  :$port ${DIM}closed${NC}"
      fi
    done
  fi

  echo ""
  read -rp "  Press Enter to return to hub..." _
}

action_add_agent() {
  local name
  name=$(selected_session_name)
  [ -z "$name" ] && return

  echo ""
  echo -e "  ${BOLD}Add agent to: $name${NC}"
  echo ""
  echo "    1) claude"
  echo "    2) codex"
  echo ""
  read -rp "  Select agent type [1]: " agent_choice
  local agent_type
  case "${agent_choice:-1}" in
    2) agent_type="codex" ;;
    *) agent_type="claude" ;;
  esac

  echo ""
  echo -e "  ${BLUE}→${NC} Adding $agent_type agent..."

  dev agent add "$name" "$agent_type" 2>&1

  echo ""
  read -rp "  Press Enter to return to hub..." _
}

action_rename() {
  local name
  name=$(selected_session_name)
  [ -z "$name" ] && return

  echo ""
  echo -e "  Current: ${BOLD}$name${NC}"
  read -rp "  New name: " new_name
  echo ""

  if [ -n "$new_name" ]; then
    dev rename "$name" "$new_name" 2>&1
    sleep 0.5
  fi
}

# ── Main Loop ───────────────────────────────────────────────

main() {
  # Make sure we're inside tmux
  if [ -z "${TMUX:-}" ]; then
    echo "Hub must run inside tmux. Use 'dev hub' to launch."
    exit 1
  fi

  # Load config (keybinds, theme, refresh interval)
  load_config

  # Re-render on terminal resize
  trap 'render' WINCH

  while true; do
    render

    # Read single keypress (with timeout for auto-refresh)
    local key=""
    read -rsn1 -t "$REFRESH_SECONDS" key || true

    # Dynamic keybind matching for configurable keys
    local key_lower
    key_lower=$(echo "$key" | tr '[:upper:]' '[:lower:]')

    if [ "$key_lower" = "$KEY_NEW" ]; then
      action_new
      continue
    elif [ "$key_lower" = "$KEY_KILL" ]; then
      action_kill
      continue
    elif [ "$key_lower" = "$KEY_LAZYGIT" ]; then
      action_lazygit
      continue
    fi

    case "$key" in
      a|A)
        # Toggle between "my sessions" / "all sessions"
        if [ "$SHOW_ALL" = true ]; then
          SHOW_ALL=false
        else
          SHOW_ALL=true
        fi
        SELECTED=1
        ;;
      "")
        # Enter key — attach to selected session
        action_attach
        ;;
      s|S)
        action_shell
        ;;
      u|U)
        action_url
        ;;
      m|M)
        action_pr
        ;;
      p|P)
        action_ports
        ;;
      d|D)
        action_diff
        ;;
      i|I)
        action_info
        ;;
      +)
        action_add_agent
        ;;
      e|E)
        action_rename
        ;;
      r|R)
        # Just refresh (re-render)
        ;;
      q|Q)
        printf '\033[2J\033[H'
        exit 0
        ;;
      $'\x1b')
        # Arrow keys (escape sequence)
        read -rsn2 -t 0.1 arrow || true
        local ac
        ac=$(active_session_count)
        [ "$ac" -eq 0 ] && ac=1
        case "$arrow" in
          '[A') # Up
            SELECTED=$(( SELECTED > 1 ? SELECTED - 1 : ac ))
            ;;
          '[B') # Down
            SELECTED=$(( SELECTED < ac ? SELECTED + 1 : 1 ))
            ;;
        esac
        ;;
    esac
  done
}

main "$@"
