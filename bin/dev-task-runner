#!/usr/bin/env bash
###############################################################################
# dev-task-runner — Automated task queue daemon for dev-cli
#
# Processes pending tasks from tasks.json:
#   1. Creates worktree + session via `dev new`
#   2. Writes TASK.md with instructions
#   3. Sends Claude a prompt via `dev send`
#   4. Monitors for .task-done marker
#   5. On completion: pushes branch, creates PR, marks done
#
# Usage:
#   dev-task-runner --once    Single pass (process one pending + check running)
#   dev-task-runner --watch   Loop mode (runs --once every 60s)
###############################################################################

set -euo pipefail

CONFIG_DIR="$HOME/.config/dev-cli"
GLOBAL_CONFIG="$CONFIG_DIR/config.json"
TASK_REGISTRY="$CONFIG_DIR/tasks.json"
LOG_DIR="$CONFIG_DIR/logs"
LOG_FILE="$LOG_DIR/task-runner.log"

# Port registry: prefer global (matches bin/dev behavior), fall back to local
GLOBAL_PORT_REGISTRY="/etc/dev-cli/ports.json"
if [ -f "$GLOBAL_PORT_REGISTRY" ] && [ -r "$GLOBAL_PORT_REGISTRY" ]; then
  PORT_REGISTRY="$GLOBAL_PORT_REGISTRY"
elif [ -f "$CONFIG_DIR/ports.json" ]; then
  PORT_REGISTRY="$CONFIG_DIR/ports.json"
else
  PORT_REGISTRY="$GLOBAL_PORT_REGISTRY"
fi

mkdir -p "$LOG_DIR"

# ── Logging ──────────────────────────────────────────────────────────────────

log() {
  local ts
  ts=$(date '+%Y-%m-%d %H:%M:%S')
  echo "[$ts] $1" >> "$LOG_FILE"
  echo "[$ts] $1"
}

# ── JSON helpers ─────────────────────────────────────────────────────────────

task_field() {
  local id="$1" field="$2"
  jq -r --arg id "$id" '.tasks[] | select(.id == $id) | .'"$field" "$TASK_REGISTRY"
}

update_task() {
  local id="$1" field="$2" value="$3"
  local tmp="$TASK_REGISTRY.tmp.$$"
  jq --arg id "$id" --arg f "$field" --arg v "$value" \
    '(.tasks[] | select(.id == $id))[$f] = $v' "$TASK_REGISTRY" > "$tmp" \
    && mv "$tmp" "$TASK_REGISTRY"
}

# ── Telegram notifications ───────────────────────────────────────────────────

send_telegram() {
  local text="$1"

  [ -f "$GLOBAL_CONFIG" ] || return 0

  local token
  token=$(jq -r '.telegram.bot_token // empty' "$GLOBAL_CONFIG" 2>/dev/null)
  [ -n "$token" ] || return 0

  local chat_ids
  chat_ids=$(jq -r '.telegram.allowed_chat_ids[]?' "$GLOBAL_CONFIG" 2>/dev/null || true)
  [ -n "$chat_ids" ] || return 0

  while IFS= read -r chat_id; do
    [ -n "$chat_id" ] || continue
    curl -s -X POST "https://api.telegram.org/bot${token}/sendMessage" \
      -d chat_id="$chat_id" \
      -d text="$text" \
      -d parse_mode="Markdown" > /dev/null 2>&1 || true
  done <<< "$chat_ids"
}

notify_pr_ready() {
  local id="$1" pr_url="$2"
  local project branch description from_branch
  project=$(task_field "$id" "project")
  branch=$(task_field "$id" "branch")
  description=$(task_field "$id" "description")
  from_branch=$(task_field "$id" "from_branch")

  local hostname
  hostname=$(hostname 2>/dev/null || echo "unknown")

  local from_line=""
  if [ -n "$from_branch" ] && [ "$from_branch" != "null" ]; then
    from_line="
🔀 *Based on:* \`${from_branch}\`"
  fi

  local text="🔔 *PR Ready for Review*

📋 *Task #${id}:* ${description}
📦 *Project:* \`${project}\`
🌿 *Branch:* \`${branch}\`${from_line}
🖥 *Host:* \`${hostname}\`

🔗 [Review PR](${pr_url})"

  send_telegram "$text"
  log "Telegram notification sent for task $id PR: $pr_url"
}

# ── Process one pending task ─────────────────────────────────────────────────

process_pending() {
  [ -f "$TASK_REGISTRY" ] || return 0

  # Find first pending task
  local task_json
  task_json=$(jq -r '.tasks[] | select(.status == "pending") | @json' "$TASK_REGISTRY" | head -1)
  [ -n "$task_json" ] || return 0

  local id project branch description from_branch
  id=$(echo "$task_json" | jq -r '.id')
  project=$(echo "$task_json" | jq -r '.project')
  branch=$(echo "$task_json" | jq -r '.branch')
  description=$(echo "$task_json" | jq -r '.description')
  from_branch=$(echo "$task_json" | jq -r '.from_branch // empty')

  log "Processing task $id: $project/$branch — $description"

  # Mark as running
  local now
  now=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
  local tmp="$TASK_REGISTRY.tmp.$$"
  jq --arg id "$id" --arg now "$now" \
    '(.tasks[] | select(.id == $id)) |= (.status = "running" | .started = $now)' \
    "$TASK_REGISTRY" > "$tmp" && mv "$tmp" "$TASK_REGISTRY"

  # Create session via dev new
  local dev_output session_name
  local from_flag=""
  [ -n "$from_branch" ] && from_flag="--from $from_branch"
  dev_output=$(dev new "$project" "$branch" $from_flag --agent claude --yolo 2>&1) || true
  # Strip ANSI codes before parsing
  session_name=$(echo "$dev_output" | sed 's/\x1b\[[0-9;]*m//g' | grep -oP 'Session:\s+\K\S+' | head -1)

  # Fallback: derive session name from user-project-branch convention (matches bin/dev session_name())
  if [ -z "$session_name" ]; then
    local slug
    if [[ "$branch" =~ ^task-[0-9]+/ ]]; then
      slug="${branch%%/*}"
    else
      slug=$(echo "$branch" | sed 's/[^a-zA-Z0-9]/-/g' | sed 's/--*/-/g' | sed 's/^-//;s/-$//' | tr '[:upper:]' '[:lower:]')
    fi
    session_name="${USER}-${project}-${slug}"
  fi

  # Check the session actually exists
  if ! tmux has-session -t "$session_name" 2>/dev/null; then
    log "ERROR: Failed to create session for task $id. Output: $(echo "$dev_output" | tail -3)"
    update_task "$id" "status" "failed"
    return 1
  fi

  log "Session created: $session_name"
  update_task "$id" "session" "$session_name"

  # Find worktree path
  local worktree
  worktree=$(jq -r --arg s "$session_name" '.[$s].worktree // .[$s].path // empty' "$PORT_REGISTRY")

  if [ -z "$worktree" ] || [ ! -d "$worktree" ]; then
    log "ERROR: Could not find worktree for session $session_name"
    update_task "$id" "status" "failed"
    return 1
  fi

  # Write TASK.md
  cat > "$worktree/TASK.md" << TASKEOF
# Task: $description

## Project
$project

## Branch
$branch

## Instructions

Please implement the following task:

$description

## When done

1. Make sure all changes are committed
2. Run any relevant tests to verify your changes work
3. Push your branch and create a PR:
   - Write a clear, concise PR title that describes what you actually changed (do NOT just use the task description verbatim)
   - Write a PR body with a summary of what was done and why
   - Use: \`gh pr create --title "Your title" --body "Your description" --head $branch\`
   - Save the PR URL to a file: \`echo "https://github.com/..." > .task-pr-url\`
4. After the PR is created, create the done marker: \`touch .task-done\`

**Important:** The PR title should be a proper, descriptive title (e.g. "Add retry logic to API client" or "Fix race condition in session cleanup"), NOT a copy of the task prompt. The PR body should summarize the changes made.

This signals the task runner that you've completed the work.
TASKEOF

  log "Wrote TASK.md to $worktree"

  # Send Claude the prompt
  sleep 3  # Give Claude a moment to start up
  local prompt="Read the TASK.md file in this project root. It contains your task. Follow the instructions carefully. When you are completely done, run: touch .task-done"
  dev send "$session_name" "$prompt" 2>&1 | head -5 >> "$LOG_FILE" || true

  log "Sent prompt to $session_name for task $id"

  # Notify via Telegram that task has started
  local hostname
  hostname=$(hostname 2>/dev/null || echo "unknown")

  local from_line=""
  if [ -n "$from_branch" ]; then
    from_line="
🔀 *Based on:* \`${from_branch}\`"
  fi

  send_telegram "🚀 *Task Started*

📋 *Task #${id}:* ${description}
📦 *Project:* \`${project}\`
🌿 *Branch:* \`${branch}\`${from_line}
🖥 *Host:* \`${hostname}\`
🤖 *Session:* \`${session_name}\`"
}

# ── Check running tasks ─────────────────────────────────────────────────────

check_running() {
  [ -f "$TASK_REGISTRY" ] || return 0

  local running_tasks
  running_tasks=$(jq -r '.tasks[] | select(.status == "running") | .id' "$TASK_REGISTRY")
  [ -n "$running_tasks" ] || return 0

  while IFS= read -r id; do
    local session worktree
    session=$(task_field "$id" "session")
    [ -n "$session" ] && [ "$session" != "null" ] || continue

    worktree=$(jq -r --arg s "$session" '.[$s].worktree // .[$s].path // empty' "$PORT_REGISTRY")
    [ -n "$worktree" ] && [ -d "$worktree" ] || continue

    # Check for .task-done marker
    if [ -f "$worktree/.task-done" ]; then
      log "Task $id completed! (session: $session)"
      complete_task "$id" "$session" "$worktree"
    fi
  done <<< "$running_tasks"
}

# ── Complete a task: push, PR, mark done ─────────────────────────────────────

complete_task() {
  local id="$1" session="$2" worktree="$3"

  cd "$worktree"

  # Read PR URL from marker file (created by the AI agent)
  local pr_url="" branch
  branch=$(task_field "$id" "branch")
  if [ -f "$worktree/.task-pr-url" ]; then
    pr_url=$(grep -oP 'https://\S+' "$worktree/.task-pr-url" | head -1)
  fi

  # Validate the PR actually belongs to this task's branch
  if [ -n "$pr_url" ]; then
    local pr_branch
    pr_branch=$(gh pr view "$pr_url" --json headRefName --jq '.headRefName' 2>/dev/null) || true
    if [ "$pr_branch" != "$branch" ]; then
      log "WARNING: PR $pr_url is for branch '$pr_branch', not '$branch' — ignoring stale PR URL"
      pr_url=""
    fi
  fi

  if [ -n "$pr_url" ]; then
    update_task "$id" "pr_url" "$pr_url"
    update_task "$id" "status" "pr-created"
    notify_pr_ready "$id" "$pr_url"
    log "PR found: $pr_url"
  else
    # Fallback: AI didn't create a PR, create one ourselves
    log "WARNING: No .task-pr-url found — creating PR as fallback"

    # Commit any uncommitted changes
    if [ -n "$(git status --porcelain 2>/dev/null)" ]; then
      git add -A
      git commit -m "Task completed: $(task_field "$id" "description")" --no-verify 2>&1 | tail -3 >> "$LOG_FILE" || true
    fi

    # Push branch
    git push -u origin "$branch" 2>&1 | tail -5 >> "$LOG_FILE" || true
    log "Pushed branch $branch"

    # Create PR with task description as fallback
    local description
    description=$(task_field "$id" "description")
    local pr_output
    pr_output=$(gh pr create \
      --title "$description" \
      --body "Automated task completed by dev-task-runner." \
      --head "$branch" 2>&1) || true

    if echo "$pr_output" | grep -q "https://"; then
      pr_url=$(echo "$pr_output" | grep -oP 'https://\S+' | head -1)
      update_task "$id" "pr_url" "$pr_url"
      update_task "$id" "status" "pr-created"
      notify_pr_ready "$id" "$pr_url"
      log "Fallback PR created: $pr_url"
    else
      log "WARNING: PR creation may have failed: $pr_output"
    fi
  fi

  # Clean up task marker files
  rm -f "$worktree/.task-done" "$worktree/TASK.md" "$worktree/.task-pr-url"
  if [ -n "$(git status --porcelain 2>/dev/null)" ]; then
    git add -A
    git commit -m "Clean up task files" --no-verify 2>&1 >> "$LOG_FILE" || true
    git push origin "$branch" 2>&1 >> "$LOG_FILE" || true
  fi

  log "Task $id is now pr-created — waiting for PR to be merged"

  # Auto-start a review session for this PR
  if [ -n "$pr_url" ]; then
    start_review "$id" "$pr_url"
  fi
}

# ── Auto PR Review ────────────────────────────────────────────────────────────

start_review() {
  local task_id="$1" pr_url="$2"

  local project branch
  project=$(task_field "$task_id" "project")
  branch=$(task_field "$task_id" "branch")

  log "Starting auto-review for task $task_id (PR: $pr_url)"

  # Launch review via dev review command
  local review_output
  review_output=$(dev review "$pr_url" --yolo 2>&1) || true

  if echo "$review_output" | sed 's/\x1b\[[0-9;]*m//g' | grep -q "Session:"; then
    local review_session
    review_session=$(echo "$review_output" | sed 's/\x1b\[[0-9;]*m//g' | grep -oP 'Session:\s+\K\S+' | head -1)
    log "Review session started: $review_session for task $task_id"
    update_task "$task_id" "review_session" "$review_session"
  else
    log "WARNING: Failed to start review session for task $task_id: $(echo "$review_output" | tail -3)"
  fi
}

check_reviews() {
  [ -f "$TASK_REGISTRY" ] || return 0

  # Find pr-created tasks that have a review session
  local review_tasks
  review_tasks=$(jq -r '.tasks[] | select(.status == "pr-created" and .review_session != null and .review_session != "") | .id' "$TASK_REGISTRY" 2>/dev/null)
  [ -n "$review_tasks" ] || return 0

  while IFS= read -r id; do
    local review_session
    review_session=$(task_field "$id" "review_session")
    [ -n "$review_session" ] && [ "$review_session" != "null" ] || continue

    # Find the review session's worktree
    local review_path
    review_path=$(jq -r --arg s "$review_session" '.[$s].path // empty' "$PORT_REGISTRY" 2>/dev/null)
    [ -n "$review_path" ] && [ -d "$review_path" ] || continue

    # Check for .review-done marker
    if [ -f "$review_path/.review-done" ]; then
      log "Review completed for task $id (session: $review_session)"

      # Notify via Telegram
      local pr_url
      pr_url=$(task_field "$id" "pr_url")
      local description
      description=$(task_field "$id" "description")
      local hostname
      hostname=$(hostname 2>/dev/null || echo "unknown")

      send_telegram "📝 *PR Review Submitted*

📋 *Task #${id}:* ${description}
🔗 [View PR](${pr_url})
🖥 *Host:* \`${hostname}\`

_An automated code review has been posted on the PR._"

      # Kill the review session
      dev kill "$review_session" -f 2>&1 | tail -3 >> "$LOG_FILE" || true
      log "Review session $review_session cleaned up"
    fi
  done <<< "$review_tasks"
}

# ── Check pr-created tasks for merged PRs ────────────────────────────────────

check_merged() {
  [ -f "$TASK_REGISTRY" ] || return 0

  local pr_tasks
  pr_tasks=$(jq -r '.tasks[] | select(.status == "pr-created") | .id' "$TASK_REGISTRY")
  [ -n "$pr_tasks" ] || return 0

  while IFS= read -r id; do
    local pr_url session
    pr_url=$(task_field "$id" "pr_url")
    [ -n "$pr_url" ] && [ "$pr_url" != "null" ] || continue

    # Check PR merge status via gh
    local pr_state
    pr_state=$(gh pr view "$pr_url" --json state --jq '.state' 2>/dev/null) || continue

    if [ "$pr_state" = "MERGED" ]; then
      log "Task $id PR merged: $pr_url"

      # Kill the session if still running
      session=$(task_field "$id" "session")
      if [ -n "$session" ] && [ "$session" != "null" ] && tmux has-session -t "$session" 2>/dev/null; then
        log "Killing session $session for completed task $id"
        dev kill "$session" 2>&1 | tail -3 >> "$LOG_FILE" || true
      fi

      local now
      now=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
      local tmp="$TASK_REGISTRY.tmp.$$"
      jq --arg id "$id" --arg now "$now" \
        '(.tasks[] | select(.id == $id)) |= (.status = "done" | .completed = $now)' \
        "$TASK_REGISTRY" > "$tmp" && mv "$tmp" "$TASK_REGISTRY"

      log "Task $id marked as done"
    elif [ "$pr_state" = "CLOSED" ]; then
      log "Task $id PR was closed without merging: $pr_url"
      update_task "$id" "status" "failed"
    fi
  done <<< "$pr_tasks"
}

# ── Single pass ──────────────────────────────────────────────────────────────

run_once() {
  process_pending
  check_running
  check_reviews
  check_merged
}

# ── Main ─────────────────────────────────────────────────────────────────────

case "${1:---once}" in
  --once)
    log "Running single pass..."
    run_once
    log "Pass complete."
    ;;
  --watch)
    log "Starting watch mode (polling every 60s)..."
    while true; do
      run_once
      sleep 60
    done
    ;;
  *)
    echo "Usage: dev-task-runner [--once|--watch]"
    exit 1
    ;;
esac
