# Project env template — place at ~/.config/dev-cli/templates/<project>.env
# The dev CLI replaces {{placeholders}} with actual port values per worktree slot.
#
# Available placeholders:
#   {{FRONTEND_PORT}}    — Next.js port (3001-3005)
#   {{BACKEND_PORT}}     — Express port (4001-4005)
#   {{SUPA_API_PORT}}    — Supabase API (54321, 54331, ...)
#   {{SUPA_DB_PORT}}     — Supabase Postgres (54322, 54332, ...)
#   {{SUPA_STUDIO_PORT}} — Supabase Studio UI (54323, 54333, ...)
#   {{SLOT}}             — Slot number (1-5)

# ── App ─────────────────────────────────────────────────────
PORT={{FRONTEND_PORT}}
NEXT_PUBLIC_PORT={{FRONTEND_PORT}}
NODE_ENV=development

# ── Backend (Express) ───────────────────────────────────────
BACKEND_PORT={{BACKEND_PORT}}
NEXT_PUBLIC_API_URL=http://localhost:{{BACKEND_PORT}}

# ── Supabase ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=http://localhost:{{SUPA_API_PORT}}
SUPABASE_URL=http://localhost:{{SUPA_API_PORT}}
SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:{{SUPA_DB_PORT}}/postgres
# Keys are auto-filled by `dev supabase <session> start`
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ── Add your project-specific vars below ────────────────────
# NEXT_PUBLIC_APP_NAME=Klyra
# REDIS_URL=redis://localhost:6379
